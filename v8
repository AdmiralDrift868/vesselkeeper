        dialog.set_select_multiple(True)

        response = dialog.run()
        if response == Gtk.ResponseType.OK:
            filenames = dialog.get_filenames()
            for filename in filenames:
                if filename not in self.attachments:
                    self.attachments.append(filename)
                    self.list_store.append([os.path.basename(filename)])
        dialog.destroy()

    def _on_remove_clicked(self, button):
        selection = self.tree_view.get_selection()
        model, tree_iter = selection.get_selected()
        if tree_iter is not None:
            filename = model[tree_iter][0]
            full_path = next((p for p in self.attachments if os.path.basename(p) == filename), None)
            if full_path:
                self.attachments.remove(full_path)
                self.list_store.remove(tree_iter)

    def get_attachments(self) -> List[str]:
        return self.attachments.copy()

    def set_attachments(self, attachments: List[str]):
        self.attachments = attachments
        self.list_store.clear()
        for path in attachments:
            self.list_store.append([os.path.basename(path)])

# --- Database Class ---
class ThreadSafeDatabase:
    def __init__(self, db_path=DATABASE_FILE):
        self.db_path = db_path
        self.conn = None
        self._lock = threading.RLock()
        self.open_connection()
        self.create_tables()

    @contextmanager
    def get_cursor(self):
        self._lock.acquire()
        try:
            cursor = self.conn.cursor()
            yield cursor
            self.conn.commit()
        except Exception as e:
            self.conn.rollback()
            raise e
        finally:
            self._lock.release()

    def open_connection(self):
        self.conn = sqlite3.connect(self.db_path, check_same_thread=False)
        self.conn.row_factory = sqlite3.Row

    def close(self):
        if self.conn:
            self.conn.close()
            self.conn = None

    def create_tables(self):
        with self.get_cursor() as cursor:
            cursor.executescript("""
            CREATE TABLE IF NOT EXISTS vessels (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL,
                vessel_type TEXT,
                length REAL,
                beam REAL,
                draft REAL,
                engine_make TEXT,
                engine_model TEXT,
                engine_hours REAL,
                hull_material TEXT,
                build_year INTEGER,
                last_survey TEXT,
                insurance_expiry TEXT,
                current_location TEXT,
                notes TEXT,
                attachments TEXT,
                registration_number TEXT,
                home_port TEXT,
                gross_tonnage REAL,
                image_path TEXT
            );

            CREATE TABLE IF NOT EXISTS suppliers (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL,
                contact TEXT,
                phone TEXT,
                email TEXT,
                notes TEXT,
                attachments TEXT,
                address TEXT,
                website TEXT,
                preferred BOOLEAN DEFAULT 0,
                terms TEXT,
                last_order_date TEXT
            );

            CREATE TABLE IF NOT EXISTS inventory_items (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL,
                part_number TEXT,
                description TEXT,
                category TEXT,
                system TEXT,
                location TEXT,
                current_stock INTEGER,
                minimum_stock INTEGER,
                supplier_id INTEGER REFERENCES suppliers(id) ON DELETE SET NULL,
                unit_cost REAL,
                specifications TEXT,
                attachments TEXT,
                reorder_quantity INTEGER DEFAULT 0,
                last_reorder_date TEXT,
                average_consumption_rate REAL DEFAULT 0,
                notes TEXT
            );

            CREATE TABLE IF NOT EXISTS maintenance_templates (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL,
                system TEXT,
                task_name TEXT NOT NULL,
                interval_type TEXT,
                interval_value INTEGER,
                priority TEXT,
                parts_required TEXT,
                instructions TEXT,
                labor_cost REAL DEFAULT 0,
                estimated_duration_hours REAL DEFAULT 0,
                notes TEXT
            );

            CREATE TABLE IF NOT EXISTS maintenance_tasks (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                vessel_id INTEGER REFERENCES vessels(id) ON DELETE CASCADE,
                system TEXT,
                task_name TEXT NOT NULL,
                template_id INTEGER REFERENCES maintenance_templates(id) ON DELETE SET NULL,
                interval_type TEXT,
                interval_value INTEGER,
                last_completed TEXT,
                last_hours REAL,
                next_due TEXT,
                priority TEXT,
                parts_required TEXT,
                instructions TEXT,
                labor_cost REAL DEFAULT 0,
                total_parts_cost REAL DEFAULT 0,
                attachments TEXT,
                status TEXT DEFAULT 'ON_SCHEDULE',
                assigned_to TEXT,
                estimated_duration_hours REAL DEFAULT 0,
                actual_duration_hours REAL DEFAULT 0,
