    def refresh_views(self):
        """Refresh all data views with modern enhancements"""
        vessels = self.db.get_vessels()
        
        # Update dashboard metrics
        self.vessel_card.value_label.set_text(str(len(vessels)))
        
        # Update vessels list
        self.vessels_store.clear()
        for vessel in vessels:
            self.vessels_store.append([
                vessel.id, vessel.name, vessel.vessel_type,
                f"{vessel.engine_make} {vessel.engine_model}", 
                vessel.current_location, "Active"
            ])
        
        # Update activities
        self.activities_store.clear()
        self.activities_store.append(["Application refreshed", 
                                    datetime.datetime.now().strftime("%Y-%m-%d %H:%M")])
        if vessels:
            self.activities_store.append([f"Loaded {len(vessels)} vessels", ""])
    
    def on_window_delete(self, window, event):
        self._save_config()
        self.db.close()
        return False
    
    # Action methods
    def on_add_vessel(self, button):
        dialog = ModernVesselEditor(self, self.db)
        response = dialog.run()
        if response == Gtk.ResponseType.OK:
            vessel = dialog.get_values()
            self.db.add_vessel(vessel)
            self.refresh_views()
            show_info_dialog(self, "Vessel added successfully!")
        dialog.destroy()

    def on_edit_vessel(self, button):
        selection = self.vessels_tree.get_selection()
        model, tree_iter = selection.get_selected()
        if tree_iter is not None:
            vessel_id = model[tree_iter][0]
            vessels = self.db.get_vessels()
            vessel = next((v for v in vessels if v.id == vessel_id), None)
            if vessel:
                dialog = ModernVesselEditor(self, self.db, vessel)
                response = dialog.run()
                if response == Gtk.ResponseType.OK:
                    updated_vessel = dialog.get_values()
                    self.db.update_vessel(updated_vessel)
                    self.refresh_views()
                    show_info_dialog(self, "Vessel updated successfully!")
                dialog.destroy()
            else:
                show_error_dialog(self, "Vessel not found.")
        else:
            show_error_dialog(self, "Please select a vessel to edit.")

    def on_delete_vessel(self, button):
        selection = self.vessels_tree.get_selection()
        model, tree_iter = selection.get_selected()
        if tree_iter is not None:
            vessel_id = model[tree_iter][0]
            vessel_name = model[tree_iter][1]
            
            if show_confirmation_dialog(self, f"Are you sure you want to delete vessel '{vessel_name}'?"):
                if self.db.delete_vessel(vessel_id):
                    self.refresh_views()
                    show_info_dialog(self, f"Vessel '{vessel_name}' deleted successfully.")
                else:
                    show_error_dialog(self, f"Cannot delete vessel '{vessel_name}'. It may have associated records.")
        else:
            show_error_dialog(self, "Please select a vessel to delete.")

    def on_export_vessels(self, button):
        show_info_dialog(self, "Export functionality will be implemented in the next version.")

