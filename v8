    def _create_enhanced_toolbar(self, primary_action, secondary_actions, utility_actions):
        toolbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        
        # Primary actions
        primary_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        primary_label, primary_icon, primary_callback = primary_action
        primary_btn = ModernButton(primary_label, primary_icon, "primary-button")
        primary_btn.connect('clicked', primary_callback)
        primary_box.pack_start(primary_btn, False, False, 0)
        
        # Secondary actions
        secondary_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        for label, icon, callback in secondary_actions:
            btn = ModernButton(label, icon, "secondary-button")
            btn.connect('clicked', callback)
            secondary_box.pack_start(btn, False, False, 0)
        
        # Spacer
        spacer = Gtk.Box()
        toolbar.pack_start(spacer, True, True, 0)
        
        # Utility actions
        utility_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        for label, icon, callback in utility_actions:
            btn = ModernButton(label, icon, "secondary-button")
            btn.connect('clicked', callback)
            utility_box.pack_start(btn, False, False, 0)
        
        toolbar.pack_start(primary_box, False, False, 0)
        toolbar.pack_start(secondary_box, False, False, 0)
        toolbar.pack_end(utility_box, False, False, 0)
        
        return toolbar
    
