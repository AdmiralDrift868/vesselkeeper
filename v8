                value REAL,
                unit TEXT,
                date_recorded TEXT
            );
            """)

    def _safe_json_loads(self, json_str, default=None):
        if default is None:
            default = []
        if not json_str or json_str == 'null':
            return default
        try:
            return json.loads(json_str)
        except (json.JSONDecodeError, TypeError):
            logger.warning(f"Invalid JSON: {json_str}")
            return default

