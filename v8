class ValidatedEntry(Gtk.Box):
    def __init__(self, label, required=False, validator=None):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        
        self.validator = validator
        self.is_valid = True
        
        # Label
        label_widget = Gtk.Label(label=label + ("*" if required else ""))
        label_widget.set_xalign(0)
        self.pack_start(label_widget, False, False, 0)
        
        # Entry with validation
        self.entry = Gtk.Entry()
        self.error_label = Gtk.Label()
        self.error_label.set_xalign(0)
        self.error_label.get_style_context().add_class('error-text')
        self.error_label.set_visible(False)
        
        if validator:
            self.entry.connect('changed', self.on_changed)
        
        self.pack_start(self.entry, False, False, 0)
        self.pack_start(self.error_label, False, False, 0)
    
    def on_changed(self, entry):
        if self.validator:
            is_valid, message = self.validator(entry.get_text())
            self.set_validation_state(is_valid, message)
    
    def set_validation_state(self, is_valid, message=""):
        self.is_valid = is_valid
        self.error_label.set_visible(not is_valid)
        self.error_label.set_text(message)
        
        context = self.entry.get_style_context()
        if is_valid:
            context.remove_class('error')
        else:
            context.add_class('error')
    
    def get_text(self):
        return self.entry.get_text()
    
    def set_text(self, text):
        self.entry.set_text(text)

class DatePickerEntry(Gtk.Box):
    def __init__(self):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL)
        self.entry = Gtk.Entry()
        self.button = Gtk.Button(label="...")
        self.button.connect("clicked", self._on_button_clicked)
        self.pack_start(self.entry, True, True, 0)
        self.pack_end(self.button, False, False, 0)

    def _on_button_clicked(self, button):
        dialog = Gtk.Dialog(title="Select Date", transient_for=self.get_toplevel(), flags=0)
        dialog.add_buttons(
            Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
            Gtk.STOCK_OK, Gtk.ResponseType.OK
        )
        calendar = Gtk.Calendar()
        current_date_str = self.entry.get_text()
        if current_date_str and validate_date(current_date_str):
             try:
                 date_obj = datetime.datetime.strptime(current_date_str, "%Y-%m-%d").date()
                 calendar.select_month(date_obj.month - 1, date_obj.year)
                 calendar.select_day(date_obj.day)
             except ValueError:
                 pass

        content_area = dialog.get_content_area()
        content_area.add(calendar)
        dialog.show_all()

        response = dialog.run()
        if response == Gtk.ResponseType.OK:
            year, month, day = calendar.get_date()
            date_str = f"{year:04d}-{month+1:02d}-{day:02d}"
            self.entry.set_text(date_str)
        dialog.destroy()

    def set_text(self, text: str):
        self.entry.set_text(text)

    def get_text(self) -> str:
        return self.entry.get_text()

    def validate_date(self, allow_empty: bool = True) -> bool:
        return validate_date(self.entry.get_text(), allow_empty)

    def grab_focus(self):
        self.entry.grab_focus()

