    def _create_placeholder_tab(self, name):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        label = Gtk.Label(label=f"Enhanced {name} Tab - Implementation in progress")
        label.get_style_context().add_class('secondary-color')
