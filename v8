            );

            CREATE TABLE IF NOT EXISTS trip_logs (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                vessel_id INTEGER REFERENCES vessels(id) ON DELETE CASCADE,
                departure TEXT,
                arrival TEXT,
                origin TEXT,
                destination TEXT,
                start_hours REAL,
                end_hours REAL,
                fuel_used REAL,
                distance REAL,
                crew TEXT,
                log_entries TEXT,
                attachments TEXT,
                status TEXT DEFAULT 'PLANNED',
                weather_conditions TEXT,
                sea_state TEXT,
                captain TEXT,
