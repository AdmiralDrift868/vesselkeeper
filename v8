    def populate_fields(self):
        if not self.item:
            return
            
        self.name_entry.entry.set_text(self.item.name)
        
        for i, vtype in enumerate(VESSEL_TYPES):
            if vtype == self.item.vessel_type:
                self.type_combo.set_active(i)
                break
                
        self.length_entry.set_value(self.item.length)
        self.beam_entry.set_value(self.item.beam)
        self.draft_entry.set_value(self.item.draft)
        self.engine_make_entry.set_text(self.item.engine_make)
        self.engine_model_entry.set_text(self.item.engine_model)
        self.engine_hours_entry.set_value(self.item.engine_hours)
        self.hull_material_entry.set_text(self.item.hull_material)
        self.build_year_entry.set_value(self.item.build_year)
        self.gross_tonnage_entry.set_value(self.item.gross_tonnage)
        self.current_location_entry.set_text(self.item.current_location)
        self.home_port_entry.set_text(self.item.home_port)
        self.registration_number_entry.set_text(self.item.registration_number)
        self.last_survey_entry.set_text(self.item.last_survey)
        self.insurance_expiry_entry.set_text(self.item.insurance_expiry)
        self.image_path_entry.set_text(self.item.image_path)

        buffer = self.notes_textview.get_buffer()
        buffer.set_text(self.item.notes)

        self.attachment_widget.set_attachments(self.item.attachments)

    def validate(self) -> bool:
        if not self.name_entry.is_valid:
            self.form_notebook.set_current_page(0)
            self.name_entry.entry.grab_focus()
            return False
        return True

    def get_values(self) -> Vessel:
        buffer = self.notes_textview.get_buffer()
        start_iter = buffer.get_start_iter()
        end_iter = buffer.get_end_iter()
        notes = buffer.get_text(start_iter, end_iter, False).strip()

        return Vessel(
            id=self.item.id if self.item else None,
            name=self.name_entry.get_text().strip(),
            vessel_type=self.type_combo.get_active_text() or "",
            length=self.length_entry.get_value(),
            beam=self.beam_entry.get_value(),
            draft=self.draft_entry.get_value(),
            engine_make=self.engine_make_entry.get_text().strip(),
            engine_model=self.engine_model_entry.get_text().strip(),
            engine_hours=self.engine_hours_entry.get_value(),
            hull_material=self.hull_material_entry.get_text().strip(),
            build_year=int(self.build_year_entry.get_value()),
            gross_tonnage=self.gross_tonnage_entry.get_value(),
            current_location=self.current_location_entry.get_text().strip(),
            home_port=self.home_port_entry.get_text().strip(),
            registration_number=self.registration_number_entry.get_text().strip(),
            last_survey=self.last_survey_entry.get_text(),
            insurance_expiry=self.insurance_expiry_entry.get_text(),
            image_path=self.image_path_entry.get_text().strip(),
            notes=notes,
            attachments=self.attachment_widget.get_attachments()
        )

