            self.vessels_store.clear()
            for vessel in self.db.get_vessels():
                self.vessels_store.append([vessel.id, vessel.name, vessel.vessel_type, vessel.engine_hours])

            self.maintenance_store.clear()
            for task in self.db.get_maintenance_tasks():
                self.maintenance_store.append([task.id, task.vessel_name, task.system, task.task_name, task.next_due, task.get_status().name])

            self.inventory_store.clear()
            for item in self.db.get_inventory():
                self.inventory_store.append([item.id, item.name, item.part_number, item.current_stock])

            self.trips_store.clear()
            # Fix: Correctly map vessel_id to vessel name
            vessel_dict = {v.id: v.name for v in self.db.get_vessels()}
            for log in self.db.get_trip_logs():
                vessel_name = vessel_dict.get(log.vessel_id, "Unknown Vessel")
                self.trips_store.append([log.id, vessel_name, log.departure, log.arrival, log.origin, log.destination])

            self.suppliers_store.clear()
            for supplier in self.db.get_suppliers():
                self.suppliers_store.append([supplier.id, supplier.name, supplier.contact])
        except Exception as e:
            show_error_dialog(self, f"Error refreshing views: {e}")

