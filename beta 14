        for p in Priority:
            self.priority_combo.append_text(p.name.title())
        self._add_form_field(grid, 8, "Priority:", self.priority_combo)

        self.instructions_entry = self._add_form_field(grid, 9, "Instructions:", Gtk.TextView(), multiline=True)

        if self.task:
            self._load_existing_data()

        content.pack_start(grid, True, True, 0)
        self.add_button("Cancel", Gtk.ResponseType.CANCEL)
        self.add_button("Save", Gtk.ResponseType.OK)
        if self.task:
            self.add_button("Delete", Gtk.ResponseType.DELETE_EVENT)
        self.show_all()

    def _add_form_field(self, grid: Gtk.Grid, row: int, label: str, widget: Gtk.Widget, multiline: bool = False) -> Gtk.Widget:
        grid.attach(Gtk.Label(label=label, xalign=0), 0, row, 1, 1)
        if multiline:
            scroll = Gtk.ScrolledWindow()
            scroll.set_min_content_height(80)
            scroll.add(widget)
            grid.attach(scroll, 1, row, 1, 1)
        else:
            grid.attach(widget, 1, row, 1, 1)
        return widget

    def _load_existing_data(self):
         if not self.task:
             return
         # Vessel
         vessel_names = [v.name for v in self.vessels]
         if self.task.vessel_name in vessel_names:
             idx = vessel_names.index(self.task.vessel_name)
             self.vessel_combo.set_active(idx)

         # System
         if self.task.system in SYSTEM_CATEGORIES:
             idx = SYSTEM_CATEGORIES.index(self.task.system)
             self.system_combo.set_active(idx)

         self.task_name_entry.set_text(self.task.task_name)

         # Interval Type
         if self.task.interval_type:
             idx = list(IntervalType).index(self.task.interval_type)
             self.interval_type_combo.set_active(idx)

         self.interval_value_entry.set_value(self.task.interval_value)
         self.last_completed_entry.set_text(self.task.last_completed)
         self.last_hours_entry.set_value(self.task.last_hours)
         self.next_due_entry.set_text(self.task.next_due)

         # Priority
         if self.task.priority:
             idx = list(Priority).index(self.task.priority)
             self.priority_combo.set_active(idx)

         buffer = self.instructions_entry.get_buffer()
         buffer.set_text(self.task.instructions)

    def get_task_data(self) -> MaintenanceTask:
        buffer = self.instructions_entry.get_buffer()
        start, end = buffer.get_bounds()
        vessel_id = self.vessels[self.vessel_combo.get_active()].id if self.vessel_combo.get_active() >= 0 and self.vessels else 0
        return MaintenanceTask(
            id=self.task.id if self.task else None,
            vessel_id=vessel_id,
            vessel_name=self.vessel_combo.get_active_text() or "",
            system=self.system_combo.get_active_text() or "",
            task_name=self.task_name_entry.get_text(),
            template_id=None,
            interval_type=list(IntervalType)[self.interval_type_combo.get_active()] if self.interval_type_combo.get_active() >= 0 else IntervalType.HOURS,
            interval_value=int(self.interval_value_entry.get_value()),
            last_completed=self.last_completed_entry.get_text(),
            last_hours=self.last_hours_entry.get_value(),
            next_due=self.next_due_entry.get_text(),
            priority=list(Priority)[self.priority_combo.get_active()] if self.priority_combo.get_active() >= 0 else Priority.MEDIUM,
            parts_required=None,
            instructions=buffer.get_text(start, end, False)
        )

    def validate(self) -> bool:
        if not self.task_name_entry.get_text().strip():
            show_error_dialog(self, "Task name is required.")
            return False
        if self.vessel_combo.get_active() < 0:
             show_error_dialog(self, "Please select a vessel.")
             return False
        return True

