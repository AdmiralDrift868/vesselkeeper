        for i, interval_type in enumerate(IntervalType):
            if interval_type == self.item.interval_type:
                self.interval_type_combo.set_active(i)
                break

        self.interval_value_entry.set_value(self.item.interval_value)
        self.last_completed_entry.set_text(self.item.last_completed)
        self.last_hours_entry.set_value(self.item.last_hours)
        self.next_due_entry.set_text(self.item.next_due)

