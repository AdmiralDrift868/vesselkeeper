# --- Database Class ---
class Database:
    def __init__(self, db_path: str = "vessel_keeper.db"):
        self.db_path = db_path
        self.conn = None
        self._connect()
        self._create_tables()

    def _connect(self):
        self.conn = sqlite3.connect(self.db_path, check_same_thread=False)
        self.conn.row_factory = sqlite3.Row # Enable column access by name

    def _create_tables(self):
        cursor = self.conn.cursor()
        cursor.executescript("""
        CREATE TABLE IF NOT EXISTS vessels (
            id INTEGER PRIMARY KEY,
            name TEXT NOT NULL,
            vessel_type TEXT,
            length REAL,
            beam REAL,
            draft REAL,
            engine_make TEXT,
            engine_model TEXT,
            engine_hours REAL DEFAULT 0,
            hull_material TEXT,
            build_year INTEGER,
            last_survey TEXT,
            insurance_expiry TEXT,
            current_location TEXT,
            notes TEXT,
            attachments TEXT, -- JSON list of file paths
            registration_number TEXT,
            home_port TEXT,
            gross_tonnage REAL,
            image_path TEXT
        );

        CREATE TABLE IF NOT EXISTS maintenance_tasks (
            id INTEGER PRIMARY KEY,
            vessel_id INTEGER REFERENCES vessels(id) ON DELETE CASCADE,
            system TEXT,
            task_name TEXT NOT NULL,
            template_id INTEGER,
            interval_type TEXT,
            interval_value INTEGER,
            last_completed TEXT,
            last_hours REAL,
            next_due TEXT,
            priority TEXT,
            parts_required TEXT, -- JSON list of inventory item IDs
            instructions TEXT,
            labor_cost REAL DEFAULT 0,
            total_parts_cost REAL DEFAULT 0,
            attachments TEXT, -- JSON list of file paths
            status TEXT DEFAULT 'PENDING',
            assigned_to TEXT,
            estimated_duration_hours REAL DEFAULT 0,
            actual_duration_hours REAL DEFAULT 0,
            notes TEXT
        );

        CREATE TABLE IF NOT EXISTS inventory (
            id INTEGER PRIMARY KEY,
            name TEXT NOT NULL,
            part_number TEXT,
            description TEXT,
            category TEXT,
            system TEXT,
            location TEXT,
            current_stock INTEGER DEFAULT 0,
            minimum_stock INTEGER DEFAULT 0,
            supplier_id INTEGER REFERENCES suppliers(id),
            unit_cost REAL DEFAULT 0,
            specifications TEXT,
            attachments TEXT, -- JSON list of file paths
            reorder_quantity INTEGER DEFAULT 0,
            last_reorder_date TEXT,
            average_consumption_rate REAL DEFAULT 0,
            notes TEXT
        );

        CREATE TABLE IF NOT EXISTS suppliers (
            id INTEGER PRIMARY KEY,
            name TEXT NOT NULL,
            contact TEXT,
            phone TEXT,
            email TEXT,
            notes TEXT,
            attachments TEXT, -- JSON list of file paths
            address TEXT,
            website TEXT,
            preferred BOOLEAN DEFAULT 0,
            terms TEXT,
            last_order_date TEXT
        );

        CREATE TABLE IF NOT EXISTS trip_logs (
            id INTEGER PRIMARY KEY,
            vessel_id INTEGER REFERENCES vessels(id) ON DELETE CASCADE,
            departure TEXT,
            arrival TEXT,
            origin TEXT,
            destination TEXT,
            start_hours REAL,
            end_hours REAL,
            fuel_used REAL,
            distance REAL,
            crew TEXT,
            log_entries TEXT,
            attachments TEXT, -- JSON list of file paths
            status TEXT DEFAULT 'PLANNED',
            weather_conditions TEXT,
            sea_state TEXT,
            captain TEXT,
            notes TEXT
        );

        CREATE TABLE IF NOT EXISTS maintenance_templates (
            id INTEGER PRIMARY KEY,
            name TEXT NOT NULL,
            system TEXT,
            task_name TEXT NOT NULL,
            interval_type TEXT,
            interval_value INTEGER,
            priority TEXT,
            parts_required TEXT, -- JSON list of inventory item IDs
            instructions TEXT,
            labor_cost REAL DEFAULT 0,
            estimated_duration_hours REAL DEFAULT 0,
            notes TEXT
        );

        CREATE TABLE IF NOT EXISTS stock_transactions (
            id INTEGER PRIMARY KEY,
            item_id INTEGER REFERENCES inventory(id) ON DELETE CASCADE,
            transaction_type TEXT,
            quantity INTEGER,
            date TEXT,
            reference TEXT,
            notes TEXT
        );

        CREATE TABLE IF NOT EXISTS performance_metrics (
            id INTEGER PRIMARY KEY,
            vessel_id INTEGER REFERENCES vessels(id) ON DELETE CASCADE,
            metric_name TEXT,
            value REAL,
            unit TEXT,
            date_recorded TEXT,
            notes TEXT
        );
        """)
        self.conn.commit()

    def close(self):
        try:
            if self.conn:
                self.conn.close()
                logger.info("Database connection closed.")
        except Exception as e:
            logger.error(f"Error closing DB: {e}")

    # --- Vessels ---
    def add_vessel(self, vessel: Vessel) -> int:
        cursor = self.conn.cursor()
        cursor.execute(
            """INSERT INTO vessels 
            (name, vessel_type, length, beam, draft, engine_make, engine_model, 
             engine_hours, hull_material, build_year, last_survey, insurance_expiry, 
             current_location, notes, attachments, registration_number, home_port, 
             gross_tonnage, image_path) 
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
            (vessel.name, vessel.vessel_type, vessel.length, vessel.beam, vessel.draft,
             vessel.engine_make, vessel.engine_model, vessel.engine_hours,
             vessel.hull_material, vessel.build_year, vessel.last_survey,
             vessel.insurance_expiry, vessel.current_location, vessel.notes,
             json.dumps(vessel.attachments), vessel.registration_number,
             vessel.home_port, vessel.gross_tonnage, vessel.image_path)
        )
        self.conn.commit()
        vessel_id = cursor.lastrowid
        logger.info(f"Added vessel with ID {vessel_id}")
        return vessel_id

