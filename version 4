    def _status_cell_data_func(self, column, cell, model, tree_iter, data):
        status_text = model[tree_iter][9] # Assuming status is in column 9
        if status_text == "Overdue":
            cell.set_property('foreground', 'red')
        elif status_text == "Due Soon":
            cell.set_property('foreground', 'orange')
        elif status_text == "On Schedule":
            cell.set_property('foreground', 'green')
        elif status_text == "Completed":
            cell.set_property('foreground', 'gray')
        else:
            cell.set_property('foreground', 'black')

