            return

        # Set vessel in combo
        for i, vessel in enumerate(self.vessels):
            if vessel.id == self.item.vessel_id:
                self.vessel_combo.set_active(i)
                break

        # Set status in combo
        for i, status in enumerate(TripStatus):
            if status == self.item.status:
                self.status_combo.set_active(i)
                break

        self.departure_entry.set_text(self.item.departure)
        self.arrival_entry.set_text(self.item.arrival)
        self.origin_entry.set_text(self.item.origin)
        self.destination_entry.set_text(self.item.destination)
        self.start_hours_entry.set_value(self.item.start_hours)
        self.end_hours_entry.set_value(self.item.end_hours)
        self.fuel_used_entry.set_value(self.item.fuel_used)
        self.distance_entry.set_value(self.item.distance)
        self.captain_entry.set_text(self.item.captain)
        self.crew_entry.set_text(self.item.crew)
        self.weather_entry.set_text(self.item.weather_conditions)
        self.sea_state_entry.set_text(self.item.sea_state)

        # Set log entries in text view
        buffer = self.log_entries_textview.get_buffer()
        buffer.set_text(self.item.log_entries)

        # Set notes in text view
        buffer_notes = self.notes_textview.get_buffer()
        buffer_notes.set_text(self.item.notes)

        # Set attachments
        self.attachment_widget.set_attachments(self.item.attachments)

    def validate(self) -> bool:
        if self.vessel_combo.get_active() == -1:
            show_error_dialog(self, "Please select a vessel.")
            self.vessel_combo.grab_focus()
            return False

        if (self.departure_entry.get_text() and
            not self.departure_entry.validate_date()):
            show_error_dialog(self, "Departure date format is invalid. Please use YYYY-MM-DD.")
            self.departure_entry.entry.grab_focus()
            return False

        if (self.arrival_entry.get_text() and
            not self.arrival_entry.validate_date()):
            show_error_dialog(self, "Arrival date format is invalid. Please use YYYY-MM-DD.")
            self.arrival_entry.entry.grab_focus()
            return False

        departure = self.departure_entry.get_text()
        arrival = self.arrival_entry.get_text()
        if departure and arrival:
            try:
                dep_date = datetime.datetime.strptime(departure, "%Y-%m-%d").date()
                arr_date = datetime.datetime.strptime(arrival, "%Y-%m-%d").date()

                if arr_date < dep_date:
                    show_error_dialog(self, "Arrival date cannot be before departure date.")
                    self.arrival_entry.entry.grab_focus()
                    return False
            except ValueError:
                pass # Handled by validate_date

        if self.start_hours_entry.get_value() > self.end_hours_entry.get_value():
            show_error_dialog(self, "End hours cannot be less than Start hours.")
            self.end_hours_entry.grab_focus()
            return False

        return True

    def get_values(self) -> TripLog:
        buffer = self.log_entries_textview.get_buffer()
        start_iter = buffer.get_start_iter()
        end_iter = buffer.get_end_iter()
        log_entries = buffer.get_text(start_iter, end_iter, False).strip()

        buffer_notes = self.notes_textview.get_buffer()
        start_iter_notes = buffer_notes.get_start_iter()
        end_iter_notes = buffer_notes.get_end_iter()
        notes = buffer_notes.get_text(start_iter_notes, end_iter_notes, False).strip()

        # Get selected vessel ID
        vessel_index = self.vessel_combo.get_active()
        vessel_id = self.vessels[vessel_index].id if vessel_index >= 0 else 0

        # Get selected status
        status_index = self.status_combo.get_active()
        selected_status = list(TripStatus)[status_index] if status_index >= 0 else TripStatus.PLANNED

        log = TripLog(
            id=self.item.id if self.item else None,
            vessel_id=vessel_id,
            status=selected_status,
            departure=self.departure_entry.get_text(),
            arrival=self.arrival_entry.get_text(),
            origin=self.origin_entry.get_text().strip(),
            destination=self.destination_entry.get_text().strip(),
            start_hours=self.start_hours_entry.get_value(),
            end_hours=self.end_hours_entry.get_value(),
            fuel_used=self.fuel_used_entry.get_value(),
            distance=self.distance_entry.get_value(),
            captain=self.captain_entry.get_text().strip(),
            crew=self.crew_entry.get_text().strip(),
            weather_conditions=self.weather_entry.get_text().strip(),
            sea_state=self.sea_state_entry.get_text().strip(),
            log_entries=log_entries,
            notes=notes,
            attachments=self.attachment_widget.get_attachments()
        )
        return log

# --- Report Generator ---
class ReportGenerator:
    @staticmethod
    def generate_low_stock_report(db: Database, config: Dict[str, Any], filename: str) -> bool:
        """Generate a low stock report."""
        try:
            items = db.get_inventory_items()
            low_stock_items = [item for item in items if item.current_stock <= item.minimum_stock and item.minimum_stock > 0]

            with open(os.path.join(REPORTS_DIR, filename), 'w', newline='', encoding='utf-8') as csvfile:
                writer = csv.writer(csvfile)
                writer.writerow(["ID", "Name", "Part Number", "Current Stock", "Minimum Stock", "System", "Location", "Unit Cost", "Total Value"])
                total_value = 0.0
                for item in low_stock_items:
                    total_value_for_item = item.current_stock * item.unit_cost
                    total_value += total_value_for_item
                    writer.writerow([
                        item.id, item.name, item.part_number,
                        item.current_stock, item.minimum_stock,
                        item.system, item.location, item.unit_cost, total_value_for_item
                    ])
                writer.writerow([]) # Empty row
                writer.writerow(["", "", "", "", "", "", "", "TOTAL VALUE:", total_value])
            logger.info(f"Low stock report generated: {filename}")
            return True
        except Exception as e:
            logger.error(f"Failed to generate low stock report: {e}")
            return False

    @staticmethod
    def generate_maintenance_due_report(db: Database, config: Dict[str, Any], filename: str) -> bool:
        """Generate a maintenance due report."""
        try:
            tasks = db.get_maintenance_tasks()
            vessels = {v.id: v for v in db.get_vessels()}
            due_soon_days = config.get("due_soon_days", 7)

            with open(os.path.join(REPORTS_DIR, filename), 'w', newline='', encoding='utf-8') as csvfile:
                writer = csv.writer(csvfile)
                writer.writerow(["ID", "Vessel", "System", "Task Name", "Date", "Status", "Priority", "Assigned To", "Est. Duration (hrs)"])
                for task in tasks:
                    vessel = vessels.get(task.vessel_id, Vessel())
                    status_enum = task.get_status(vessel.engine_hours, due_soon_days)
                    if status_enum in [Status.OVERDUE, Status.DUE_SOON]:
                        date_str = task.next_due if task.next_due else task.last_completed
                        writer.writerow([
                            task.id, vessel.name, task.system, task.task_name,
                            date_str, status_enum.display_name(), task.priority.display_name(),
                            task.assigned_to, task.estimated_duration_hours
                        ])
            logger.info(f"Maintenance due report generated: {filename}")
            return True
        except Exception as e:
            logger.error(f"Failed to generate maintenance due report: {e}")
            return False

    @staticmethod
    def generate_maintenance_cost_report(db: Database, config: Dict[str, Any], filename: str) -> bool:
        """Generate a maintenance cost report."""
        try:
            tasks = db.get_maintenance_tasks()
            vessels = {v.id: v for v in db.get_vessels()}

            with open(os.path.join(REPORTS_DIR, filename), 'w', newline='', encoding='utf-8') as csvfile:
                writer = csv.writer(csvfile)
                writer.writerow(["ID", "Vessel", "System", "Task Name", "Labor Cost", "Parts Cost", "Total Cost", "Status"])
                total_labor = 0.0
                total_parts = 0.0
                total_cost = 0.0
                for task in tasks:
                    vessel = vessels.get(task.vessel_id, Vessel())
                    labor_cost, parts_cost, total_job_cost = calculate_maintenance_cost(task, db)
                    total_labor += labor_cost
                    total_parts += parts_cost
                    total_cost += total_job_cost
                    writer.writerow([
                        task.id, vessel.name, task.system, task.task_name,
                        labor_cost, parts_cost, total_job_cost, task.status.value
                    ])
                writer.writerow([]) # Empty row
                writer.writerow(["", "", "", "TOTALS:", total_labor, total_parts, total_cost])
            logger.info(f"Maintenance cost report generated: {filename}")
            return True
        except Exception as e:
            logger.error(f"Failed to generate maintenance cost report: {e}")
            return False

    @staticmethod
    def generate_vessel_performance_report(db: Database, config: Dict[str, Any], vessel_id: int, filename: str) -> bool:
        """Generate a performance report for a specific vessel."""
        try:
            # Get vessel name
            vessels = db.get_vessels()
            vessel = next((v for v in vessels if v.id == vessel_id), None)
            if not vessel:
                logger.error(f"Vessel with ID {vessel_id} not found for performance report.")
                return False

            # Get performance metrics for the vessel
            metrics = db.get_performance_metrics(vessel_id=vessel_id)

            # Group metrics by name
            metric_data = {}
            for metric in metrics:
                if metric.metric_name not in metric_data:
                    metric_data[metric.metric_name] = {'dates': [], 'values': []}
                metric_data[metric.metric_name]['dates'].append(datetime.datetime.strptime(metric.date_recorded, "%Y-%m-%d"))
                metric_data[metric.metric_name]['values'].append(metric.value)

            # Create the report file and plot
            full_path = os.path.join(REPORTS_DIR, filename)
            with PdfPages(full_path) as pdf:
                fig, ax = plt.subplots(figsize=(10, 6))
                ax.set_title(f"Performance Metrics for {vessel.name}")
                ax.set_xlabel("Date")
                ax.set_ylabel("Value")
                ax.grid(True)

                for metric_name, data in metric_data.items():
                    ax.plot(data['dates'], data['values'], label=metric_name, marker='o')

                ax.legend()
                plt.xticks(rotation=45)
                plt.tight_layout()
                pdf.savefig(fig)
                plt.close(fig)

            logger.info(f"Vessel performance report generated: {full_path}")
            return True
        except Exception as e:
            logger.error(f"Failed to generate vessel performance report: {e}")
            return False

