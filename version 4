                system=row['system'],
                task_name=row['task_name'],
                template_id=row['template_id'],
                interval_type=IntervalType[row['interval_type']] if row['interval_type'] in IntervalType.__members__ else IntervalType.HOURS,
                interval_value=int(row['interval_value']),
                last_completed=row['last_completed'],
                last_hours=float(row['last_hours']),
                next_due=row['next_due'],
                priority=Priority[row['priority']] if row['priority'] in Priority.__members__ else Priority.MEDIUM,
                parts_required=parts_required,
                instructions=row['instructions'],
                labor_cost=float(row['labor_cost']),
                total_parts_cost=float(row['total_parts_cost']),
                total_job_cost=float(row['labor_cost']) + float(row['total_parts_cost']),
                attachments=json.loads(row['attachments']) if row['attachments'] else [],
