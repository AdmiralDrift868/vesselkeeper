        self.update_templates_list()
        self.update_dashboard()

    def update_vessels_list(self):
        self.vessels_store.clear()
        vessels = self.db.get_vessels()
        for vessel in vessels:
            self.vessels_store.append([
                vessel.id or 0, vessel.name, vessel.vessel_type,
                vessel.length, vessel.beam, vessel.draft,
                vessel.engine_hours, vessel.notes[:50]  # Truncate notes
            ])

    def update_maintenance_list(self):
        self.master_maintenance_store.clear()
        tasks = self.db.get_maintenance_tasks()
        vessels = {v.id: v for v in self.db.get_vessels()}

        for task in tasks:
            vessel = vessels.get(task.vessel_id, Vessel())
            self.master_maintenance_store.append([
