    def on_create_backup(self, menu_item):
        timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        backup_filename = f"vessel_keeper_backup_{timestamp}.zip"
        backup_path = os.path.join(BACKUP_DIR, backup_filename)

        try:
            with zipfile.ZipFile(backup_path, 'w', zipfile.ZIP_DEFLATED) as zipf:
                # Add database file
                zipf.write(self.db.db_path, os.path.basename(self.db.db_path))
                # Add config file
                if os.path.exists(CONFIG_FILE):
                    zipf.write(CONFIG_FILE, os.path.basename(CONFIG_FILE))
                # Add attachments directory
                if os.path.exists(ATTACHMENTS_DIR):
                    for root, dirs, files in os.walk(ATTACHMENTS_DIR):
                        for file in files:
                            file_path = os.path.join(root, file)
                            zipf.write(file_path, os.path.relpath(file_path, os.path.dirname(ATTACHMENTS_DIR)))
            show_info_dialog(self, f"Backup created successfully: {backup_path}")
        except Exception as e:
            logger.error(f"Failed to create backup: {e}")
            show_error_dialog(self, f"Failed to create backup: {e}")

    def on_restore_backup(self, menu_item):
        dialog = Gtk.FileChooserDialog(
            title="Restore from Backup",
            parent=self,
            action=Gtk.FileChooserAction.OPEN,
            buttons=(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
                     Gtk.STOCK_OPEN, Gtk.ResponseType.OK)
        )
        dialog.set_current_folder(BACKUP_DIR)
        filter_zip = Gtk.FileFilter()
        filter_zip.set_name("ZIP files")
        filter_zip.add_pattern("*.zip")
        dialog.add_filter(filter_zip)

        response = dialog.run()
        if response == Gtk.ResponseType.OK:
            backup_path = dialog.get_filename()
            try:
                # Verify backup integrity with a hash check (if stored)
                # For now, just try to extract
                with zipfile.ZipFile(backup_path, 'r') as zipf:
                    # Check for expected files
                    expected_files = [os.path.basename(self.db.db_path), os.path.basename(CONFIG_FILE)]
                    missing_files = [f for f in expected_files if f not in zipf.namelist()]
                    if missing_files:
                        show_error_dialog(self, f"Backup file is missing expected files: {missing_files}")
                        dialog.destroy()
                        return

                    # Create a temporary directory for extraction
                    with tempfile.TemporaryDirectory() as temp_dir:
                        zipf.extractall(temp_dir)

                        # Confirm overwrite
                        if not show_confirmation_dialog(self, "This will overwrite the current database and configuration. Continue?"):
                            dialog.destroy()
                            return

                        # Stop database connection temporarily
                        self.db.close()

                        # Copy files to main directory
                        extracted_db_path = os.path.join(temp_dir, os.path.basename(self.db.db_path))
                        extracted_config_path = os.path.join(temp_dir, os.path.basename(CONFIG_FILE))
                        extracted_attachments_path = os.path.join(temp_dir, ATTACHMENTS_DIR)

                        shutil.copy2(extracted_db_path, self.db.db_path)
                        if os.path.exists(extracted_config_path):
                            shutil.copy2(extracted_config_path, CONFIG_FILE)
                        if os.path.exists(extracted_attachments_path):
                            # Clear current attachments and copy new ones
                            shutil.rmtree(ATTACHMENTS_DIR, ignore_errors=True)
                            shutil.copytree(extracted_attachments_path, ATTACHMENTS_DIR)

                # Reconnect to the restored database
                self.db = Database()
                self.config = self._load_config()
                self.refresh_views()
                show_info_dialog(self, f"Backup restored successfully from {backup_path}")
            except Exception as e:
                logger.error(f"Failed to restore backup: {e}")
                show_error_dialog(self, f"Failed to restore backup: {e}")
        dialog.destroy()

