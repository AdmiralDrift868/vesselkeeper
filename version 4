            return
        self._setup_ui()
        if self.item:
            self._populate_fields()

    def _setup_ui(self):
        self.transaction_type_combo = Gtk.ComboBoxText()
        for ttype in TransactionType:
            self.transaction_type_combo.append_text(ttype.value)
        self._add_form_field(0, "Type:", self.transaction_type_combo)

