# --- Enums ---
class IntervalType(Enum):
    HOURS = "Hours"
    DAYS = "Days"
    USAGE_CYCLES = "Usage Cycles"
    
    def display_name(self) -> str:
        return self.value

class Priority(Enum):
    LOW = "Low"
    MEDIUM = "Medium"
    HIGH = "High"
    CRITICAL = "Critical"
    
    def display_name(self) -> str:
        return self.value

class Status(Enum):
    OVERDUE = ("Overdue", "#dc3545")  # Red
    DUE_SOON = ("Due Soon", "#fd7e14")  # Orange
    ON_SCHEDULE = ("On Schedule", "#28a745")  # Green
    COMPLETED = ("Completed", "#6c757d")  # Gray
    
    def display_name(self) -> str:
        return self.value[0]
    
    def color(self) -> Optional[str]:
        return self.value[1]

class TaskStatus(Enum):
    PENDING = "Pending"
    IN_PROGRESS = "In Progress"
    COMPLETED = "Completed"
    CANCELLED = "Cancelled"

class TransactionType(Enum):
    INBOUND = "Inbound"
    OUTBOUND = "Outbound"
    ADJUSTMENT = "Adjustment"

class TripStatus(Enum):
    PLANNED = "Planned"
    IN_PROGRESS = "In Progress"
    COMPLETED = "Completed"
    CANCELLED = "Cancelled"

