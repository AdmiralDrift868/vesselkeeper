    def get_values(self) -> PerformanceMetric:
        buffer = self.notes_textview.get_buffer()
        start_iter = buffer.get_start_iter()
        end_iter = buffer.get_end_iter()
        notes = buffer.get_text(start_iter, end_iter, False).strip()

        metric = PerformanceMetric(
            id=self.item.id if self.item else None,
            vessel_id=self.vessel_id,
            metric_name=self.metric_name_entry.get_text().strip(),
            value=self.value_entry.get_value(),
            unit=self.unit_entry.get_text().strip(),
            date_recorded=self.date_entry.get_text(),
            notes=notes
        )
        return metric

