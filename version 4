            return

        try:
            tasks = self.db.get_maintenance_tasks()
            task = next((t for t in tasks if t.id == task_id), None)
            if not task:
                show_error_dialog(self, "Task not found.")
                return

            # Confirm action
            if not show_confirmation_dialog(self, f"Mark task '{task.task_name}' as completed?"):
                return

            # Update task
            task.last_completed = datetime.date.today().strftime("%Y-%m-%d")
            # Calculate next due date if applicable
            if task.interval_type in [IntervalType.HOURS, IntervalType.USAGE_CYCLES]:
                vessels = self.db.get_vessels()
                vessel = next((v for v in vessels if v.id == task.vessel_id), None)
                if vessel:
                    task.last_hours = vessel.engine_hours
            task.next_due = update_task_next_due(task, vessel) if vessel else ""
            task.status = TaskStatus.COMPLETED

            self.db.update_maintenance_task(task)
            self.update_maintenance_list()
            self.update_dashboard()
            show_info_dialog(self, f"Task '{task.task_name}' marked as completed.")
