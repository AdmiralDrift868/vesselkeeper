    def import_data_from_csv(self, import_dir: str):
        # This is a complex function that requires careful handling
        # of foreign key relationships, ID mapping, etc.
        # For simplicity in this expansion, we'll just import vessels as an example
        # A full implementation would handle all tables.
        vessel_file = os.path.join(import_dir, "vessels.csv")
        if os.path.exists(vessel_file):
            try:
                with open(vessel_file, 'r', newline='', encoding='utf-8') as csvfile:
                    reader = csv.DictReader(csvfile)
                    for row in reader:
                        attachments_raw = row.get('attachments', '[]')
                        try:
                            attachments = json.loads(attachments_raw)
                        except (json.JSONDecodeError, TypeError):
                            attachments = []
                        
                        # Copy attachments to local directory if they exist
                        local_attachments = []
                        for att_path in attachments:
                            if os.path.exists(att_path):
                                filename = os.path.basename(att_path)
                                dest_path = os.path.join(ATTACHMENTS_DIR, filename)
                                shutil.copy2(att_path, dest_path)
                                local_attachments.append(dest_path)
                            else:
                                logger.warning(f"Attachment file not found during import: {att_path}")
                        
                        vessel = Vessel(
                            name=row.get('name', ''),
                            vessel_type=row.get('vessel_type', ''),
                            length=float(row.get('length', 0.0)),
                            beam=float(row.get('beam', 0.0)),
                            draft=float(row.get('draft', 0.0)),
                            engine_make=row.get('engine_make', ''),
                            engine_model=row.get('engine_model', ''),
                            engine_hours=float(row.get('engine_hours', 0.0)),
                            hull_material=row.get('hull_material', ''),
                            build_year=int(row.get('build_year', 0)),
                            last_survey=row.get('last_survey', ''),
                            insurance_expiry=row.get('insurance_expiry', ''),
                            current_location=row.get('current_location', ''),
                            notes=row.get('notes', ''),
                            attachments=local_attachments,
                            registration_number=row.get('registration_number', ''),
                            home_port=row.get('home_port', ''),
                            gross_tonnage=float(row.get('gross_tonnage', 0.0)),
                            image_path=row.get('image_path', '') # Copy image if needed
                        )
                        # Check if vessel already exists by name
                        existing_vessels = [v for v in self.get_vessels() if v.name == vessel.name]
                        if not existing_vessels:
                            self.add_vessel(vessel)
                            logger.info(f"Imported vessel: {vessel.name}")
                        else:
                            logger.info(f"Vessel already exists, skipping: {vessel.name}")
            except Exception as e:
                logger.error(f"Failed to import vessels from {vessel_file}: {e}")
