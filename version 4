        self.date_entry = self._add_form_field(2, "Date:", DatePickerEntry())
        self.reference_entry = self._add_form_field(3, "Reference:", Gtk.Entry())

        # Current Stock Display
        self.current_stock_label = Gtk.Label()
        self.current_stock_label.set_text(f"Current Stock: {self.inventory_item.current_stock}")
        self.current_stock_label.set_halign(Gtk.Align.START)
        self.grid.attach(self.current_stock_label, 0, 4, 2, 1)

        # Notes text view
        scrolled_window = Gtk.ScrolledWindow()
        scrolled_window.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scrolled_window.set_size_request(-1, 100)

        self.notes_textview = Gtk.TextView()
        self.notes_textview.set_wrap_mode(Gtk.WrapMode.WORD)
        scrolled_window.add(self.notes_textview)
        self._add_form_field(5, "Notes:", scrolled_window)

    def _populate_fields(self):
        if not self.item:
            return
        for i, ttype in enumerate(TransactionType):
            if ttype == self.item.transaction_type:
                self.transaction_type_combo.set_active(i)
                break
        self.quantity_entry.set_value(self.item.quantity)
        self.date_entry.set_text(self.item.date)
        self.reference_entry.set_text(self.item.reference)
        buffer = self.notes_textview.get_buffer()
        buffer.set_text(self.item.notes)

    def validate(self) -> bool:
        quantity = int(self.quantity_entry.get_value())
        if quantity == 0:
            show_error_dialog(self, "Quantity cannot be zero.")
            self.quantity_entry.grab_focus()
            return False

        transaction_type = list(TransactionType)[self.transaction_type_combo.get_active()]
        if transaction_type == TransactionType.OUTBOUND and quantity > self.inventory_item.current_stock:
            show_error_dialog(self, f"Cannot remove {quantity} items. Current stock is {self.inventory_item.current_stock}.")
            self.quantity_entry.grab_focus()
            return False

        if not self.date_entry.validate_date():
            show_error_dialog(self, "Date format is invalid. Please use YYYY-MM-DD.")
            self.date_entry.entry.grab_focus()
            return False

        return True

    def get_values(self) -> StockTransaction:
        buffer = self.notes_textview.get_buffer()
        start_iter = buffer.get_start_iter()
        end_iter = buffer.get_end_iter()
        notes = buffer.get_text(start_iter, end_iter, False).strip()

        transaction_type = list(TransactionType)[self.transaction_type_combo.get_active()]
        quantity = int(self.quantity_entry.get_value())

        transaction = StockTransaction(
            id=self.item.id if self.item else None,
            item_id=self.item_id,
            transaction_type=transaction_type,
            quantity=quantity,
            date=self.date_entry.get_text(),
            reference=self.reference_entry.get_text().strip(),
            notes=notes
        )
        return transaction

