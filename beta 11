        menu_button.set_menu_model(builder.get_object("app-menu"))

    # ... (page creation methods - fix trip log vessel name lookup)

    def refresh_views(self):
        self.vessels_store.clear()
        for vessel in self.db.get_vessels():
            self.vessels_store.append([vessel.id, vessel.name, vessel.vessel_type, vessel.engine_hours])

        self.maintenance_store.clear()
        for task in self.db.get_maintenance_tasks():
            self.maintenance_store.append([task.id, task.vessel_name, task.system, task.task_name, task.next_due, task.get_status().name])

        self.inventory_store.clear()
        for item in self.db.get_inventory():
            self.inventory_store.append([item.id, item.name, item.part_number, item.current_stock])

        self.trips_store.clear()
        vessels = {v.id: v.name for v in self.db.get_vessels()}
        for log in self.db.get_trip_logs():
            vessel_name = vessels.get(log.vessel_id, "Unknown")
            self.trips_store.append([log.id, vessel_name, log.departure, log.arrival, log.origin, log.destination])

        self.suppliers_store.clear()
        for supplier in self.db.get_suppliers():
            self.suppliers_store.append([supplier.id, supplier.name, supplier.contact])

    # --- Actions ---
    def on_add_vessel(self, action, param):
        editor = VesselEditor(self, self.db)
        if editor.run() == Gtk.ResponseType.OK and editor.validate():
            self.db.add_vessel(editor.get_vessel_data())
            self.refresh_views()
        editor.destroy()

    # ... (other on_add_* methods)

# --- Main ---
class Application(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="com.example.VesselKeeper")
        self.db = Database(DB_PATH)

    def do_activate(self):
        win = self.props.active_window
        if not win:
            win = VesselKeeperApp(self, self.db)
        win.present()

    def do_shutdown(self):
        self.db.close()
        super().do_shutdown()

def main():
    app = Application()
    app.run()

if __name__ == "__main__":
    main()
