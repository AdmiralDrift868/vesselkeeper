# --- Enums ---
class Priority(Enum):
    CRITICAL = auto()
    HIGH = auto()
    MEDIUM = auto()
    LOW = auto()

class IntervalType(Enum):
    HOURS = auto()
    DAYS = auto()
    USAGE_CYCLES = auto()

class Status(Enum):
    OVERDUE = auto()
    DUE_SOON = auto()
    ON_SCHEDULE = auto()
    COMPLETED = auto()  # Note: not yet used in logic

# --- Data Classes ---
VESSEL_TYPES = [
    "Motor Yacht", "Sailboat", "Fishing Vessel",
    "RIB", "Catamaran", "Trawler", "Other"
]

