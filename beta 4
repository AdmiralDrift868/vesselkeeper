        self.notebook.append_page(self.inventory_box, Gtk.Label(label="Inventory"))

    def _setup_trips_tab(self):
        self.trips_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5, margin=10)
        self.notebook.append_page(self.trips_box, Gtk.Label(label="Trips"))

    def _load_initial_data(self):
        # Vessels sidebar
        self.vessel_list.foreach(lambda row: self.vessel_list.remove(row))
        vessels = self.db.get_vessels()
        for vessel in vessels:
            row = Gtk.ListBoxRow()
            row.vessel = vessel
            label = Gtk.Label(label=f"{vessel.name} ({vessel.registration})")
            row.add(label)
            self.vessel_list.add(row)
        self.vessel_list.show_all()

        # Vessels tab
        for child in self.vessels_box.get_children():
            self.vessels_box.remove(child)
        for vessel in vessels:
            label = Gtk.Label(
                label=f"{vessel.name} ({vessel.registration}) [{vessel.vessel_type}] - {vessel.length}m x {vessel.beam}m"
            )
            self.vessels_box.pack_start(label, False, False, 2)
        self.vessels_box.show_all()

        # Maintenance tab
        for child in self.maintenance_box.get_children():
            self.maintenance_box.remove(child)
        tasks = self.db.get_maintenance_tasks()
        for task in tasks:
            label = Gtk.Label(
                label=f"{task.task_name} for {task.vessel_name} [{task.system}] - Every {task.interval_value} {task.interval_type.name.lower()} [{task.priority.name}]"
            )
            self.maintenance_box.pack_start(label, False, False, 2)
        self.maintenance_box.show_all()

        # Inventory tab
        for child in self.inventory_box.get_children():
            self.inventory_box.remove(child)
        inventory = self.db.get_inventory()
        for item in inventory:
            label = Gtk.Label(
                label=f"{item.name} ({item.part_number}) [{item.category}] - {item.current_stock}/{item.minimum_stock} in stock"
            )
            self.inventory_box.pack_start(label, False, False, 2)
        self.inventory_box.show_all()

        # Trips tab
        for child in self.trips_box.get_children():
            self.trips_box.remove(child)
        trips = self.db.get_trip_logs()
        for trip in trips:
            label = Gtk.Label(
                label=f"{trip.departure} {trip.origin} → {trip.arrival or ''} {trip.destination or ''}, Vessel ID: {trip.vessel_id}, Crew: {trip.crew}"
            )
            self.trips_box.pack_start(label, False, False, 2)
        self.trips_box.show_all()

    def _on_vessel_selected(self, listbox, row):
        # Show vessel details (could pop up an editor or details window)
        pass

    def _on_search(self, entry):
        text = entry.get_text().lower()
        self.vessel_list.foreach(lambda row: self.vessel_list.remove(row))
        vessels = self.db.get_vessels()
        for vessel in vessels:
            if text in vessel.name.lower() or text in vessel.registration.lower():
                row = Gtk.ListBoxRow()
                row.vessel = vessel
                label = Gtk.Label(label=f"{vessel.name} ({vessel.registration})")
                row.add(label)
                self.vessel_list.add(row)
        self.vessel_list.show_all()

    def _show_vessel_editor(self, widget):
        editor = VesselEditor(self.window, self.db)
        response = editor.run()
        if response == Gtk.ResponseType.OK:
            vessel = editor.get_vessel_data()
            if vessel.id:
                # TODO: Update existing vessel
                pass
            else:
                self.db.add_vessel(vessel)
            self._load_initial_data()
        editor.destroy()

    def _show_maintenance_editor(self, widget):
        editor = MaintenanceTaskEditor(self.window, self.db)
        response = editor.run()
        if response == Gtk.ResponseType.OK:
            task = editor.get_task_data()
            if task.id:
                # TODO: Update existing task
                pass
            else:
                self.db.add_maintenance_task(task)
            self._load_initial_data()
        editor.destroy()

    def _show_inventory_editor(self, widget):
        editor = InventoryEditor(self.window, self.db)
        response = editor.run()
        if response == Gtk.ResponseType.OK:
            item = editor.get_item_data()
            if item.id:
                # TODO: Update existing item
                pass
            else:
                self.db.add_inventory_item(item)
            self._load_initial_data()
        editor.destroy()

    def _toggle_theme(self, widget):
        settings = Gtk.Settings.get_default()
        if self.current_theme == "light":
            settings.set_property("gtk-application-prefer-dark-theme", True)
            self.current_theme = "dark"
            widget.set_label("☀️")
        else:
            settings.set_property("gtk-application-prefer-dark-theme", False)
            self.current_theme = "light"
            widget.set_label("🌙")

    def run(self):
        self.window.show_all()
        Gtk.main()

