    def add_maintenance_task(self, task: MaintenanceTask) -> int:
        with self.get_cursor() as cursor:
            parts_required_json = None
            if task.parts_required:
                parts_required_data = [{'item_id': pr.item_id, 'quantity': pr.quantity} for pr in task.parts_required]
                parts_required_json = json.dumps(parts_required_data)
                
            cursor.execute("""
                INSERT INTO maintenance_tasks (vessel_id, system, task_name, template_id, interval_type, interval_value,
                                               last_completed, last_hours, next_due, priority, parts_required, instructions,
                                               labor_cost, total_parts_cost, attachments, status, assigned_to,
                                               estimated_duration_hours, actual_duration_hours, notes)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            """, (
                task.vessel_id, task.system, task.task_name, task.template_id,
                task.interval_type.name, task.interval_value,
                task.last_completed, task.last_hours, task.next_due,
                task.priority.name,
                parts_required_json,
                task.instructions, task.labor_cost, task.total_parts_cost,
                json.dumps(task.attachments), task.status.name,
                task.assigned_to, task.estimated_duration_hours,
                task.actual_duration_hours, task.notes
            ))
            return cursor.lastrowid

    def get_maintenance_tasks(self) -> List[MaintenanceTask]:
        with self.get_cursor() as cursor:
            cursor.execute("SELECT * FROM maintenance_tasks")
            rows = cursor.fetchall()
            tasks = []
            for row in rows:
                # Deserialize parts_required
                parts_required = None
                if row['parts_required']:
                    try:
                        parts_data = json.loads(row['parts_required'])
                        parts_required = [PartRequirement(item_id=pr['item_id'], quantity=pr.get('quantity', 1)) 
                                        for pr in parts_data]
                    except (json.JSONDecodeError, KeyError):
                        parts_required = None

                task = MaintenanceTask(
                    id=row['id'],
                    vessel_id=row['vessel_id'],
                    system=row['system'] or '',
                    task_name=row['task_name'] or '',
                    template_id=row['template_id'],
                    interval_type=IntervalType(row['interval_type']) if row['interval_type'] else IntervalType.HOURS,
                    interval_value=row['interval_value'] or 0,
                    last_completed=row['last_completed'] or '',
                    last_hours=row['last_hours'] or 0.0,
                    next_due=row['next_due'] or '',
                    priority=Priority(row['priority']) if row['priority'] else Priority.MEDIUM,
                    parts_required=parts_required,
                    instructions=row['instructions'] or '',
                    labor_cost=row['labor_cost'] or 0.0,
                    total_parts_cost=row['total_parts_cost'] or 0.0,
                    total_job_cost=(row['labor_cost'] or 0.0) + (row['total_parts_cost'] or 0.0),
                    status=TaskStatus(row['status']) if row['status'] else TaskStatus.ON_SCHEDULE,
                    assigned_to=row['assigned_to'] or '',
                    estimated_duration_hours=row['estimated_duration_hours'] or 0.0,
                    actual_duration_hours=row['actual_duration_hours'] or 0.0,
                    notes=row['notes'] or '',
                    attachments=self._safe_json_loads(row['attachments'])
                )
                tasks.append(task)
            return tasks

