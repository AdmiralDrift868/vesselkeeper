class BaseEditor(Gtk.Dialog):
    """Base class for editing forms."""
    def __init__(self, parent: Gtk.Window, title: str, item: Any = None):
        super().__init__(parent=parent, title=title, flags=0)
        self.item = item
        self.set_default_size(400, 300)
        self.setup_ui()
        if self.item:
            self.populate_fields()
        self.add_buttons(
            Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
            Gtk.STOCK_SAVE, Gtk.ResponseType.OK
        )
        self.set_response_sensitive(Gtk.ResponseType.OK, True)

    def setup_ui(self):
        """Override in subclasses to set up UI elements."""
        self.grid = Gtk.Grid()
        self.grid.set_column_spacing(10)
        self.grid.set_row_spacing(5)
        self.grid.set_margin_start(10)
        self.grid.set_margin_end(10)
        self.grid.set_margin_top(10)
        self.grid.set_margin_bottom(10)
        self.get_content_area().add(self.grid)

    def populate_fields(self):
        """Override in subclasses to populate fields with existing data."""
        pass

    def validate(self) -> bool:
        """Override in subclasses to validate input."""
        return True

    def get_values(self) -> Any:
        """Override in subclasses to retrieve values from UI elements."""
        pass

    def run(self):
        result = super().run()
        if result == Gtk.ResponseType.OK and not self.validate():
            return Gtk.ResponseType.CANCEL
        return result

    def _add_form_field(self, row: int, label_text: str, widget: Gtk.Widget):
        """Correctly adds a label and widget to the grid."""
        label = Gtk.Label(label=label_text)
        label.set_xalign(0)
        self.grid.attach(label, 0, row, 1, 1)
        self.grid.attach(widget, 1, row, 1, 1)
        return widget

class DatePickerEntry(Gtk.Box):
    def __init__(self):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL)
        self.entry = Gtk.Entry()
        self.button = Gtk.Button(label="...")
        self.button.connect("clicked", self._on_button_clicked)
        self.pack_start(self.entry, True, True, 0)
        self.pack_end(self.button, False, False, 0)

    def _on_button_clicked(self, button):
        dialog = Gtk.Dialog(title="Select Date", transient_for=self.get_toplevel(), flags=0)
        dialog.add_buttons(
            Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
            Gtk.STOCK_OK, Gtk.ResponseType.OK
        )
        calendar = Gtk.Calendar()
        current_date_str = self.entry.get_text()
        if current_date_str and validate_date(current_date_str):
             try:
                 date_obj = datetime.datetime.strptime(current_date_str, "%Y-%m-%d").date()
                 calendar.select_month(date_obj.month - 1, date_obj.year)
                 calendar.select_day(date_obj.day)
             except ValueError:
                 pass

        content_area = dialog.get_content_area()
        content_area.add(calendar)
        dialog.show_all()

        response = dialog.run()
        if response == Gtk.ResponseType.OK:
            year, month, day = calendar.get_date()
            date_str = f"{year:04d}-{month+1:02d}-{day:02d}"
            self.entry.set_text(date_str)
        dialog.destroy()

    def set_text(self, text: str):
        self.entry.set_text(text)

    def get_text(self) -> str:
        return self.entry.get_text()

    def validate_date(self, allow_empty: bool = True) -> bool:
        return validate_date(self.entry.get_text(), allow_empty)

    def grab_focus(self):
        self.entry.grab_focus()

class AttachmentWidget(Gtk.Box):
    def __init__(self):
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        self.set_margin_start(5)
        self.set_margin_end(5)
        self.set_margin_top(5)
        self.set_margin_bottom(5)
        self.attachments = []
        self.list_store = Gtk.ListStore(str)
        self.tree_view = Gtk.TreeView(model=self.list_store)
        renderer = Gtk.CellRendererText()
        column = Gtk.TreeViewColumn("Attachments", renderer, text=0)
        self.tree_view.append_column(column)
        self.add(self.tree_view)

        self.button_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.add_button = Gtk.Button(label="Add")
        self.remove_button = Gtk.Button(label="Remove")
        self.add_button.connect("clicked", self._on_add_clicked)
        self.remove_button.connect("clicked", self._on_remove_clicked)
        self.button_box.pack_start(self.add_button, False, False, 0)
        self.button_box.pack_start(self.remove_button, False, False, 0)
        self.add(self.button_box)

    def _on_add_clicked(self, button):
        dialog = Gtk.FileChooserDialog(
            title="Select Attachments",
            parent=self.get_toplevel(),
            action=Gtk.FileChooserAction.OPEN,
        )
        dialog.add_buttons(
            Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
            Gtk.STOCK_OPEN, Gtk.ResponseType.OK
        )
        dialog.set_select_multiple(True)

        response = dialog.run()
        if response == Gtk.ResponseType.OK:
            filenames = dialog.get_filenames()
            for filename in filenames:
                if filename not in self.attachments:
                    self.attachments.append(filename)
                    self.list_store.append([os.path.basename(filename)])
        dialog.destroy()

    def _on_remove_clicked(self, button):
        selection = self.tree_view.get_selection()
        model, tree_iter = selection.get_selected()
        if tree_iter is not None:
            filename = model[tree_iter][0]
            full_path = next((p for p in self.attachments if os.path.basename(p) == filename), None)
            if full_path:
                self.attachments.remove(full_path)
                self.list_store.remove(tree_iter)

    def get_attachments(self) -> List[str]:
        return self.attachments.copy()

    def set_attachments(self, attachments: List[str]):
        self.attachments = attachments
        self.list_store.clear()
        for path in attachments:
            self.list_store.append([os.path.basename(path)])

# --- Database Class ---
class ThreadSafeDatabase:
    def __init__(self, db_path=DATABASE_FILE):
        self.db_path = db_path
        self.conn = None
        self._lock = threading.RLock()
        self.open_connection()
        self.create_tables()

    @contextmanager
    def get_cursor(self):
        """Thread-safe context manager for database operations."""
        self._lock.acquire()
        try:
            cursor = self.conn.cursor()
            yield cursor
            self.conn.commit()
        except Exception as e:
            self.conn.rollback()
            raise e
        finally:
            self._lock.release()

    def open_connection(self):
        self.conn = sqlite3.connect(self.db_path, check_same_thread=False)
        self.conn.row_factory = sqlite3.Row

    def close(self):
        if self.conn:
            self.conn.close()
            self.conn = None

    def create_tables(self):
        with self.get_cursor() as cursor:
            cursor.executescript("""
            CREATE TABLE IF NOT EXISTS vessels (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL,
                vessel_type TEXT,
                length REAL,
                beam REAL,
                draft REAL,
                engine_make TEXT,
                engine_model TEXT,
                engine_hours REAL,
                hull_material TEXT,
                build_year INTEGER,
                last_survey TEXT,
                insurance_expiry TEXT,
                current_location TEXT,
                notes TEXT,
                attachments TEXT,
                registration_number TEXT,
                home_port TEXT,
                gross_tonnage REAL,
                image_path TEXT
            );

            CREATE TABLE IF NOT EXISTS suppliers (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL,
                contact TEXT,
                phone TEXT,
                email TEXT,
                notes TEXT,
                attachments TEXT,
                address TEXT,
                website TEXT,
                preferred BOOLEAN DEFAULT 0,
                terms TEXT,
                last_order_date TEXT
            );

            CREATE TABLE IF NOT EXISTS inventory_items (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL,
                part_number TEXT,
                description TEXT,
                category TEXT,
                system TEXT,
                location TEXT,
                current_stock INTEGER,
                minimum_stock INTEGER,
                supplier_id INTEGER REFERENCES suppliers(id) ON DELETE SET NULL,
                unit_cost REAL,
                specifications TEXT,
                attachments TEXT,
                reorder_quantity INTEGER DEFAULT 0,
