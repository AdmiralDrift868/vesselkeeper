    def refresh_views(self):
        """Refresh all data views"""
        # Refresh vessels
        self.vessels_store.clear()
        vessels = self.db.get_vessels()
        for vessel in vessels:
            self.vessels_store.append([
                vessel.id, vessel.name, vessel.vessel_type,
                f"{vessel.engine_make} {vessel.engine_model}", vessel.current_location
            ])

        # Refresh inventory
        self.inventory_store.clear()
        items = self.db.get_inventory_items()
        for item in items:
            self.inventory_store.append([
                item.id, item.name, item.part_number, item.category,
                item.current_stock, item.minimum_stock, item.unit_cost
            ])

        # Refresh maintenance tasks
        self.maintenance_store.clear()
        tasks = self.db.get_maintenance_tasks()
        for task in tasks:
            vessel = next((v for v in vessels if v.id == task.vessel_id), None)
            vessel_name = vessel.name if vessel else "Unknown"
            
            self.maintenance_store.append([
                task.id, vessel_name, task.system, task.task_name,
                task.next_due, task.status.value, task.priority.value
            ])

        # Refresh suppliers
        self.suppliers_store.clear()
        suppliers = self.db.get_suppliers()
        for supplier in suppliers:
            self.suppliers_store.append([
                supplier.id, supplier.name, supplier.contact or "",
                supplier.phone or "", supplier.email or "", supplier.preferred
            ])

        # Refresh trip logs
        self.trip_logs_store.clear()
        trip_logs = self.db.get_trip_logs()
        for log in trip_logs:
            vessel = next((v for v in vessels if v.id == log.vessel_id), None)
            vessel_name = vessel.name if vessel else "Unknown"
            
            departure_display = log.departure.split()[0] if log.departure else ""
            arrival_display = log.arrival.split()[0] if log.arrival else ""
            
            self.trip_logs_store.append([
                log.id, vessel_name, departure_display, arrival_display,
                log.destination or "", log.distance, log.fuel_used
            ])

        # Update dashboard
        self._update_dashboard()

    def _update_dashboard(self):
        """Update dashboard with current statistics"""
        vessels = self.db.get_vessels()
        items = self.db.get_inventory_items()
        tasks = self.db.get_maintenance_tasks()
        suppliers = self.db.get_suppliers()

        # Update summary labels
        self.vessel_count_label.set_text(f"Vessels: {len(vessels)}")
        self.inventory_count_label.set_text(f"Inventory Items: {len(items)}")
        self.maintenance_count_label.set_text(f"Maintenance Tasks: {len(tasks)}")
        self.supplier_count_label.set_text(f"Suppliers: {len(suppliers)}")

        # Update activities
        self.activities_store.clear()
        # Add some sample activities
        self.activities_store.append(["Application Started", datetime.datetime.now().strftime("%Y-%m-%d %H:%M")])
        if vessels:
            self.activities_store.append([f"Loaded {len(vessels)} vessels", ""])
        if items:
            self.activities_store.append([f"Loaded {len(items)} inventory items", ""])
        if tasks:
            overdue_count = sum(1 for t in tasks if t.status == TaskStatus.OVERDUE)
            if overdue_count > 0:
                self.activities_store.append([f"Found {overdue_count} overdue tasks", ""])

    def do_delete_event(self, event):
        """Handle window close event"""
        self._save_config()
        self.db.close()
        return False

# Main application entry point
def main():
    # Create reports directory if it doesn't exist
    if not os.path.exists(REPORTS_DIR):
        os.makedirs(REPORTS_DIR)
    
    app = VesselKeeperApp()
    app.connect("destroy", Gtk.main_quit)
    app.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
