                show_info_dialog(self, f"Task '{task_name}' deleted successfully.")
        else:
            show_error_dialog(self, "Please select a task to delete.")

    def on_mark_maintenance_task_completed(self, button):
        selection = self.maintenance_tree.get_selection()
        model, tree_iter = selection.get_selected()
        if tree_iter is not None:
            task_id = model[tree_iter][0]
            task_name = model[tree_iter][3]
            
            completion_dialog = Gtk.Dialog(title="Mark Task Completed", parent=self, flags=0)
            completion_dialog.add_buttons(
                Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
                Gtk.STOCK_OK, Gtk.ResponseType.OK
            )
            completion_dialog.set_default_size(300, 150)
            
            content_area = completion_dialog.get_content_area()
            grid = Gtk.Grid()
            grid.set_column_spacing(10)
            grid.set_row_spacing(10)
            grid.set_margin_start(10)
            grid.set_margin_end(10)
            grid.set_margin_top(10)
            grid.set_margin_bottom(10)
            
            date_label = Gtk.Label(label="Completion Date:")
            date_entry = DatePickerEntry()
            date_entry.set_text(datetime.date.today().isoformat())
            
            hours_label = Gtk.Label(label="Engine Hours:")
            hours_entry = Gtk.SpinButton.new_with_range(0, 100000, 0.1)
            
            grid.attach(date_label, 0, 0, 1, 1)
            grid.attach(date_entry, 1, 0, 1, 1)
            grid.attach(hours_label, 0, 1, 1, 1)
            grid.attach(hours_entry, 1, 1, 1, 1)
            
            content_area.add(grid)
            completion_dialog.show_all()
            
            response = completion_dialog.run()
            if response == Gtk.ResponseType.OK:
                completion_date = date_entry.get_text()
                completion_hours = hours_entry.get_value()
                
                if validate_date(completion_date):
                    self.db.mark_task_completed(task_id, completion_date, completion_hours)
                    self.refresh_views()
                    show_info_dialog(self, f"Task '{task_name}' marked as completed.")
                else:
                    show_error_dialog(self, "Invalid date format. Please use YYYY-MM-DD.")
            
            completion_dialog.destroy()
        else:
            show_error_dialog(self, "Please select a task to mark as completed.")

