            CREATE TABLE IF NOT EXISTS maintenance_tasks (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                vessel_id INTEGER REFERENCES vessels(id) ON DELETE CASCADE,
                system TEXT,
