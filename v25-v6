class DatePickerEntry(Gtk.Box):
    def __init__(self):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL)
        self.entry = Gtk.Entry()
        self.entry.set_placeholder_text("YYYY-MM-DD")
        self.button = Gtk.Button.new_from_icon_name("x-office-calendar", Gtk.IconSize.BUTTON)
        self.button.connect("clicked", self.on_calendar_clicked)
        self.pack_start(self.entry, True, True, 0)
        self.pack_start(self.button, False, False, 0)
        self.calendar_dialog = None

    def on_calendar_clicked(self, button):
        self.calendar_dialog = Gtk.Dialog(title="Select Date", transient_for=self.get_toplevel())
        self.calendar_dialog.add_buttons(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL, Gtk.STOCK_OK, Gtk.ResponseType.OK)
        
        calendar = Gtk.Calendar()
        self.calendar_dialog.get_content_area().pack_start(calendar, True, True, 0)
        calendar.show()
        
        response = self.calendar_dialog.run()
        if response == Gtk.ResponseType.OK:
            year, month, day = calendar.get_date()
            date_str = f"{year:04d}-{month+1:02d}-{day:02d}" # Month is 0-based in Gtk.Calendar
            self.entry.set_text(date_str)
        self.calendar_dialog.destroy()

    def get_text(self) -> str:
        return self.entry.get_text()

    def set_text(self, text: str):
        self.entry.set_text(text)

    def validate_date(self) -> bool:
        text = self.entry.get_text()
        if not text:
            return True  # Allow empty
        try:
            datetime.datetime.strptime(text, "%Y-%m-%d")
            return True
        except ValueError:
            return False

    def grab_focus(self):
        self.entry.grab_focus()

class AttachmentWidget(Gtk.Box):
    def __init__(self, parent_window, initial_attachments=None):
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        self.parent_window = parent_window
        self.attachments = initial_attachments if initial_attachments else []
        
        self.label = Gtk.Label(label="Attachments:", xalign=0)
        self.pack_start(self.label, False, False, 0)
        
        self.listbox = Gtk.ListBox()
        self.scrolled = Gtk.ScrolledWindow()
        self.scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.scrolled.set_min_content_height(100)
        self.scrolled.add(self.listbox)
        self.pack_start(self.scrolled, True, True, 0)
        
        self.button_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.add_button = Gtk.Button.new_with_label("Add File")
        self.add_button.connect("clicked", self.on_add_clicked)
        self.button_box.pack_start(self.add_button, False, False, 0)
        self.pack_start(self.button_box, False, False, 0)
        
        self.refresh_list()

    def refresh_list(self):
        # Clear existing items
        for child in self.listbox.get_children():
            self.listbox.remove(child)
        
        for path in self.attachments:
            row = Gtk.ListBoxRow()
            hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
            label = Gtk.Label(label=os.path.basename(path), xalign=0)
            remove_button = Gtk.Button.new_from_icon_name("edit-delete", Gtk.IconSize.BUTTON)
            remove_button.connect("clicked", self.on_remove_clicked, path)
            hbox.pack_start(label, True, True, 0)
            hbox.pack_start(remove_button, False, False, 0)
            row.add(hbox)
            self.listbox.add(row)
        self.listbox.show_all()

    def on_add_clicked(self, button):
        dialog = Gtk.FileChooserDialog(
            title="Please choose a file",
            parent=self.parent_window,
            action=Gtk.FileChooserAction.OPEN
        )
        dialog.add_buttons(
            Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
            Gtk.STOCK_OPEN, Gtk.ResponseType.OK,
        )
        
        response = dialog.run()
        if response == Gtk.ResponseType.OK:
            filename = dialog.get_filename()
            # In a real app, you'd copy the file to a designated folder
            # For now, we just store the path
            self.attachments.append(filename)
            self.refresh_list()
        dialog.destroy()

    def on_remove_clicked(self, button, path):
        if path in self.attachments:
            self.attachments.remove(path)
            self.refresh_list()

    def get_attachments(self) -> List[str]:
        return self.attachments

# --- Report Generation ---
class ReportGenerator:
    @staticmethod
    def generate_low_stock_report(db: 'Database', config: Dict[str, Any], filename: str):
        """Generate a low stock inventory report."""
        try:
            items = db.get_inventory_items()
            low_stock_items = [item for item in items if item.current_stock <= item.minimum_stock]
            
            with open(filename, 'w', newline='', encoding='utf-8') as csvfile:
                writer = csv.writer(csvfile)
                writer.writerow(["ID", "Name", "Part Number", "Category", "System", "Location", "Current Stock", "Minimum Stock", "Unit Cost"])
                for item in low_stock_items:
                    writer.writerow([
                        item.id, item.name, item.part_number, item.category,
                        item.system, item.location, item.current_stock,
                        item.minimum_stock, item.unit_cost
                    ])
            logger.info(f"Low stock report generated: {filename}")
            return True
        except Exception as e:
            logger.error(f"Failed to generate low stock report: {e}")
            return False

    @staticmethod
    def generate_maintenance_due_report(db: 'Database', config: Dict[str, Any], filename: str):
        """Generate a maintenance due report."""
        try:
            tasks = db.get_maintenance_tasks()
            vessels = {v.id: v for v in db.get_vessels()}
            due_soon_days = config.get("due_soon_days", 7)
            
            with open(filename, 'w', newline='', encoding='utf-8') as csvfile:
                writer = csv.writer(csvfile)
                writer.writerow(["ID", "Vessel", "System", "Task Name", "Date", "Status", "Priority"])
                for task in tasks:
                    vessel = vessels.get(task.vessel_id, Vessel())
                    status = task.get_status(vessel.engine_hours, due_soon_days)
                    if status in [Status.OVERDUE, Status.DUE_SOON]:
                        date_str = task.next_due if task.next_due else task.last_completed
                        writer.writerow([
                            task.id, vessel.name, task.system, task.task_name,
                            date_str, status.display_name(), task.priority.display_name()
                        ])
            logger.info(f"Maintenance due report generated: {filename}")
            return True
        except Exception as e:
            logger.error(f"Failed to generate maintenance due report: {e}")
            return False

    @staticmethod
    def generate_maintenance_cost_report(db: 'Database', config: Dict[str, Any], filename: str):
        """Generate a maintenance cost report."""
        try:
            tasks = db.get_maintenance_tasks()
            
            with open(filename, 'w', newline='', encoding='utf-8') as csvfile:
                writer = csv.writer(csvfile)
                writer.writerow(["ID", "Task Name", "Labor Cost", "Parts Cost", "Total Cost"])
                total_labor = 0.0
                total_parts = 0.0
                total_cost = 0.0
                for task in tasks:
                    writer.writerow([
                        task.id, task.task_name, task.labor_cost,
                        task.total_parts_cost, task.total_job_cost
                    ])
                    total_labor += task.labor_cost
                    total_parts += task.total_parts_cost
                    total_cost += task.total_job_cost
                writer.writerow([]) # Empty row
                writer.writerow(["", "Totals", total_labor, total_parts, total_cost])
            logger.info(f"Maintenance cost report generated: {filename}")
            return True
        except Exception as e:
            logger.error(f"Failed to generate maintenance cost report: {e}")
            return False

# --- Database ---
class Database:
    def __init__(self, db_path: str = "vessel_keeper.db"):
        self.db_path = db_path
        self.conn = None
        self.connect()
        self.create_tables()

    def connect(self):
        self.conn = sqlite3.connect(self.db_path)
        self.conn.row_factory = sqlite3.Row  # Allows accessing columns by name

    def create_tables(self):
        cursor = self.conn.cursor()
        cursor.executescript("""
        CREATE TABLE IF NOT EXISTS vessels (
            id INTEGER PRIMARY KEY,
            name TEXT NOT NULL,
            vessel_type TEXT,
            length REAL,
            beam REAL,
            draft REAL,
            engine_make TEXT,
            engine_model TEXT,
            engine_hours REAL DEFAULT 0,
            hull_material TEXT,
            build_year INTEGER,
            last_survey TEXT,
            insurance_expiry TEXT,
            current_location TEXT,
            notes TEXT,
            attachments TEXT -- JSON list of file paths
        );
        
        CREATE TABLE IF NOT EXISTS maintenance_tasks (
            id INTEGER PRIMARY KEY,
            vessel_id INTEGER REFERENCES vessels(id) ON DELETE CASCADE,
            system TEXT,
            task_name TEXT NOT NULL,
            template_id INTEGER,
            interval_type TEXT,
            interval_value INTEGER,
            last_completed TEXT,
            last_hours REAL,
            next_due TEXT,
            priority TEXT,
            parts_required TEXT, -- JSON list of inventory item IDs
            instructions TEXT,
            labor_cost REAL DEFAULT 0,
            total_parts_cost REAL DEFAULT 0,
            attachments TEXT -- JSON list of file paths
        );
        
        CREATE TABLE IF NOT EXISTS inventory (
            id INTEGER PRIMARY KEY,
            name TEXT NOT NULL,
            part_number TEXT,
            description TEXT,
            category TEXT,
            system TEXT, -- Added system field
            location TEXT, -- Added location field
            current_stock INTEGER DEFAULT 0,
            minimum_stock INTEGER DEFAULT 0,
            supplier_id INTEGER REFERENCES suppliers(id),
            unit_cost REAL DEFAULT 0,
            specifications TEXT,
            attachments TEXT -- JSON list of file paths
        );
        
        CREATE TABLE IF NOT EXISTS suppliers (
            id INTEGER PRIMARY KEY,
            name TEXT NOT NULL,
            contact TEXT,
            phone TEXT,
            email TEXT,
            notes TEXT,
            attachments TEXT -- JSON list of file paths
        );
        
        CREATE TABLE IF NOT EXISTS trip_logs (
            id INTEGER PRIMARY KEY,
            vessel_id INTEGER REFERENCES vessels(id) ON DELETE CASCADE,
            departure TEXT,
            arrival TEXT,
            origin TEXT,
            destination TEXT,
            start_hours REAL,
            end_hours REAL,
            fuel_used REAL,
            distance REAL,
            crew TEXT,
            log_entries TEXT,
            attachments TEXT -- JSON list of file paths
        );
        
        CREATE TABLE IF NOT EXISTS maintenance_templates (
            id INTEGER PRIMARY KEY,
            name TEXT NOT NULL,
            system TEXT,
            task_name TEXT NOT NULL,
            interval_type TEXT,
            interval_value INTEGER,
            priority TEXT,
            parts_required TEXT, -- JSON list of inventory item IDs
            instructions TEXT
        );
        """)
        self.conn.commit()

    def close(self):
        try:
            if self.conn:
                self.conn.close()
            logger.info("Database connection closed.")
        except Exception as e:
            logger.error(f"Error closing DB: {e}")

    # --- Vessels ---
    def add_vessel(self, vessel: Vessel) -> int:
        cursor = self.conn.cursor()
        cursor.execute("""
            INSERT INTO vessels (
                name, vessel_type, length, beam, draft, engine_make, engine_model,
                engine_hours, hull_material, build_year, last_survey,
                insurance_expiry, current_location, notes, attachments
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            vessel.name, vessel.vessel_type, vessel.length, vessel.beam, vessel.draft,
            vessel.engine_make, vessel.engine_model, vessel.engine_hours,
            vessel.hull_material, vessel.build_year, vessel.last_survey,
            vessel.insurance_expiry, vessel.current_location, vessel.notes,
            json.dumps(vessel.attachments)
        ))
        self.conn.commit()
        vessel_id = cursor.lastrowid
        logger.info(f"Added vessel with ID {vessel_id}")
        return vessel_id

    def update_vessel(self, vessel: Vessel):
        cursor = self.conn.cursor()
        cursor.execute("""
            UPDATE vessels SET
                name=?, vessel_type=?, length=?, beam=?, draft=?, engine_make=?,
                engine_model=?, engine_hours=?, hull_material=?, build_year=?,
                last_survey=?, insurance_expiry=?, current_location=?, notes=?,
                attachments=?
            WHERE id=?
        """, (
            vessel.name, vessel.vessel_type, vessel.length, vessel.beam, vessel.draft,
            vessel.engine_make, vessel.engine_model, vessel.engine_hours,
            vessel.hull_material, vessel.build_year, vessel.last_survey,
            vessel.insurance_expiry, vessel.current_location, vessel.notes,
            json.dumps(vessel.attachments), vessel.id
        ))
        self.conn.commit()
        logger.info(f"Updated vessel with ID {vessel.id}")

    def delete_vessel(self, vessel_id: int):
        cursor = self.conn.cursor()
        cursor.execute("DELETE FROM vessels WHERE id=?", (vessel_id,))
        self.conn.commit()
        logger.info(f"Deleted vessel with ID {vessel_id}")

    def get_vessels(self) -> List[Vessel]:
        cursor = self.conn.cursor()
        cursor.execute("SELECT * FROM vessels")
        rows = cursor.fetchall()
        vessels = []
        for row in rows:
            try:
                attachments = json.loads(row['attachments']) if row['attachments'] else []
            except (json.JSONDecodeError, TypeError):
                attachments = []
            vessel = Vessel(
                id=row['id'],
                name=row['name'],
                vessel_type=row['vessel_type'],
                length=row['length'] or 0.0,
                beam=row['beam'] or 0.0,
                draft=row['draft'] or 0.0,
                engine_make=row['engine_make'],
                engine_model=row['engine_model'],
                engine_hours=row['engine_hours'] or 0.0,
                hull_material=row['hull_material'],
                build_year=row['build_year'] or 0,
                last_survey=row['last_survey'],
                insurance_expiry=row['insurance_expiry'],
                current_location=row['current_location'],
                notes=row['notes'],
                attachments=attachments
            )
            vessels.append(vessel)
        return vessels

