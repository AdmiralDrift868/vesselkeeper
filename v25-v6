    def on_interval_type_changed(self, combo):
        active_index = combo.get_active()
        if active_index >= 0:
            interval_type = list(IntervalType)[active_index]
            # Enable/disable fields based on interval type
            is_date_based = (interval_type == IntervalType.DAYS)
            self.last_completed_entry.set_sensitive(is_date_based)
            self.next_due_entry.set_sensitive(is_date_based)
            self.last_hours_entry.set_sensitive(not is_date_based)

    def on_last_completed_changed(self, entry):
        # Trigger recalculation if needed
        self._calculate_next_due_if_needed()

    def _calculate_next_due_if_needed(self):
        active_index = self.interval_type_combo.get_active()
        if active_index >= 0:
            interval_type = list(IntervalType)[active_index]
            if interval_type == IntervalType.DAYS and self.last_completed_entry.get_text():
                try:
                    last_date = datetime.datetime.strptime(self.last_completed_entry.get_text(), "%Y-%m-%d").date()
                    interval_value = int(self.interval_value_entry.get_value())
                    if interval_value > 0:
                        next_due_date = last_date + datetime.timedelta(days=interval_value)
                        next_due_date_str = next_due_date.strftime("%Y-%m-%d")
                        self.next_due_entry.set_text(next_due_date_str)
                except ValueError:
                    # If calculation fails, keep user-entered next_due or clear it
                    # A more robust approach would be to log this or inform the user
                    pass # Keep existing next_due_entry value

    def on_select_parts_clicked(self, button):
        # Simple part selection dialog (list of checkboxes)
        dialog = Gtk.Dialog(title="Select Parts", transient_for=self, flags=0)
        dialog.add_buttons(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL, Gtk.STOCK_OK, Gtk.ResponseType.OK)
        
        parts = self.db.get_inventory_items()
        listbox = Gtk.ListBox()
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scrolled.set_min_content_height(200)
        scrolled.add(listbox)
        dialog.get_content_area().pack_start(scrolled, True, True, 0)
        
        checkboxes = []
        for part in parts:
            row = Gtk.ListBoxRow()
            hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
            checkbox = Gtk.CheckButton(label=f"{part.name} ({part.part_number})")
            checkbox.set_active(part.id in self.selected_part_ids)
            checkboxes.append((checkbox, part.id))
            hbox.pack_start(checkbox, False, False, 0)
            row.add(hbox)
            listbox.add(row)
        
        listbox.show_all()
        response = dialog.run()
        if response == Gtk.ResponseType.OK:
            self.selected_part_ids = [part_id for checkbox, part_id in checkboxes if checkbox.get_active()]
        dialog.destroy()

    def on_cost_changed(self, spinbutton):
        self._update_total_job_cost()

    def _update_total_job_cost(self):
        labor = self.labor_cost_entry.get_value()
        parts = self.total_parts_cost_entry.get_value()
        total = labor + parts
        self.total_job_cost_entry.set_value(total)

    def get_data(self) -> MaintenanceTask:
        text_buffer = self.instructions_entry.get_buffer()
        start_iter, end_iter = text_buffer.get_bounds()
        
        # Get selected values from combos
        vessel_id = 0
        vessel_name = ""
        active_vessel_index = self.vessel_combo.get_active()
        if active_vessel_index > 0: # 0 is empty option
            vessels = self.db.get_vessels()
            if active_vessel_index - 1 < len(vessels): # Adjust for empty option
                vessel = vessels[active_vessel_index - 1]
                vessel_id = vessel.id or 0
                vessel_name = vessel.name
        
        selected_interval_type = IntervalType.HOURS
        active_interval_index = self.interval_type_combo.get_active()
        if active_interval_index >= 0:
            selected_interval_type = list(IntervalType)[active_interval_index]
            
        selected_priority = Priority.MEDIUM
        active_priority_index = self.priority_combo.get_active()
        if active_priority_index >= 0:
            selected_priority = list(Priority)[active_priority_index]

        # Calculate next_due for date-based tasks if not already set or if last_completed changed
        next_due_date_str = self.next_due_entry.get_text()
        if selected_interval_type == IntervalType.DAYS and self.last_completed_entry.get_text():
            try:
                last_date = datetime.datetime.strptime(self.last_completed_entry.get_text(), "%Y-%m-%d").date()
                interval_value = int(self.interval_value_entry.get_value())
                if interval_value > 0:
                    next_due_date = last_date + datetime.timedelta(days=interval_value)
                    next_due_date_str = next_due_date.strftime("%Y-%m-%d")
            except ValueError:
                # Fixed: Handle calculation failure explicitly
                # Log the error or inform the user instead of silently passing
                logger.warning("Failed to calculate next due date. Keeping user-entered value or empty.")
                # next_due_date_str remains as self.next_due_entry.get_text() (already assigned above)
                # This is safer than `pass` which could leave it undefined if it was uninitialized before.
                pass # In this case, it's okay as next_due_date_str is already initialized.

        return MaintenanceTask(
            id=self.item.id if self.item else None,
            vessel_id=vessel_id,
            vessel_name=vessel_name,
            system=self.system_combo.get_active_text() or "",
            task_name=self.task_name_entry.get_text().strip(),
            template_id=None,  # Not set from editor
            interval_type=selected_interval_type,
            interval_value=int(self.interval_value_entry.get_value()),
            last_completed=self.last_completed_entry.get_text(),
            last_hours=self.last_hours_entry.get_value(),
            next_due=next_due_date_str, # Use the calculated or user-entered value
            priority=selected_priority,
            parts_required=self.selected_part_ids if self.selected_part_ids else None,
            instructions=text_buffer.get_text(start_iter, end_iter, False).strip(),
            labor_cost=self.labor_cost_entry.get_value(),
            total_parts_cost=self.total_parts_cost_entry.get_value(),
            total_job_cost=self.total_job_cost_entry.get_value(),
            attachments=self.attachment_widget.get_attachments()
        )

    def validate(self) -> bool:
        if not self.task_name_entry.get_text().strip():
            show_error_dialog(self, "Task name is required.")
            self.task_name_entry.grab_focus()
            return False
            
        if self.vessel_combo.get_active() <= 0: # 0 is empty option
            show_error_dialog(self, "Please select a vessel.")
            self.vessel_combo.grab_focus()
            return False
            
        if (self.last_completed_entry.get_text() and 
            not self.last_completed_entry.validate_date()):
            show_error_dialog(self, "Last Completed date format is invalid. Please use YYYY-MM-DD.")
            self.last_completed_entry.entry.grab_focus()
            return False
            
        if (self.next_due_entry.get_sensitive() and 
            self.next_due_entry.get_text() and 
            not self.next_due_entry.validate_date()):
            show_error_dialog(self, "Next Due date format is invalid. Please use YYYY-MM-DD.")
            self.next_due_entry.entry.grab_focus()
            return False
            
        last_completed = self.last_completed_entry.get_text()
        next_due = self.next_due_entry.get_text()
        if (last_completed and next_due and 
            self.next_due_entry.get_sensitive()):
            try:
                last_date = datetime.datetime.strptime(last_completed, "%Y-%m-%d").date()
                next_date = datetime.datetime.strptime(next_due, "%Y-%m-%d").date()
                # Fixed: Consider if next_date == last_date should be allowed
                # Changed from `if next_date < last_date:` to `if next_date <= last_date:`
                # to be more restrictive. Adjust logic based on business rules.
                if next_date <= last_date: # Allow equal dates?
                    show_error_dialog(self, "Next Due date cannot be before or equal to Last Completed date.")
                    self.next_due_entry.entry.grab_focus()
                    return False
            except ValueError:
                # This should be caught by validate_date, but just in case
                pass
                
        return True

