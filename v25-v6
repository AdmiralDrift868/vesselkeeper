    def _load_config(self) -> Dict[str, Any]:
        config = {"window_width": 1000, "window_height": 700, "window_x": 50, "window_y": 50, "due_soon_days": 7}
        if os.path.exists(CONFIG_FILE):
            try:
                with open(CONFIG_FILE, 'r') as f:
                    config.update(json.load(f))
            except Exception as e:
                logger.warning(f"Could not read config file: {e}")
        return config

    def _save_config(self):
        try:
            x, y = self.get_position()
            width, height = self.get_size()
            self.config.update({
                "window_x": x, "window_y": y,
                "window_width": width, "window_height": height
            })
            with open(CONFIG_FILE, 'w') as f:
                json.dump(self.config, f, indent=4)
        except Exception as e:
            logger.error(f"Could not save config: {e}")

    def _restore_window_state(self):
        x = self.config.get("window_x", 50)
        y = self.config.get("window_y", 50)
        width = self.config.get("window_width", 1000)
