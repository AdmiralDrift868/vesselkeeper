@dataclass
class MaintenanceTask:
    id: Optional[int] = None
    vessel_id: int = 0
    vessel_name: str = ""  # For display purposes
    system: str = ""
    task_name: str = ""
    template_id: Optional[int] = None
    interval_type: IntervalType = IntervalType.HOURS
    interval_value: int = 0
    last_completed: str = ""
    last_hours: float = 0.0
    next_due: str = ""
    priority: Priority = Priority.MEDIUM
    parts_required: Optional[List[int]] = None  # List of InventoryItem IDs
    instructions: str = ""
    labor_cost: float = 0.0
    total_parts_cost: float = 0.0  # Calculated from parts
    total_job_cost: float = 0.0  # labor_cost + total_parts_cost
    attachments: List[str] = field(default_factory=list)  # List of file paths

    def get_status(self, vessel_engine_hours: float, due_soon_days: int = 7) -> Status:
        # Simplified status logic based on snippets
        if self.last_completed and not self.next_due:
            return Status.COMPLETED
        if self.interval_type == IntervalType.DAYS and self.next_due:
            try:
                next_due_date = datetime.datetime.strptime(self.next_due, "%Y-%m-%d").date()
                today = datetime.date.today()
                if next_due_date < today:
                    return Status.OVERDUE
                elif (next_due_date - today).days <= due_soon_days:
                    return Status.DUE_SOON
                else:
                    return Status.ON_SCHEDULE
            except ValueError:
                pass  # Invalid date format
        elif self.interval_type in [IntervalType.HOURS, IntervalType.USAGE_CYCLES]:
            if self.last_hours + self.interval_value <= vessel_engine_hours:
                return Status.OVERDUE
            # Add more nuanced logic for "Due Soon" based on hours if needed
            else:
                return Status.ON_SCHEDULE
        return Status.ON_SCHEDULE  # Default

