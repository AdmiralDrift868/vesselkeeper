        text_buffer = self.notes_entry.get_buffer()
        start_iter, end_iter = text_buffer.get_bounds()
        
        # Get selected type from combo - Corrected variable name
        selected_type = ""
        active_index = self.type_combo.get_active()
        if active_index >= 0 and active_index < len(VESSEL_TYPES):
            selected_type = VESSEL_TYPES[active_index]
            
        return Vessel(
            id=self.item.id if self.item else None,
            name=self.name_entry.get_text().strip(),
            vessel_type=selected_type, # <-- Use vessel_type field name
            length=self.length_entry.get_value(),
            beam=self.beam_entry.get_value(),
            draft=self.draft_entry.get_value(),
            engine_make=self.engine_make_entry.get_text().strip(),
            engine_model=self.engine_model_entry.get_text().strip(),
            engine_hours=self.engine_hours_entry.get_value(),
            hull_material=self.hull_material_entry.get_text().strip(),
            build_year=int(self.build_year_entry.get_value()),
            last_survey=self.last_survey_entry.get_text(),
            insurance_expiry=self.insurance_expiry_entry.get_text(),
            current_location=self.location_entry.get_text().strip(),
            notes=text_buffer.get_text(start_iter, end_iter, False).strip(),
            attachments=self.attachment_widget.get_attachments()
        )

