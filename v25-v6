        vessel_id = 0
        vessel_name = ""
        active_index = self.vessel_combo.get_active()
        if active_index > 0: # 0 is empty option
            vessels = self.db.get_vessels()
            if active_index - 1 < len(vessels):
                vessel = vessels[active_index - 1]
                vessel_id = vessel.id or 0
                vessel_name = vessel.name
        
        return TripLog(
            id=self.item.id if self.item else None,
            vessel_id=vessel_id,
            vessel_name=vessel_name,
            departure=self.departure_entry.get_text(),
            arrival=self.arrival_entry.get_text(),
            origin=self.origin_entry.get_text().strip(),
            destination=self.destination_entry.get_text().strip(),
            start_hours=self.start_hours_entry.get_value(),
            end_hours=self.end_hours_entry.get_value(),
            fuel_used=self.fuel_used_entry.get_value(),
            distance=self.distance_entry.get_value(),
            crew=self.crew_entry.get_text().strip(),
            log_entries=text_buffer.get_text(start_iter, end_iter, False).strip(),
            attachments=self.attachment_widget.get_attachments()
        )

    def validate(self) -> bool:
        if self.vessel_combo.get_active() <= 0:
            show_error_dialog(self, "Please select a vessel.")
            self.vessel_combo.grab_focus()
            return False
            
        if not self.departure_entry.get_text().strip():
            show_error_dialog(self, "Departure date is required.")
            self.departure_entry.entry.grab_focus()
            return False
            
        if (self.departure_entry.get_text() and 
            not self.departure_entry.validate_date()):
            show_error_dialog(self, "Departure date format is invalid. Please use YYYY-MM-DD.")
            self.departure_entry.entry.grab_focus()
            return False
            
        if (self.arrival_entry.get_text() and 
            not self.arrival_entry.validate_date()):
            show_error_dialog(self, "Arrival date format is invalid. Please use YYYY-MM-DD.")
            self.arrival_entry.entry.grab_focus()
            return False
            
        start_hours = self.start_hours_entry.get_value()
        end_hours = self.end_hours_entry.get_value()
        if end_hours < start_hours:
            show_error_dialog(self, "End Engine Hours cannot be less than Start Engine Hours.")
            self.end_hours_entry.grab_focus()
            return False
            
        fuel_used = self.fuel_used_entry.get_value()
        if fuel_used < 0:
            show_error_dialog(self, "Fuel used cannot be negative.")
            self.fuel_used_entry.grab_focus()
            return False
            
        distance = self.distance_entry.get_value()
        if distance < 0:
            show_error_dialog(self, "Distance cannot be negative.")
            self.distance_entry.grab_focus()
            return False
            
        return True

# --- Report Dialog ---
class ReportDialog(Gtk.Dialog):
    def __init__(self, parent: Gtk.Window, db: Database, report_type: str, config: Dict[str, Any]):
        super().__init__(title=f"Generate {report_type} Report", transient_for=parent, flags=0)
        self.db = db
        self.report_type = report_type
        self.config = config
        self.set_default_size(300, 150)
        self.set_modal(True)

        self.grid = Gtk.Grid()
        self.grid.set_row_spacing(10)
        self.grid.set_column_spacing(10)
        self.grid.set_border_width(10)
        
        content_area = self.get_content_area()
        content_area.pack_start(self.grid, True, True, 0)
        
        self.filename_entry = Gtk.Entry()
        self.filename_entry.set_text(f"{report_type.replace(' ', '_').lower()}_{datetime.datetime.now().strftime('%Y%m%d_%H%M%S')}.csv")
        self._add_form_field(0, "Filename:", self.filename_entry)
        
        self.add_buttons(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
                         "Generate", Gtk.ResponseType.OK)

    def _add_form_field(self, row: int, label_text: str, widget: Gtk.Widget) -> Gtk.Widget:
        label = Gtk.Label(label=label_text, xalign=0)
        self.grid.attach(label, 0, row, 1, 1)
        self.grid.attach(widget, 1, row, 1, 1)
        return widget

    def run(self):
        self.show_all()
        response = super().run()
        if response == Gtk.ResponseType.OK:
            filename = self.filename_entry.get_text().strip()
            if not filename:
                show_error_dialog(self, "Filename cannot be empty.")
                self.run() # Re-run dialog
                return
            if not filename.endswith('.csv'):
                filename += '.csv'
            full_path = os.path.join(REPORTS_DIR, filename)
            
            success = False
            if self.report_type == "Low Stock":
                success = ReportGenerator.generate_low_stock_report(self.db, self.config, full_path)
            elif self.report_type == "Maintenance Due":
                success = ReportGenerator.generate_maintenance_due_report(self.db, self.config, full_path)
            elif self.report_type == "Maintenance Cost":
                success = ReportGenerator.generate_maintenance_cost_report(self.db, self.config, full_path)
            
            if success:
                show_info_dialog(self.get_transient_for(), f"Report generated successfully:\n{full_path}")
            else:
                show_error_dialog(self.get_transient_for(), "Failed to generate report.")
        self.destroy()
        return response

