# --- Base Editor Dialog ---
class BaseEditor(Gtk.Dialog):
    def __init__(self, parent: Gtk.Window, title: str, item=None):
        super().__init__(title=title, transient_for=parent, flags=0)
        self.item = item
        self.set_default_size(400, 300)
        self.set_modal(True)

        self.grid = Gtk.Grid()
        self.grid.set_row_spacing(10)
        self.grid.set_column_spacing(10)
        self.grid.set_border_width(10)
        
        content_area = self.get_content_area()
        content_area.pack_start(self.grid, True, True, 0)
        
        self.add_buttons(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
                         Gtk.STOCK_OK, Gtk.ResponseType.OK)

    def _add_form_field(self, row: int, label_text: str, widget: Gtk.Widget, multiline: bool = False) -> Gtk.Widget:
        label = Gtk.Label(label=label_text, xalign=0)
        if multiline:
            scrolled = Gtk.ScrolledWindow()
            scrolled.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
            scrolled.set_min_content_height(100)
            scrolled.add(widget)
            self.grid.attach(label, 0, row, 1, 1)
            self.grid.attach(scrolled, 1, row, 1, 1)
            return widget
        else:
            self.grid.attach(label, 0, row, 1, 1)
            self.grid.attach(widget, 1, row, 1, 1)
            return widget

    def get_data(self):
        raise NotImplementedError

    def validate(self) -> bool:
        raise NotImplementedError

    def run(self):
        self.show_all()
        response = super().run()
        while response == Gtk.ResponseType.OK and not self.validate():
            # Stay in dialog if validation fails
            response = super().run()
        self.destroy() # Ensure dialog is destroyed after run
        return response

