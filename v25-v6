    def _refresh_dashboard(self):
        """Refresh the dashboard summary and lists."""
        tasks = self.db.get_maintenance_tasks()
        vessels = {v.id: v for v in self.db.get_vessels()}
        due_soon_days = self.config.get("due_soon_days", 7)
        
        overdue_count = 0
        due_soon_count = 0
        on_schedule_count = 0
        completed_count = 0
        
        self.upcoming_store.clear()
        upcoming_tasks = []
        
        for task in tasks:
            vessel = vessels.get(task.vessel_id, Vessel())
            status_enum = task.get_status(vessel.engine_hours, due_soon_days)
            
            if status_enum == Status.OVERDUE:
                overdue_count += 1
            elif status_enum == Status.DUE_SOON:
                due_soon_count += 1
                upcoming_tasks.append((task, status_enum))
            elif status_enum == Status.ON_SCHEDULE:
                on_schedule_count += 1
            elif status_enum == Status.COMPLETED:
                completed_count += 1
        
        # Update summary labels
        self.overdue_label.set_markup(f'<span background="#dc3545" foreground="white">Overdue: {overdue_count}</span>')
        self.due_soon_label.set_markup(f'<span background="#fd7e14" foreground="white">Due Soon: {due_soon_count}</span>')
        self.on_schedule_label.set_markup(f'<span background="#28a745" foreground="white">On Schedule: {on_schedule_count}</span>')
