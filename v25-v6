    def _get_selected_item(self, tree_view, store):
        """Get the selected item from a tree view."""
        selection = tree_view.get_selection()
        model, tree_iter = selection.get_selected()
        if tree_iter:
            # Convert filtered model iter to master store iter if needed
            if hasattr(model, 'convert_iter_to_child_iter'):
                tree_iter = model.convert_iter_to_child_iter(tree_iter)
            item_id = model[tree_iter][0] # ID is in the first column
            return item_id
        return None

    def _handle_edit(self, editor_class, get_items_func, add_func, update_func, delete_func, item_id=None):
        """Generic handler for add/edit/delete operations."""
        try:
            if item_id is None: # Add
                editor = editor_class(self, self.db)
                response = editor.run()
                if response == Gtk.ResponseType.OK:
                    item = editor.get_data()
                    add_func(item)
                    self.refresh_views()
                    logger.info(f"Added new item of type {editor_class.__name__}")
            else: # Edit or Delete
                items = get_items_func()
                item = next((i for i in items if i.id == item_id), None)
                if not item:
                    show_error_dialog(self, "Item not found.")
                    return
                    
                if delete_func: # Delete branch
                    item_name = getattr(item, 'name', 
                                      getattr(item, 'task_name', 
                                              getattr(item, 'description', 'this item')))
                    if show_confirmation_dialog(self, f"Are you sure you want to delete '{item_name}'?"):
                        try:
                            # Fixed: Ensure delete_func is called with correct argument
                            delete_func(item_id) # Pass item_id directly
                            self.refresh_views()
                            logger.info(f"Deleted item ID {item_id}")
                            show_info_dialog(self, f"Item '{item_name}' deleted successfully.")
                        except Exception as e:
                            logger.error(f"Error deleting item ID {item_id}: {e}", exc_info=True)
                            show_error_dialog(self, f"Failed to delete item: {e}")
                else: # Edit branch
                    editor = editor_class(self, self.db, item)
                    response = editor.run()
                    if response == Gtk.ResponseType.OK:
                        updated_item = editor.get_data()
                        try:
                            update_func(updated_item)
                            self.refresh_views()
                            logger.info(f"Updated item ID {item_id}")
                        except Exception as e:
                            logger.error(f"Error updating item ID {item_id}: {e}", exc_info=True)
                            show_error_dialog(self, f"Failed to update item: {e}")
        except Exception as e:
            logger.error(f"Error in _handle_edit: {e}", exc_info=True)
            show_error_dialog(self, f"An error occurred: {e}")

