    def on_mark_task_completed(self, widget):
        item_id = self._get_selected_item(self.maintenance_tree, self.master_maintenance_store)
        if not item_id:
            show_error_dialog(self, "Please select a task to mark as completed.")
            return

        try:
            tasks = self.db.get_maintenance_tasks()
            task = next((t for t in tasks if t.id == item_id), None)
            if not task:
                show_error_dialog(self, "Task not found.")
                return

            # Confirm action
            if not show_confirmation_dialog(self, f"Mark task '{task.task_name}' as completed?"):
                return

            # Update task
            task.last_completed = datetime.date.today().strftime("%Y-%m-%d")
            
            # Calculate next due date if applicable
            if task.interval_type == IntervalType.DAYS and task.interval_value > 0:
                try:
                    last_date = datetime.datetime.strptime(task.last_completed, "%Y-%m-%d").date()
                    next_due_date = last_date + datetime.timedelta(days=task.interval_value)
                    task.next_due = next_due_date.strftime("%Y-%m-%d")
                except ValueError:
                    task.next_due = "" # Clear if calculation fails
            elif task.interval_type in [IntervalType.HOURS, IntervalType.USAGE_CYCLES]:
                # For hour-based tasks, we might update last_hours to current vessel hours
                # This requires fetching the vessel, which is omitted for brevity
                # next_due is not used for status in hour-based tasks, but we can clear it
                task.next_due = ""

            self.db.update_maintenance_task(task)
            self.refresh_views()
            logger.info(f"Marked task {item_id} as completed.")
            show_info_dialog(self, f"Task '{task.task_name}' marked as completed.")
        except Exception as e:
            logger.error(f"Error marking task as completed: {e}", exc_info=True)
            show_error_dialog(self, f"Error marking task as completed: {e}")

