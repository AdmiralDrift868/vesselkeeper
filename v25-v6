    def on_import_data(self, widget):
        dialog = Gtk.FileChooserDialog(
            title="Please choose a CSV file to import",
            parent=self,
            action=Gtk.FileChooserAction.OPEN
        )
        dialog.add_buttons(
            Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
            Gtk.STOCK_OPEN, Gtk.ResponseType.OK,
        )
        # Add file filter
        filter_csv = Gtk.FileFilter()
        filter_csv.set_name("CSV files")
        filter_csv.add_mime_type("text/csv")
        filter_csv.add_pattern("*.csv")
        dialog.add_filter(filter_csv)
        
        response = dialog.run()
        if response == Gtk.ResponseType.OK:
            import_file = dialog.get_filename()
            dialog.destroy()
            
            # Run import in background thread to prevent UI freeze
            def run_import():
                try:
                    self.db.import_data_from_csv(import_file)
                    GLib.idle_add(lambda: show_info_dialog(self, "Data imported successfully."))
                    GLib.idle_add(self.refresh_views)
                except Exception as e:
                    GLib.idle_add(lambda: show_error_dialog(self, f"Failed to import data: {e}"))
            
            thread = threading.Thread(target=run_import)
            thread.daemon = True
            thread.start()
            show_info_dialog(self, "Import started. Please wait...")
        else:
            dialog.destroy()

