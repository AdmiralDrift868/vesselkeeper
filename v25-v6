        elif current_page == 5: # Suppliers
            self._filter_store(self.suppliers_store, query, [1, 2]) # name, contact
        elif current_page == 6: # Trip Logs
            self._filter_store(self.trip_logs_store, query, [1, 2, 3, 4]) # vessel, departure, origin, destination

