                    for name, data in user_presets.items():
                         if not isinstance(data, dict):
                              log(f"Warning: Invalid preset format for '{name}'. Skipping.", "warning")
                              continue
                         # Ensure mass is in kg if it was saved as grams (heuristic: >1000g)
                         if "mass" in data and data.get("mass", 0) > 1000:
                              data["mass"] /= 1000
                              log(f"Info: Converted mass for preset '{name}' from grams to kg.", "info")
                         if "initial_mass" in data and data.get("initial_mass", 0) > 1000:
                              data["initial_mass"] /= 1000
                              log(f"Info: Converted initial_mass for preset '{name}' from grams to kg.", "info")
                    presets.update(user_presets)
                    log(f"Loaded {len(user_presets)} user presets from {PRESET_FILE}")
            except json.JSONDecodeError as e:
                log(f"Failed to decode JSON from {PRESET_FILE}: {e}", "error")
                QMessageBox.warning(self, "Load Error", f"Failed to load presets from {PRESET_FILE}: Invalid JSON format.")
            except Exception as e:
                log(f"Failed to load custom presets from {PRESET_FILE}: {e}", "error")
                QMessageBox.warning(self, "Load Error", f"Failed to load presets from {PRESET_FILE}: {str(e)}")
        else:
             log(f"Preset file {PRESET_FILE} not found. Using defaults only.", "info")
        return presets

    def save_presets(self):
        # Save only user-defined presets (exclude defaults)
        user_presets = {k: v for k, v in self.presets.items() if k not in self.default_presets}
        try:
            with open(PRESET_FILE, "w") as f:
                json.dump(user_presets, f, indent=2)
            log(f"Saved {len(user_presets)} user presets to {PRESET_FILE}")
        except Exception as e:
            log(f"Failed to save custom presets to {PRESET_FILE}: {e}", "error")
            QMessageBox.warning(self, "Save Error", f"Failed to save presets to {PRESET_FILE}: {str(e)}")

    def load_config(self):
        if os.path.exists(CONFIG_FILE):
            try:
                with open(CONFIG_FILE, "r") as f:
                    config_data = json.load(f)
                    log(f"Loaded configuration from {CONFIG_FILE}")
                    return config_data
            except json.JSONDecodeError as e:
                log(f"Failed to decode JSON from {CONFIG_FILE}: {e}", "error")
                QMessageBox.warning(self, "Load Error", f"Failed to load config from {CONFIG_FILE}: Invalid JSON format. Using defaults.")
            except Exception as e:
                log(f"Failed to load config from {CONFIG_FILE}: {e}", "error")
                QMessageBox.warning(self, "Load Error", f"Failed to load config from {CONFIG_FILE}: {str(e)}. Using defaults.")
        else:
             log(f"Config file {CONFIG_FILE} not found. Using defaults.", "info")
        return {}

    def save_config(self):
        data = {
            "dark_mode": self.dark_mode_enabled,
            "imperial": self.use_imperial
        }
        try:
            with open(CONFIG_FILE, "w") as f:
                json.dump(data, f, indent=2)
            log(f"Saved configuration to {CONFIG_FILE}")
        except Exception as e:
            log(f"Failed to save config to {CONFIG_FILE}: {e}", "error")
            QMessageBox.warning(self, "Save Error", f"Failed to save config to {CONFIG_FILE}: {str(e)}")

    def apply_config(self):
        self.dark_mode_enabled = self.config.get("dark_mode", False)
        self.use_imperial = self.config.get("imperial", False)
        log(f"Applied config: Dark Mode = {self.dark_mode_enabled}, Imperial = {self.use_imperial}")

