# --- Utility Functions ---
def clamp(val: float, vmin: float, vmax: float) -> float:
    """Clamps a value between a minimum and maximum."""
    return max(vmin, min(val, vmax))

def linear_interpolate(x: float, x0: float, x1: float, y0: float, y1: float) -> float:
    """Performs linear interpolation."""
    if x1 == x0:
        return y0
    return y0 + ((y1 - y0) * (x - x0) / (x1 - x0))

def interpolate_curve(x: float, curve: List[Tuple[float, float]]) -> float:
    """Interpolates a value from a given curve (list of (x,y) tuples)."""
    if not curve:
        log("Warning: Interpolating from an empty curve.", "warning")
        return 0.0
    if len(curve) < 2:
        log("Warning: Interpolating from a curve with less than 2 points.", "warning")
        return curve[0][1] if curve else 0.0

    curve_sorted = sorted(curve, key=lambda p: p[0]) # Sort by x-value
    xs, ys = zip(*curve_sorted)
    if x <= xs[0]:
        return ys[0]
    if x >= xs[-1]:
        return ys[-1]
    # Find the segment for interpolation
    for i in range(1, len(xs)):
        if x < xs[i]:
            return linear_interpolate(x, xs[i - 1], xs[i], ys[i - 1], ys[i])
    return ys[-1] # Fallback (should not be reached if sorted correctly)

# --- Physics Models ---
class DragModel:
    """Enhanced drag coefficient tables for standard models"""
    @staticmethod
    @lru_cache(maxsize=4096)
    def G1(velocity: float) -> float:
        """G1 drag model (traditional bullet shape)"""
        mach = velocity / SPEED_OF_SOUND
        if mach > 4.0: return 0.45
        elif mach > 3.0: return 0.42
        elif mach > 2.5: return 0.40
        elif mach > 2.0: return 0.38
        elif mach > 1.5: return 0.35
        elif mach > 1.2: return 0.33
        elif mach > 1.0: return 0.31
        elif mach > 0.9: return 0.30
        elif mach > 0.8: return 0.29
        elif mach > 0.7: return 0.28
        elif mach > 0.6: return 0.27
        else: return 0.25

    @staticmethod
    @lru_cache(maxsize=4096)
    def G7(velocity: float) -> float:
        """G7 drag model (modern long-range bullet shape)"""
        mach = velocity / SPEED_OF_SOUND
        if mach > 4.0: return 0.38
        elif mach > 3.0: return 0.36
        elif mach > 2.5: return 0.34
        elif mach > 2.0: return 0.32
        elif mach > 1.5: return 0.30
        elif mach > 1.2: return 0.28
        elif mach > 1.0: return 0.26
        elif mach > 0.9: return 0.25
        elif mach > 0.8: return 0.24
        elif mach > 0.7: return 0.23
        elif mach > 0.6: return 0.22
        else: return 0.21

    @staticmethod
    @lru_cache(maxsize=4096)
    def rocket(velocity: float) -> float:
        """Drag model for rockets"""
        mach = velocity / SPEED_OF_SOUND
        if mach > 3.0: return 0.50
        elif mach > 2.0: return 0.45
        elif mach > 1.5: return 0.40
        elif mach > 1.0: return 0.35
        elif mach > 0.8: return 0.30
        else: return 0.25

    @staticmethod
    @lru_cache(maxsize=4096)
    def mortar(velocity: float) -> float:
        """Drag model for mortars"""
        mach = velocity / SPEED_OF_SOUND
        if mach > 1.5: return 0.55
        elif mach > 1.0: return 0.50
        elif mach > 0.8: return 0.45
        else: return 0.40

    @staticmethod
    def custom(velocity: float, curve: List[Tuple[float, float]]) -> float:
        """Uses a provided custom drag curve."""
        return interpolate_curve(velocity, curve)

class Projectile:
    """Projectile model for physics and mass/thrust properties."""
    def __init__(
        self,
        mass: float = 0.01, # kg (Final mass for rockets)
        diameter: float = 0.01, # meters
        drag_model: str = 'G7',
        velocity: float = 800, # m/s
        projectile_type: str = 'bullet',
        thrust_curve: Optional[Dict[float, float]] = None,
        burn_time: float = 0,
        custom_drag_curve: Optional[List[Tuple[float, float]]] = None,
        initial_mass: Optional[float] = None # kg (Initial mass for rockets)
    ):
        self.mass = mass  # kg (Final mass)
        self.diameter = diameter  # meters
        self.drag_model = drag_model
        self.velocity = velocity  # m/s (initial muzzle velocity)
        self.area = math.pi * (diameter/2)**2 # m^2
        self.projectile_type = projectile_type.lower() # Normalize type
        self.thrust_curve = thrust_curve or {}
        self.burn_time = burn_time
        # Handle initial mass for rockets
        if self.projectile_type == 'rocket':
            self.initial_mass = initial_mass if initial_mass is not None else mass
        else:
            self.initial_mass = mass # For non-rockets, initial and final are the same
        self.custom_drag_curve = custom_drag_curve

    def drag_coefficient(self, velocity: float) -> float:
        """Get drag coefficient based on current velocity"""
        try:
            if self.drag_model == 'G1':
                return DragModel.G1(velocity)
            elif self.drag_model == 'G7':
                return DragModel.G7(velocity)
            elif self.drag_model == 'rocket':
                return DragModel.rocket(velocity)
            elif self.drag_model == 'mortar':
                return DragModel.mortar(velocity)
            elif self.drag_model == 'Custom' and self.custom_drag_curve:
                return DragModel.custom(velocity, self.custom_drag_curve)
            else:
                log(f"Warning: Unknown drag model '{self.drag_model}' or missing curve for 'Custom'. Using default Cd=0.3", "warning")
                return 0.3  # Default for unknown models
        except Exception as e:
             log(f"Error calculating drag coefficient: {e}", "error")
             return 0.3 # Fallback

    def get_thrust(self, time: float) -> float:
        """Get current thrust based on thrust curve"""
        if self.projectile_type != 'rocket' or time > self.burn_time or not self.thrust_curve:
            return 0
        times = sorted(self.thrust_curve.keys())
        if not times:
            return 0
        if time <= times[0]:
            return self.thrust_curve[times[0]]
        if time >= times[-1]:
            return self.thrust_curve[times[-1]]
        # Linear interpolation between points
        for i in range(1, len(times)):
            if time <= times[i]:
                t0, t1 = times[i-1], times[i]
                f0, f1 = self.thrust_curve[t0], self.thrust_curve[t1]
                return f0 + (f1 - f0) * (time - t0) / (t1 - t0)
        return 0 # Fallback

    def get_mass(self, time: float) -> float:
        """Calculate current mass based on burn time (simplified linear burn)"""
        if self.projectile_type != 'rocket' or time > self.burn_time or self.burn_time <= 0:
            return self.mass # Return final mass
        # Linear mass reduction from initial to final mass
        return self.initial_mass - (self.initial_mass - self.mass) * (time / self.burn_time)

class Environment:
    """Environment model for air density and weather effects."""
    def __init__(
        self,
        altitude: float = 0, # meters
        temperature: float = 15, # °C
        pressure: float = 1013.25, # hPa
        humidity: float = 50, # %
        wind_speed: float = 0, # m/s
        wind_angle: float = 0, # degrees (0 = North, 90 = East)
        coriolis: bool = False,
        latitude: float = 45 # degrees
    ):
        self.altitude = altitude  # meters
        self.temperature = temperature  # °C
        self.pressure = pressure  # hPa
        self.humidity = humidity  # %
        self.wind_speed = wind_speed  # m/s
        self.wind_angle = wind_angle  # degrees
        self.coriolis = coriolis
        self.latitude = latitude
        self.air_density = self.calculate_air_density()

    @lru_cache(maxsize=128)
    def calculate_air_density(self) -> float:
        """Improved air density calculation using CIPM-2007 equation principles"""
        try:
            temp_kelvin = self.temperature + 273.15
            if temp_kelvin <= 0:
                 log("Warning: Temperature is non-positive in Kelvin. Density calculation may be inaccurate.", "warning")
                 temp_kelvin = 273.15 # Fallback to prevent division by zero or negative log
            R_specific = 287.058  # Specific gas constant for dry air, J/(kg·K)

            # Saturation vapor pressure (Magnus formula - good approximation)
            svp = 6.1078 * 10**((7.5 * self.temperature) / (self.temperature + 237.3))
            # Vapor pressure
            vp = svp * self.humidity / 100

            # Dry air pressure
            dry_pressure_pa = (self.pressure * 100) - vp # Convert hPa to Pa and subtract vapor pressure

            # Air density of dry air
            density_dry = dry_pressure_pa / (R_specific * temp_kelvin)

            # Correction for water vapor (simpler than full CIPM-2007 for this context)
            # Water vapor specific gas constant
            R_vapor = 461.495 # J/(kg·K)
            # Density of water vapor
            density_vapor = vp / (R_vapor * temp_kelvin)
            # Total density (approximate)
            density_total = density_dry + density_vapor

            # Altitude adjustment using barometric formula (simplified exponential)
            # This is an approximation. More accurate models exist (e.g., ISA).
            scale_height = 8500 # Approximate scale height for density in meters
            density_total *= math.exp(-self.altitude / scale_height)

            return density_total
        except Exception as e:
            log(f"Error calculating air density: {e}. Using fallback value.", "error")
            return 1.225 # Fallback to standard sea level density


# --- Calculation Threads ---
class CalculationThread(QThread):
    finished = pyqtSignal(object) # Signal carrying trajectory data (list or None)
    error = pyqtSignal(str)
    def __init__(self, calculator: 'BallisticCalculator', params: Dict[str, Any]):
        super().__init__()
        self.calculator = calculator
        self.params = params

    def run(self):
        try:
            result = self.calculator._calculate_trajectory(**self.params)
            self.finished.emit(result)
        except Exception as e:
            log(f"Calculation thread error: {e}", "error")
            self.error.emit(str(e))

class BatchCalculationThread(QThread):
    finished = pyqtSignal(list) # List of trajectory results
    error = pyqtSignal(str)
    progress = pyqtSignal(int) # Percentage
    def __init__(self, calculator: 'BallisticCalculator', batch_params: List[Dict[str, Any]]):
        super().__init__()
        self.calculator = calculator
        self.batch_params = batch_params

    def run(self):
        results = []
        try:
            total = len(self.batch_params)
            if total == 0:
                 self.finished.emit(results)
                 return
            for i, params in enumerate(self.batch_params):
                results.append(self.calculator._calculate_trajectory(**params))
                progress_percent = int((i+1) / total * 100)
                self.progress.emit(progress_percent)
            self.finished.emit(results)
        except Exception as e:
            log(f"Batch calculation thread error: {e}", "error")
            self.error.emit(str(e))

