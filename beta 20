    def run_batch(self):
        if not MATPLOTLIB_AVAILABLE:
            QMessageBox.warning(self, "Feature Unavailable", "Matplotlib is required for Batch Mode.")
            return

        param = self.batch_param_combo.currentText()
        start = self.batch_start_input.value()
        end = self.batch_end_input.value()
        step = self.batch_step_input.value()
        if step <= 0:
            QMessageBox.warning(self, "Warning", "Step must be positive")
            return
        if start > end:
             QMessageBox.warning(self, "Warning", "Start value must be less than or equal to End value.")
             return

        # Determine sweep parameter key
        param_map = {"Angle": "angle", "Muzzle Velocity": "velocity"}
        sweep_key = param_map.get(param)
        if sweep_key is None:
            QMessageBox.warning(self, "Warning", "Invalid sweep parameter selected")
            return

        # Create parameter sets
        runs = []
        val = start
        run_counter = 1
        while val <= end:
            # Start with base parameters from current UI state
            params = {
                "mass": self.mass_input.value() / 1000,
                "diameter": self.diam_input.value() / 1000,
                "drag_model": self.drag_model_combo.currentText(),
                "velocity": self.velocity_input.value(),
                "angle": self.angle_input.value(),
                "altitude": self.altitude_input.value(),
                "temperature": self.temp_input.value(),
                "pressure": self.pressure_input.value(),
                "humidity": self.humidity_input.value(),
                "wind_speed": self.wind_speed_input.value(),
                "wind_angle": self.wind_angle_input.value(),
                "coriolis": self.coriolis_check.isChecked(),
                "latitude": self.latitude_input.value(),
                "projectile_type": self.type_combo.currentText().lower(),
            }
            # Add rocket params if needed
            if params["projectile_type"] == "rocket":
                 params["initial_mass"] = self.initial_mass_input.value() / 1000
                 params["burn_time"] = self.burn_time_input.value()
                 params["thrust_curve"] = {0: self.thrust_input.value()}

            # Override the swept parameter
            params[sweep_key] = val
            runs.append(params)
            val += step
            run_counter += 1
            if run_counter > 1000: # Safety break
                 log("Batch run limit (1000) exceeded. Stopping.", "warning")
                 break

        if not runs:
            QMessageBox.warning(self, "Warning", "No parameter sets created for batch run")
            return

        self.batch_progress_bar.setValue(0)
        self.batch_table.setRowCount(0)
        self.batch_table.setSortingEnabled(False) # Disable sorting during population
        self.status_bar.showMessage(f"Running batch: {len(runs)} calculations...")

        # Create and start batch thread
        self.batch_thread = BatchCalculationThread(self, runs)
        self.batch_thread.progress.connect(self.batch_progress_bar.setValue)
        self.batch_thread.finished.connect(self.on_batch_complete)
        self.batch_thread.error.connect(self.on_batch_error)
        self.batch_thread.start()

    def on_batch_complete(self, results: List[Union[List[Tuple[float, ...]], None]]):
        if not MATPLOTLIB_AVAILABLE:
            return # Shouldn't happen if run_batch checked, but be safe

        try:
            num_runs = len(results)
            self.batch_trajectories = results # Store for potential later use
            self.batch_table.setRowCount(num_runs)

            # Populate table
            for i, traj in enumerate(results):
                row_position = self.batch_table.rowCount()
                if row_position <= i:
                    self.batch_table.insertRow(row_position)

                # Get parameter value for this run (assume it's linear sweep)
                param_val = self.batch_start_input.value() + i * self.batch_step_input.value()
                param_str = f"{param_val:.3f}" # Adjust decimals as needed

                if traj is not None and len(traj) > 0:
                    try:
                        y_coords = [p[1] for p in traj]
                        max_height = max(y_coords) if y_coords else 0.0
                        distance = traj[-1][0]
                        impact_velocity = traj[-1][5]
                    except (IndexError, ValueError, TypeError) as e:
                        log(f"Error processing batch result {i}: {e}", "warning")
                        max_height = distance = impact_velocity = 0.0
                        param_str += " (Error)"
                else:
                    max_height = distance = impact_velocity = 0.0
                    param_str += " (No Data)"

                # Create items
                items = [
                    QTableWidgetItem(str(i + 1)),
                    QTableWidgetItem(param_str),
                    QTableWidgetItem(f"{max_height:.2f}"),
                    QTableWidgetItem(f"{distance:.2f}"),
                    QTableWidgetItem(f"{impact_velocity:.2f}")
                ]
                # Set items (read-only is handled by setEditTriggers)
                for col, item in enumerate(items):
                    self.batch_table.setItem(i, col, item)

            self.batch_table.setSortingEnabled(True) # Re-enable sorting

            # Plot all successful trajectories
            self.figure.clear()
            ax = self.figure.add_subplot(111)
            plotted_count = 0
            for i, traj in enumerate(results):
                 if traj is not None and len(traj) > 1:
                      x = [p[0] for p in traj]
                      y = [p[1] for p in traj]
                      param_val = self.batch_start_input.value() + i * self.batch_step_input.value()
                      ax.plot(x, y, label=f"Run {i+1} ({self.batch_param_combo.currentText()}={param_val:.2f})")
                      plotted_count += 1
                      if plotted_count >= 20: # Limit plotted lines for clarity
                           ax.plot([],[], ' ', label='... (Plot limit reached)')
                           break

            ax.set_title('Batch Trajectories')
            ax.set_xlabel('Distance (m)')
            ax.set_ylabel('Height (m)')
            ax.grid(True, alpha=0.5)
            if plotted_count > 0:
                ax.legend(loc='upper right', fontsize='small')
            self.canvas.draw()

            self.status_bar.showMessage(f"Batch complete: {num_runs} runs finished. {plotted_count} trajectories plotted.")
            log(f"Batch calculation completed: {num_runs} runs.")
        except Exception as e:
            error_msg = f"Error processing batch results: {e}"
            log(error_msg, "error")
            QMessageBox.critical(self, "Batch Error", error_msg)
            self.status_bar.showMessage("Batch error during result processing.")

    def on_batch_error(self, error_msg: str):
        QMessageBox.critical(self, "Batch Error", f"Error during batch calculation:\n{error_msg}")
        self.status_bar.showMessage(f"Batch error: {error_msg}")
        log(f"Batch calculation error: {error_msg}", "error")
        # Reset UI elements
        self.batch_progress_bar.setValue(0)
        self.batch_table.setRowCount(0)


    def run_monte_carlo(self):
        if not MATPLOTLIB_AVAILABLE:
            QMessageBox.warning(self, "Feature Unavailable", "Matplotlib is required for Monte Carlo Mode.")
            return

        num_runs = self.mc_runs_input.value()
        angle_spread = self.mc_spread_angle.value()
        vel_spread = self.mc_spread_velocity.value()
        if num_runs <= 0:
            QMessageBox.warning(self, "Warning", "Number of runs must be positive")
            return
        if angle_spread < 0 or vel_spread < 0:
             QMessageBox.warning(self, "Warning", "Spread values must be non-negative.")
             return

        self.mc_progress_bar.setValue(0)
        self.status_bar.showMessage(f"Running Monte Carlo: {num_runs} simulations...")

        # Base parameters from current UI state
        base_params = {
            "mass": self.mass_input.value() / 1000,
            "diameter": self.diam_input.value() / 1000,
            "drag_model": self.drag_model_combo.currentText(),
            "velocity": self.velocity_input.value(),
            "angle": self.angle_input.value(),
            "altitude": self.altitude_input.value(),
            "temperature": self.temp_input.value(),
            "pressure": self.pressure_input.value(),
            "humidity": self.humidity_input.value(),
            "wind_speed": self.wind_speed_input.value(),
            "wind_angle": self.wind_angle_input.value(),
            "coriolis": self.coriolis_check.isChecked(),
            "latitude": self.latitude_input.value(),
            "projectile_type": self.type_combo.currentText().lower(),
        }
         # Add rocket params if needed
        if base_params["projectile_type"] == "rocket":
             base_params["initial_mass"] = self.initial_mass_input.value() / 1000
             base_params["burn_time"] = self.burn_time_input.value()
             base_params["thrust_curve"] = {0: self.thrust_input.value()}

        # Clear previous MC plot
        self.mc_figure.clear()
        ax = self.mc_figure.add_subplot(111)

        successful_runs = 0
        for i in range(num_runs):
            # Copy base parameters
            params = base_params.copy()
            # Apply random variations
            # Using uniform distribution for simplicity. Normal might be more realistic.
            params["angle"] += random.uniform(-angle_spread, angle_spread)
            params["velocity"] += random.uniform(-vel_spread, vel_spread)

            # Clamp angle to realistic values to prevent errors
            params["angle"] = clamp(params["angle"], 0.1, 89.9)

            # Calculate trajectory
            try:
                traj = self._calculate_trajectory(**params)
                if traj is not None and len(traj) > 1:
                    x = [p[0] for p in traj]
                    y = [p[1] for p in traj]
                    ax.plot(x, y, color="blue", alpha=0.1, linewidth=0.5)
                    successful_runs += 1
            except Exception as e:
                log(f"MC Run {i+1} failed: {e}", "warning")
                # Continue with other runs

            # Update progress
            progress_percent = int((i + 1) / num_runs * 100)
            self.mc_progress_bar.setValue(progress_percent)
            # Allow UI to update periodically
            if i % 10 == 0:
                 QApplication.processEvents()

        ax.set_title(f'Monte Carlo Trajectory Spread ({successful_runs}/{num_runs} successful)')
        ax.set_xlabel('Distance (m)')
        ax.set_ylabel('Height (m)')
        ax.grid(True, alpha=0.3)
        self.mc_canvas.draw()
        self.status_bar.showMessage(f"Monte Carlo complete: {num_runs} simulations ({successful_runs} successful).")
        log(f"Monte Carlo simulation completed: {num_runs} runs ({successful_runs} successful).")


