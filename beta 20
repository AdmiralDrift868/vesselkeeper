                f"  Temperature: {self.temp_input.value():.1f} °C",
                f"  Pressure: {self.pressure_input.value():.2f} hPa",
                f"  Humidity: {self.humidity_input.value():.0f} %",
                f"  Wind Speed: {self.wind_speed_input.value():.1f} m/s",
                f"  Wind Angle: {self.wind_angle_input.value()}°",
                f"  Coriolis Effect: {'On' if self.coriolis_check.isChecked() else 'Off'}",
            ])
            if self.coriolis_check.isChecked():
                summary_lines.append(f"    Latitude: {self.latitude_input.value():.2f}°")

            summary_lines.extend([
                "",
                "RESULTS:",
                f"  Maximum Height: {max_height:.2f} m (at {self.trajectory[max_height_idx][0]:.2f} m downrange)",
                f"  Total Distance: {distance:.2f} m",
                f"  Flight Time: {flight_time:.3f} s",
                f"  Impact Velocity: {impact_velocity:.2f} m/s",
                f"  Impact Angle: {impact_angle_deg:.2f}°",
                f"  Impact Energy: {impact_energy:.2f} J",
            ])

            self.summary_text.setPlainText("\n".join(summary_lines))

            # Update detailed data table-style in text
            data_header = f"{'Time (s)':<10} {'X (m)':<12} {'Y (m)':<12} {'Vx (m/s)':<12} {'Vy (m/s)':<12} {'V (m/s)':<12}\n"
            data_lines = [data_header]
            data_lines.append("-" * len(data_header) + "\n")
            # Show every Nth point or a fixed number of points for readability
            num_points = len(self.trajectory)
