    # --- Validation and Calculation ---
    def validate_inputs(self) -> bool:
        if self.mass_input.value() <= 0:
            QMessageBox.warning(self, "Invalid Input", "Mass must be positive")
            return False
        if self.diam_input.value() <= 0:
            QMessageBox.warning(self, "Invalid Input", "Diameter must be positive")
            return False
        if self.velocity_input.value() <= 0:
            QMessageBox.warning(self, "Invalid Input", "Muzzle velocity must be positive")
            return False
        if self.type_combo.currentText().lower() == 'rocket':
            if self.burn_time_input.value() < 0:
                QMessageBox.warning(self, "Invalid Input", "Burn time cannot be negative")
                return False
            initial_mass_g = self.initial_mass_input.value()
            final_mass_g = self.mass_input.value()
            if initial_mass_g < final_mass_g:
                QMessageBox.warning(self, "Invalid Input", "Initial mass must be greater than or equal to final mass for rockets.")
                return False
        return True

    def calculate_trajectory(self):
        if not self.validate_inputs():
            return
        self.calculate_btn.setEnabled(False)
        self.calculate_btn.setText("Calculating...")
        QApplication.processEvents() # Force UI update

        # Prepare parameters (convert UI units to base units)
        params = {
            "mass": self.mass_input.value() / 1000,  # g to kg
            "diameter": self.diam_input.value() / 1000,  # mm to m
            "drag_model": self.drag_model_combo.currentText(),
            "velocity": self.velocity_input.value(),
            "angle": self.angle_input.value(),
            "altitude": self.altitude_input.value(),
            "temperature": self.temp_input.value(),
            "pressure": self.pressure_input.value(),
            "humidity": self.humidity_input.value(),
            "wind_speed": self.wind_speed_input.value(),
            "wind_angle": self.wind_angle_input.value(),
            "coriolis": self.coriolis_check.isChecked(),
            "latitude": self.latitude_input.value()
        }

        # Add rocket-specific parameters if needed
        if self.type_combo.currentText().lower() == "rocket":
             params["initial_mass"] = self.initial_mass_input.value() / 1000 # g to kg
             params["burn_time"] = self.burn_time_input.value()
             params["thrust_curve"] = {0: self.thrust_input.value()} # Simplified
             params["projectile_type"] = "rocket"
        elif self.type_combo.currentText().lower() == "mortar":
             params["projectile_type"] = "mortar"
        else: # Bullet
             params["projectile_type"] = "bullet"

        # Store previous trajectory for comparison *before* calculating new one
        # Store a copy of the *parameters* used as well, for better context
        if self.trajectory is not None:
            # Make a deep copy of params to store
            import copy
            stored_params = copy.deepcopy(params)
            self.previous_trajectories.append((self.trajectory, stored_params))
            if len(self.previous_trajectories) > 5:  # Keep last 5
                self.previous_trajectories.pop(0)

        # Create and start thread
        self.calc_thread = CalculationThread(self, params)
        self.calc_thread.finished.connect(self.on_calculation_complete)
        self.calc_thread.error.connect(self.on_calculation_error)
        self.calc_thread.start()

    def on_calculation_complete(self, trajectory: Optional[List[Tuple[float, float, float, float, float, float]]]):
        self.calculate_btn.setEnabled(True)
        self.calculate_btn.setText("Calculate Trajectory")
        if trajectory is not None and len(trajectory) > 0:
            self.trajectory = trajectory
            self.update_results()
            self.plot_trajectory()
            self.status_bar.showMessage("Trajectory calculated successfully")
            log("Trajectory calculation completed successfully.")
        else:
            self.trajectory = None # Explicitly set to None
            self.summary_text.setPlainText("Calculation completed, but no trajectory data was generated (e.g., projectile impacted immediately).")
            self.data_text.setPlainText("")
            self.plot_trajectory() # Clear plot
            QMessageBox.warning(self, "Warning", "Calculation completed, but no trajectory data was generated (e.g., projectile impacted immediately).")
            self.status_bar.showMessage("Calculation completed with no data")
            log("Trajectory calculation completed, but generated no data points.")

    def on_calculation_error(self, error_msg: str):
        self.calculate_btn.setEnabled(True)
        self.calculate_btn.setText("Calculate Trajectory")
        self.trajectory = None
        self.summary_text.setPlainText(f"Error during calculation:\n{error_msg}")
        self.data_text.setPlainText("")
        self.plot_trajectory() # Clear plot on error
        QMessageBox.critical(self, "Error", f"Calculation failed:\n{error_msg}")
        self.status_bar.showMessage(f"Error: {error_msg}")
        log(f"Trajectory calculation failed: {error_msg}", "error")

    def _calculate_trajectory(self, mass: float, diameter: float, drag_model: str, velocity: float, angle: float,
                            altitude: float, temperature: float, pressure: float, humidity: float,
                            wind_speed: float, wind_angle: float, coriolis: bool, latitude: float,
                            projectile_type: str = 'bullet',
                            initial_mass: Optional[float] = None,
                            burn_time: float = 0,
                            thrust_curve: Optional[Dict[float, float]] = None,
                            max_time: float = 120, # Increased default max time
                            max_time_step: float = 0.1, min_time_step: float = 0.001) -> List[Tuple[float, float, float, float, float, float]]:
        """Enhanced RK4 trajectory calculation with rocket/mortar support"""
        log(f"Starting trajectory calculation for {projectile_type}...")
        try:
            # Initialize projectile and environment
            proj_kwargs = {
                "mass": mass,
                "diameter": diameter,
                "drag_model": drag_model,
                "velocity": velocity,
                "projectile_type": projectile_type,
                "custom_drag_curve": self.custom_drag_curve
            }
            if projectile_type == 'rocket':
                proj_kwargs["initial_mass"] = initial_mass if initial_mass is not None else mass
                proj_kwargs["burn_time"] = burn_time
                proj_kwargs["thrust_curve"] = thrust_curve

            projectile = Projectile(**proj_kwargs)

            environment = Environment(
                altitude=altitude,
                temperature=temperature,
                pressure=pressure,
                humidity=humidity,
                wind_speed=wind_speed,
                wind_angle=wind_angle,
                coriolis=coriolis,
                latitude=latitude
            )

            angle_rad = math.radians(angle)
            wind_x = environment.wind_speed * math.cos(math.radians(environment.wind_angle))
            wind_y = environment.wind_speed * math.sin(math.radians(environment.wind_angle))

            # Initial state: [x, y, vx, vy]
            state = [0.0, 0.0,
                    velocity * math.cos(angle_rad),
                    velocity * math.sin(angle_rad)]
            trajectory = []
            time = 0.0

            def derivative(s: List[float], t: float) -> List[float]:
                x, y, vx, vy = s
                v_rel_x = vx - wind_x
                v_rel_y = vy - wind_y
                v_rel = math.hypot(v_rel_x, v_rel_y)

                if v_rel <= 0.0: # Avoid division by zero
                    drag_force = 0.0
                    ax_drag = 0.0
                    ay_drag = 0.0
                else:
                    # Get velocity-dependent drag coefficient
                    drag_coeff = projectile.drag_coefficient(v_rel)
                    drag_force = 0.5 * environment.air_density * v_rel**2 * drag_coeff * projectile.area
                    # Acceleration components due to drag
                    ax_drag = -(drag_force * v_rel_x) / (projectile.get_mass(t) * v_rel)
                    ay_drag = -(drag_force * v_rel_y) / (projectile.get_mass(t) * v_rel)

                # Gravity
                ay_gravity = -GRAVITY

                # Total acceleration
                ax = ax_drag
                ay = ay_gravity + ay_drag

                # Add thrust if rocket is still burning
                if projectile.projectile_type == 'rocket' and t < projectile.burn_time and projectile.get_thrust(t) > 0:
                    thrust = projectile.get_thrust(t)
                    # Thrust angle follows velocity vector (or initial angle for t=0)
                    if t == 0 or (vx == 0 and vy == 0):
                         thrust_angle_rad = angle_rad
                    else:
                         thrust_angle_rad = math.atan2(vy, vx)

                    ax_thrust = (thrust * math.cos(thrust_angle_rad)) / projectile.get_mass(t)
                    ay_thrust = (thrust * math.sin(thrust_angle_rad)) / projectile.get_mass(t)
                    ax += ax_thrust
                    ay += ay_thrust
                    # log(f"Time {t:.3f}s: Thrust={thrust:.1f}N, Angle={math.degrees(thrust_angle_rad):.2f}°, Accel=(x:{ax_thrust:.2f}, y:{ay_thrust:.2f})") # Debug

                # Coriolis effect (simplified)
                if environment.coriolis:
                    coriolis_param = 2 * EARTH_ROTATION_RATE * math.sin(math.radians(environment.latitude))
                    # Coriolis acceleration: -2 * Omega x v
                    # For horizontal motion (x,y plane) and vertical rotation axis (z):
                    # ax_coriolis = 2 * Omega * sin(lat) * vy
                    # ay_coriolis = -2 * Omega * sin(lat) * vx
                    ax_coriolis = coriolis_param * vy
                    ay_coriolis = -coriolis_param * vx
                    ax += ax_coriolis
                    ay += ay_coriolis
                    # log(f"Time {t:.3f}s: Coriolis Accel=(x:{ax_coriolis:.5f}, y:{ay_coriolis:.5f})") # Debug

                return [vx, vy, ax, ay]

            # Save initial point
            initial_speed = math.hypot(state[2], state[3])
            trajectory.append((state[0], state[1], time, state[2], state[3], initial_speed))

            # RK4 integration with adaptive step size
            while state[1] >= 0 and time < max_time: # Continue while above ground and within time limit
                # Adaptive step size based on velocity (faster when moving fast)
                current_vel = math.hypot(state[2], state[3])
                # Scale time step: smaller steps at high velocity or near apex/impact
                # This is a heuristic. More sophisticated methods exist.
                time_step = max(min_time_step,
                              min(max_time_step,
                                  max_time_step * (300 / max(50, current_vel)))) # Example scaling

                # Ensure we don't overshoot the ground
                if state[1] + state[3] * time_step < 0: # Simple prediction
                     time_step = max(min_time_step, -state[1] / state[3]) if state[3] < 0 else time_step

                # RK4 integration steps
                k1 = derivative(state, time)
                k2_state = [s + 0.5 * time_step * k for s, k in zip(state, k1)]
                k2 = derivative(k2_state, time + 0.5*time_step)
                k3_state = [s + 0.5 * time_step * k for s, k in zip(state, k2)]
                k3 = derivative(k3_state, time + 0.5*time_step)
                k4_state = [s + time_step * k for s, k in zip(state, k3)]
                k4 = derivative(k4_state, time + time_step)

                # Update state
                for i in range(4):
                    state[i] += (time_step / 6.0) * (k1[i] + 2*k2[i] + 2*k3[i] + k4[i])
                time += time_step

                # Save point
                current_speed = math.hypot(state[2], state[3])
                trajectory.append((state[0], state[1], time, state[2], state[3], current_speed))

            # Ensure the last point is exactly at y=0 if it went below
            if len(trajectory) > 1 and trajectory[-1][1] < 0:
                 # Linear interpolation to find impact point
                 p1 = trajectory[-2]
                 p2 = trajectory[-1]
                 if p1[1] > 0 and p2[1] < 0:
                      dy = p1[1] - p2[1]
                      if dy > 0: # Avoid division by zero
                           t_interp = p1[1] / dy
                           x_impact = p1[0] + t_interp * (p2[0] - p1[0])
                           y_impact = 0.0
                           t_impact = p1[2] + t_interp * (p2[2] - p1[2])
                           vx_impact = p1[3] + t_interp * (p2[3] - p1[3])
                           vy_impact = p1[4] + t_interp * (p2[4] - p1[4])
                           v_impact = math.hypot(vx_impact, vy_impact)
                           # Replace last point
                           trajectory[-1] = (x_impact, y_impact, t_impact, vx_impact, vy_impact, v_impact)
                 else:
                      # Fallback: just set y to 0
                      last = list(trajectory[-1])
                      last[1] = 0.0
                      trajectory[-1] = tuple(last)

            log(f"Trajectory calculation finished. Points generated: {len(trajectory)}")
            return trajectory

        except Exception as e:
            log(f"Error during internal trajectory calculation: {e}", "error")
            raise # Re-raise to be caught by the thread


    def update_results(self):
        if not self.trajectory or len(self.trajectory) == 0:
            self.summary_text.setPlainText("No trajectory data available")
            self.data_text.setPlainText("")
            return

        try:
            # Calculate summary metrics
            y_coords = [p[1] for p in self.trajectory]
            max_height = max(y_coords)
            max_height_idx = y_coords.index(max_height)
            distance = self.trajectory[-1][0]
            flight_time = self.trajectory[-1][2]
            impact_velocity = self.trajectory[-1][5] # Total velocity
            impact_vx = self.trajectory[-1][3]
            impact_vy = self.trajectory[-1][4]
            impact_angle_rad = math.atan2(impact_vy, impact_vx) if impact_vx != 0 else (math.pi / 2 if impact_vy > 0 else -math.pi / 2)
            impact_angle_deg = math.degrees(impact_angle_rad)

            mass_kg = self.mass_input.value() / 1000.0 # Convert g to kg
            impact_energy = 0.5 * mass_kg * impact_velocity**2

            # Get current input values for summary
            proj_type = self.type_combo.currentText()
            mass_g = self.mass_input.value()
            diam_mm = self.diam_input.value()
            drag_model = self.drag_model_combo.currentText()
            muzzle_vel = self.velocity_input.value()
            launch_angle = self.angle_input.value()

            # Build summary string
            summary_lines = [
                "PROJECTILE:",
                f"  Type: {proj_type}",
                f"  Mass: {mass_g:.2f} g",
                f"  Diameter: {diam_mm:.2f} mm",
                f"  Drag Model: {drag_model}",
                f"  Muzzle Velocity: {muzzle_vel:.1f} m/s",
                f"  Launch Angle: {launch_angle:.2f}°",
            ]
            if proj_type.lower() == "rocket":
                summary_lines.append(f"  Burn Time: {self.burn_time_input.value():.2f} s")
                summary_lines.append(f"  Avg Thrust: {self.thrust_input.value():.0f} N")
                summary_lines.append(f"  Initial Mass: {self.initial_mass_input.value():.2f} g")

            summary_lines.extend([
                "",
