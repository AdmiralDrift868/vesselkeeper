    def plot_trajectory(self):
        if not MATPLOTLIB_AVAILABLE or not self.trajectory:
            return

        self.figure.clear()
        ax = self.figure.add_subplot(111)

        # Plot current trajectory
        if self.trajectory and len(self.trajectory) > 1:
            x = [p[0] for p in self.trajectory]
            y = [p[1] for p in self.trajectory]
            ax.plot(x, y, 'b-', linewidth=2, label='Current')

            # Mark key points on CURRENT trajectory
            if self.trajectory:
                # Impact point (last point)
                ax.plot(x[-1], y[-1], 'ro', markersize=8, label='Impact')
                # Max height point
                y_coords = [p[1] for p in self.trajectory]
                if y_coords:
                    max_idx = y_coords.index(max(y_coords))
                    ax.plot(x[max_idx], y[max_idx], 'go', markersize=8, label='Max Height')

        # Plot previous trajectories if comparison enabled
        if self.compare_check.isChecked() and self.previous_trajectories:
            for i, (traj_data, _) in enumerate(reversed(self.previous_trajectories)): # Show newest first
                if traj_data and len(traj_data) > 1:
                    x_prev = [p[0] for p in traj_data]
                    y_prev = [p[1] for p in traj_data]
