    def update_projectile_type(self, type_str: str):
        type_lower = type_str.lower()
        is_rocket = type_lower == "rocket"
        self.rocket_group.setVisible(is_rocket)
        # Update drag model options based on type
        self.drag_model_combo.blockSignals(True)
        self.drag_model_combo.clear()
        if type_lower == "bullet":
            self.drag_model_combo.addItems(['G1', 'G7', 'Custom'])
        elif type_lower == "rocket":
            self.drag_model_combo.addItems(['rocket', 'Custom'])
        elif type_lower == "mortar":
            self.drag_model_combo.addItems(['mortar', 'Custom'])
        self.drag_model_combo.blockSignals(False)

    def on_preset_change(self, preset_name: str):
        if preset_name == "Custom" or preset_name not in self.presets:
            return # Do nothing for Custom or unknown
        preset = self.presets[preset_name]

        # Load common parameters
        self.mass_input.setValue(preset.get("mass", 10) * 1000) # Convert kg to g for UI
        self.diam_input.setValue(preset.get("diameter", 7.62)) # mm
        drag_model = preset.get("drag_model", "G7")
        idx = self.drag_model_combo.findText(drag_model)
        if idx >= 0:
            self.drag_model_combo.setCurrentIndex(idx)
        self.velocity_input.setValue(preset.get("velocity", 800))
        self.angle_input.setValue(preset.get("angle", 15))

        # Set projectile type
        proj_type = preset.get("type", "bullet").capitalize()
        idx = self.type_combo.findText(proj_type)
        if idx >= 0:
            self.type_combo.setCurrentIndex(idx)
            self.update_projectile_type(proj_type) # Update UI visibility

        # Set rocket-specific parameters if applicable
        if preset.get("type") == "rocket":
            self.burn_time_input.setValue(preset.get("burn_time", 1.0))
            thrust_curve = preset.get("thrust_curve", {})
            avg_thrust = thrust_curve.get(0, 1000) # Assume first point is avg or initial
            self.thrust_input.setValue(avg_thrust)
            initial_mass_kg = preset.get("initial_mass", preset.get("mass", 10) * 1.1) # Default to 10% more
            self.initial_mass_input.setValue(initial_mass_kg * 1000) # Convert kg to g for UI

        self.status_bar.showMessage(f"Loaded preset: {preset_name}")

    def load_preset(self):
        preset_name = self.preset_combo.currentText()
        if preset_name == "Custom":
            QMessageBox.information(self, "Info", "Select a preset to load")
            return
        if preset_name in self.presets:
            self.on_preset_change(preset_name)
        else:
            QMessageBox.warning(self, "Warning", "Selected preset not found")

    def save_preset(self):
        name, ok = QInputDialog.getText(self, "Save Preset", "Preset name:")
        if ok and name:
            if name in ["Custom"]:
                QMessageBox.warning(self, "Invalid Name", "Cannot use reserved name 'Custom'.")
                return
            preset_data = {
                "mass": self.mass_input.value() / 1000, # Convert g to kg for storage
                "diameter": self.diam_input.value(), # mm
                "drag_model": self.drag_model_combo.currentText(),
                "velocity": self.velocity_input.value(),
                "angle": self.angle_input.value(),
                "type": self.type_combo.currentText().lower()
            }
            # Add rocket-specific parameters if applicable
            if self.type_combo.currentText().lower() == "rocket":
                preset_data.update({
                    "burn_time": self.burn_time_input.value(),
                    "thrust_curve": {0: self.thrust_input.value()}, # Simplified
                    "initial_mass": self.initial_mass_input.value() / 1000 # Convert g to kg
                })
            self.presets[name] = preset_data
            self.save_presets()
            self.refresh_preset_combo()
            # Set the combo to the newly saved preset
            index = self.preset_combo.findText(name)
            if index >= 0:
                self.preset_combo.setCurrentIndex(index)
            self.status_bar.showMessage(f"Preset '{name}' saved")

    def delete_preset(self):
        name = self.preset_combo.currentText()
        if name == "Custom" or name in self.default_presets:
            QMessageBox.warning(self, "Warning", "Cannot delete default or 'Custom' preset")
            return
        if name in self.presets:
            confirm = QMessageBox.question(self, "Confirm Delete",
                                         f"Delete preset '{name}'?",
                                         QMessageBox.Yes | QMessageBox.No)
            if confirm == QMessageBox.Yes:
                del self.presets[name]
                self.save_presets()
                self.refresh_preset_combo()
                # Reset to Custom or first available
                if self.preset_combo.count() > 0:
                    self.preset_combo.setCurrentIndex(0) # Should be "Custom"
                self.status_bar.showMessage(f"Preset '{name}' deleted")
        else:
            QMessageBox.warning(self, "Warning", "Selected preset not found")

    def load_custom_drag_curve(self):
        filename, _ = QFileDialog.getOpenFileName(self, "Load Custom Drag Curve CSV", "", "CSV Files (*.csv)")
        if filename:
            try:
                curve = []
                with open(filename, 'r') as csvfile:
                    reader = csv.reader(csvfile)
                    for i, row in enumerate(reader):
                        if len(row) >= 2:
                            try:
                                v = float(row[0])
                                cd = float(row[1])
                                if v >= 0 and cd >= 0: # Basic sanity check
                                    curve.append((v, cd))
                                else:
                                    log(f"Warning: Skipping invalid drag point in row {i+1}: V={v}, Cd={cd}", "warning")
                            except ValueError:
                                log(f"Warning: Skipping non-numeric row {i+1} in drag curve file.", "warning")
                                continue
                if curve:
                    self.custom_drag_curve = sorted(curve, key=lambda p: p[0]) # Ensure sorted
                    self.drag_model_combo.setCurrentText('Custom')
                    QMessageBox.information(self, "Success", f"Loaded {len(curve)} valid drag points from {os.path.basename(filename)}")
                    self.status_bar.showMessage(f"Loaded custom drag curve: {len(curve)} points")
                else:
                    QMessageBox.warning(self, "Warning", "No valid data points found in the selected file.")
                    self.status_bar.showMessage("Failed to load custom drag curve: No valid data")
            except Exception as e:
                error_msg = f"Failed to load drag curve from {filename}: {str(e)}"
                log(error_msg, "error")
                QMessageBox.critical(self, "Error", error_msg)
                self.status_bar.showMessage("Error loading custom drag curve")

