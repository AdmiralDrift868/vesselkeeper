        with self.get_cursor() as cursor:
            cursor.execute("SELECT * FROM vessels")
            rows = cursor.fetchall()
            vessels = []
            
            for row in rows:
                # Safe field access with proper error handling
                def get_safe_field(field_name, default):
                    try:
                        value = row[field_name]
                        return value if value is not None else default
                    except (KeyError, IndexError):
                        return default
                
                vessel = Vessel(
                    id=get_safe_field('id', None),
                    name=get_safe_field('name', ''),
                    vessel_type=get_safe_field('vessel_type', ''),
                    length=float(get_safe_field('length', 0.0)),
                    beam=float(get_safe_field('beam', 0.0)),
