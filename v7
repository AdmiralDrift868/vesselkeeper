class StockTransactionEditor(BaseEditor):
    def __init__(self, parent: Gtk.Window, db: ThreadSafeDatabase, item_id: int, transaction: StockTransaction = None):
        self.db = db
        self.item_id = item_id
        self.inventory_item = next((i for i in db.get_inventory_items() if i.id == item_id), None)
        if not self.inventory_item:
            show_error_dialog(parent, f"Inventory item with ID {item_id} not found.")
            self.response(Gtk.ResponseType.CANCEL)
            return
        super().__init__(parent, f"Edit Transaction for Item ID {item_id}" if transaction else f"Add Transaction for Item ID {item_id}", transaction)

    def setup_ui(self):
        super().setup_ui()
        self.item_label = Gtk.Label(label=f"Item: {self.inventory_item.name} (ID: {self.item_id})")
        self.grid.attach(self.item_label, 0, 0, 2, 1) # Span 2 columns

        self.type_combo = Gtk.ComboBoxText()
        for ttype in TransactionType:
            self.type_combo.append_text(ttype.value)
        self._add_form_field(1, "Type:", self.type_combo)

        self.quantity_entry = self._add_form_field(2, "Quantity:", Gtk.SpinButton.new_with_range(-10000, 10000, 1))
        self.date_entry = self._add_form_field(3, "Date:", DatePickerEntry())
        self.reference_entry = self._add_form_field(4, "Reference:", Gtk.Entry())

        # Notes TextView
        notes_label = Gtk.Label(label="Notes:")
        self.grid.attach(notes_label, 0, 5, 1, 1)
        self.notes_textview = Gtk.TextView()
        self.notes_textview.set_wrap_mode(Gtk.WrapMode.WORD)
        scrolled_window = Gtk.ScrolledWindow()
        scrolled_window.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scrolled_window.add(self.notes_textview)
        self.grid.attach(scrolled_window, 1, 5, 1, 1)

    def populate_fields(self):
        for i, ttype in enumerate(TransactionType):
            if ttype == self.item.transaction_type:
                self.type_combo.set_active(i)
                break
        self.quantity_entry.set_value(self.item.quantity)
        self.date_entry.set_text(self.item.date or "")
        self.reference_entry.set_text(self.item.reference or "")

        buffer = self.notes_textview.get_buffer()
        buffer.set_text(self.item.notes or "")

    def validate(self) -> bool:
        quantity = self.quantity_entry.get_value_as_int()
        
        # Allow zero quantity only for ADJUSTMENT type with notes
        if quantity == 0:
            transaction_type_index = self.type_combo.get_active()
            if transaction_type_index >= 0:
                transaction_type = list(TransactionType)[transaction_type_index]
                if transaction_type == TransactionType.ADJUSTMENT:
                    buffer = self.notes_textview.get_buffer()
                    start_iter = buffer.get_start_iter()
                    end_iter = buffer.get_end_iter()
                    notes = buffer.get_text(start_iter, end_iter, False).strip()
                    if not notes:
                        show_error_dialog(self, "Adjustments with zero quantity require notes explaining the reason.")
                        self.notes_textview.grab_focus()
                        return False
                    return True  # Allow zero quantity adjustment with notes
                else:
                    show_error_dialog(self, "Quantity cannot be zero for INBOUND or OUTBOUND transactions.")
                    self.quantity_entry.grab_focus()
                    return False
                
        if not self.date_entry.validate_date(allow_empty=False):
            show_error_dialog(self, "Date format is invalid. Please use YYYY-MM-DD.")
            self.date_entry.grab_focus()
            return False
            
        return True

    def get_values(self) -> StockTransaction:
        buffer = self.notes_textview.get_buffer()
        start_iter = buffer.get_start_iter()
        end_iter = buffer.get_end_iter()
        notes = buffer.get_text(start_iter, end_iter, False).strip()

        transaction = StockTransaction(
            id=self.item.id if self.item else None,
            item_id=self.item_id,
            transaction_type=TransactionType(list(TransactionType)[self.type_combo.get_active()].value),
            quantity=self.quantity_entry.get_value_as_int(),
            date=self.date_entry.get_text(),
            reference=self.reference_entry.get_text().strip(),
            notes=notes
        )
        return transaction

    def _add_form_field(self, row: int, label_text: str, widget: Gtk.Widget):
        label = Gtk.Label(label=label_text)
        label.set_xalign(0)
        self.grid.attach(label, 0, row, 1, 1)
        self.grid.attach(widget, 1, row, 1, 1)
        return widget

