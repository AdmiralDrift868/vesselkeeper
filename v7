                vessel.home_port, vessel.gross_tonnage, vessel.image_path, vessel.id
            ))

    def delete_vessel(self, vessel_id: int) -> bool:
        """Delete vessel with referential integrity checks."""
        with self.get_cursor() as cursor:
            try:
                # Check for references in maintenance_tasks and trip_logs
                cursor.execute("SELECT COUNT(*) FROM maintenance_tasks WHERE vessel_id = ?", (vessel_id,))
                task_count = cursor.fetchone()[0]
                
                cursor.execute("SELECT COUNT(*) FROM trip_logs WHERE vessel_id = ?", (vessel_id,))
                trip_count = cursor.fetchone()[0]
                
                cursor.execute("SELECT COUNT(*) FROM performance_metrics WHERE vessel_id = ?", (vessel_id,))
                metric_count = cursor.fetchone()[0]
                
                if task_count > 0 or trip_count > 0 or metric_count > 0:
                    logger.warning(f"Cannot delete vessel {vessel_id}: has {task_count} tasks, {trip_count} trips, {metric_count} metrics")
                    return False
                
                cursor.execute("DELETE FROM vessels WHERE id = ?", (vessel_id,))
                logger.info(f"Vessel {vessel_id} deleted successfully")
                return True
                
            except Exception as e:
                logger.error(f"Error deleting vessel {vessel_id}: {e}")
                return False

