            rows = cursor.fetchall()
            templates = []
            for row in rows:
                # Deserialize PartRequirement objects
                parts_required = None
                if row['parts_required'] and row['parts_required'] != 'null':
                    try:
                        parts_data = json.loads(row['parts_required'])
                        parts_required = [PartRequirement(item_id=pr['item_id'], quantity=pr.get('quantity', 1)) 
                                        for pr in parts_data]
                    except (json.JSONDecodeError, KeyError) as e:
                        logger.warning(f"Error deserializing parts_required for template {row['id']}: {e}")
                        parts_required = None
                        
                template = MaintenanceTemplate(
                    id=row['id'],
                    name=row['name'] or '',
                    system=row['system'] or '',
                    task_name=row['task_name'] or '',
                    interval_type=IntervalType(row['interval_type']) if row['interval_type'] else IntervalType.HOURS,
                    interval_value=int(row['interval_value']) if row['interval_value'] is not None else 0,
                    priority=Priority(row['priority']) if row['priority'] else Priority.MEDIUM,
                    parts_required=parts_required,
                    instructions=row['instructions'] or '',
                    labor_cost=float(row['labor_cost']) if row['labor_cost'] is not None else 0.0,
                    estimated_duration_hours=float(row['estimated_duration_hours']) if row['estimated_duration_hours'] is not None else 0.0,
