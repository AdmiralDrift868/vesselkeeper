    def _on_interval_type_changed(self, combo):
        active_index = combo.get_active()
        if active_index >= 0:
            interval_type = list(IntervalType)[active_index]
            
            # Define which interval types use date-based vs hours-based tracking
            date_based_types = [IntervalType.DAYS, IntervalType.CALENDAR_MONTHS]
            hours_based_types = [IntervalType.HOURS]
            operating_based_types = [IntervalType.OPERATING_MONTHS]  # Could use both
            
            is_date_based = interval_type in date_based_types
            is_hours_based = interval_type in hours_based_types
            is_operating_based = interval_type in operating_based_types
            
            # Enable appropriate fields
            self.last_completed_entry.set_sensitive(is_date_based or is_operating_based)
            self.next_due_entry.set_sensitive(is_date_based or is_operating_based)
            self.last_hours_entry.set_sensitive(is_hours_based or is_operating_based)
            
            # Show informational tooltip for operating months
            if is_operating_based:
                self.last_completed_entry.set_tooltip_text("Operating months use both date completion and engine hours")
                self.last_hours_entry.set_tooltip_text("Operating months use both date completion and engine hours")
            else:
                self.last_completed_entry.set_tooltip_text("")
                self.last_hours_entry.set_tooltip_text("")

    def populate_fields(self):
        for i, vessel in enumerate(self.vessels):
            if vessel.id == self.item.vessel_id:
                self.vessel_combo.set_active(i)
                break
        for i, system in enumerate(SYSTEM_CATEGORIES):
            if system == (self.item.system or ""):
                self.system_combo.set_active(i + 1) # +1 for "None"
                break
        self.task_name_entry.set_text(self.item.task_name or "")

        # Set interval type in combo
        for i, interval_type in enumerate(IntervalType):
            if interval_type == self.item.interval_type:
                self.interval_type_combo.set_active(i)
                break
        self.interval_value_entry.set_value(self.item.interval_value)
        self.last_completed_entry.set_text(self.item.last_completed or "")
        self.last_hours_entry.set_value(self.item.last_hours)
        self.next_due_entry.set_text(self.item.next_due or "")

        # Set priority in combo
        for i, priority in enumerate(Priority):
            if priority == self.item.priority:
                self.priority_combo.set_active(i)
                break

        # Set status in combo
        for i, status in enumerate(TaskStatus):
            if status == self.item.status:
                self.status_combo.set_active(i)
                break

        self.assigned_to_entry.set_text(self.item.assigned_to or "")
        self.estimated_duration_entry.set_value(self.item.estimated_duration_hours)
        self.labor_cost_entry.set_value(self.item.labor_cost)

        buffer = self.instructions_textview.get_buffer()
        buffer.set_text(self.item.instructions or "")

        buffer_notes = self.notes_textview.get_buffer()
        buffer_notes.set_text(self.item.notes or "")

        self.attachment_widget.set_attachments(self.item.attachments)

    def validate(self) -> bool:
        if not self.task_name_entry.get_text().strip():
            show_error_dialog(self, "Task name is required.")
            self.task_name_entry.grab_focus()
            return False
        if self.vessel_combo.get_active() == -1:
            show_error_dialog(self, "Please select a vessel.")
            self.vessel_combo.grab_focus()
            return False
        if not self.last_completed_entry.validate_date(allow_empty=True):
            show_error_dialog(self, "Last Completed date format is invalid. Please use YYYY-MM-DD.")
            self.last_completed_entry.grab_focus()
            return False
        if (self.next_due_entry.get_sensitive() and
            self.next_due_entry.get_text() and
            not self.next_due_entry.validate_date(allow_empty=True)):
            show_error_dialog(self, "Next Due date format is invalid. Please use YYYY-MM-DD.")
            self.next_due_entry.grab_focus()
            return False

        last_completed = self.last_completed_entry.get_text()
        next_due = self.next_due_entry.get_text()
        if (last_completed and next_due and
            self.next_due_entry.get_sensitive()): # Only check if date fields are relevant
            try:
                last_date = datetime.datetime.strptime(last_completed, "%Y-%m-%d").date()
                next_date = datetime.datetime.strptime(next_due, "%Y-%m-%d").date()
                # Allow next_due to be equal to or after last_completed
                # This is valid for maintenance scheduling
                if next_date < last_date:
                    show_error_dialog(self, "Next Due date cannot be before Last Completed date.")
                    self.next_due_entry.grab_focus()
                    return False
            except ValueError:
                pass  # Dates already validated above
        return True

    def get_values(self) -> MaintenanceTask:
        buffer = self.instructions_textview.get_buffer()
        start_iter = buffer.get_start_iter()
        end_iter = buffer.get_end_iter()
        instructions = buffer.get_text(start_iter, end_iter, False).strip()

        buffer_notes = self.notes_textview.get_buffer()
        start_iter_notes = buffer_notes.get_start_iter()
        end_iter_notes = buffer_notes.get_end_iter()
        notes = buffer_notes.get_text(start_iter_notes, end_iter_notes, False).strip()

        # Get selected vessel
        vessel_index = self.vessel_combo.get_active()
        vessel_id = self.vessels[vessel_index].id if vessel_index >= 0 else 0

        # Get selected interval type
        interval_index = self.interval_type_combo.get_active()
        selected_interval_type = list(IntervalType)[interval_index] if interval_index >= 0 else IntervalType.HOURS

        # Get selected priority
        priority_index = self.priority_combo.get_active()
        selected_priority = list(Priority)[priority_index] if priority_index >= 0 else Priority.MEDIUM

        # Get selected status
        status_index = self.status_combo.get_active()
        selected_status = list(TaskStatus)[status_index] if status_index >= 0 else TaskStatus.ON_SCHEDULE

        # Get selected system
        system_index = self.system_combo.get_active()
        system = SYSTEM_CATEGORIES[system_index - 1] if 0 < system_index < len(SYSTEM_CATEGORIES) + 1 else ""

        task = MaintenanceTask(
            id=self.item.id if self.item else None,
            vessel_id=vessel_id,
            system=system,
            task_name=self.task_name_entry.get_text().strip(),
            interval_type=selected_interval_type,
            interval_value=int(self.interval_value_entry.get_value()),
            last_completed=self.last_completed_entry.get_text(),
            last_hours=self.last_hours_entry.get_value(),
            next_due=self.next_due_entry.get_text(),
            priority=selected_priority,
            status=selected_status,
            assigned_to=self.assigned_to_entry.get_text().strip(),
            estimated_duration_hours=self.estimated_duration_entry.get_value(),
            labor_cost=self.labor_cost_entry.get_value(),
            instructions=instructions,
            notes=notes,
            attachments=self.attachment_widget.get_attachments()
        )
        return task

    def _add_form_field(self, row: int, label_text: str, widget: Gtk.Widget):
        label = Gtk.Label(label=label_text)
        label.set_xalign(0)
        self.grid.attach(label, 0, row, 1, 1)
        self.grid.attach(widget, 1, row, 1, 1)
        return widget

