@dataclass
class MaintenanceTask:
    id: Optional[int] = None
    vessel_id: int = 0
    vessel_name: str = "" # For display purpose
    system: str = ""
    task_name: str = ""
    template_id: Optional[int] = None
    interval_type: IntervalType = IntervalType.HOURS
    interval_value: int = 0
    last_completed: str = "" # YYYY-MM-DD
    last_hours: float = 0.0
    next_due: str = "" # YYYY-MM-DD or hours depending on interval_type
    priority: Priority = Priority.MEDIUM
    parts_required: Optional[List[PartRequirement]] = None # List of PartRequirement objects
    instructions: str = ""
    labor_cost: float = 0.0
    total_parts_cost: float = 0.0 # Calculated from parts
    total_job_cost: float = 0.0 # labor_cost + total_parts_cost
    # Additional fields for expansion
    estimated_duration_hours: float = 0.0
    actual_duration_hours: float = 0.0
    status: TaskStatus = TaskStatus.ON_SCHEDULE # Default status
    assigned_to: str = ""
    notes: str = ""
    attachments: List[str] = field(default_factory=list)

    def get_status(self, vessel_engine_hours: float, due_soon_threshold: int = 10, due_soon_days: int = 7) -> TaskStatus:
        """Calculate task status with configurable thresholds."""
        today = datetime.date.today()
        
        try:
            last_completed_date = datetime.datetime.strptime(self.last_completed, "%Y-%m-%d").date() if self.last_completed else None
            next_due_date = datetime.datetime.strptime(self.next_due, "%Y-%m-%d").date() if self.next_due and self.interval_type in [IntervalType.DAYS, IntervalType.CALENDAR_MONTHS, IntervalType.OPERATING_MONTHS] else None
        except ValueError:
            logger.warning(f"Invalid date format for task {self.task_name}. Assuming 'On Schedule'.")
            return TaskStatus.ON_SCHEDULE

        # Handle completed tasks
        if self.status == TaskStatus.COMPLETED:
            return TaskStatus.COMPLETED

        if self.interval_type == IntervalType.HOURS:
            # For hour-based intervals
            if not self.last_hours and not self.last_completed:
                # New task with no history
                return TaskStatus.ON_SCHEDULE
            
            target_hours = (self.last_hours or 0) + self.interval_value
            
            if vessel_engine_hours > target_hours:
                return TaskStatus.OVERDUE
            elif vessel_engine_hours + due_soon_threshold >= target_hours:
                return TaskStatus.DUE_SOON
            else:
                return TaskStatus.ON_SCHEDULE
                
        elif self.interval_type == IntervalType.OPERATING_MONTHS:
            # Operating months need vessel usage data - simplified to calendar for now
            if not next_due_date:
                return TaskStatus.ON_SCHEDULE
            if today > next_due_date:
                return TaskStatus.OVERDUE
            elif (next_due_date - today).days <= due_soon_days:
                return TaskStatus.DUE_SOON
            else:
                return TaskStatus.ON_SCHEDULE
                
        else:  # Calendar-based intervals (DAYS, CALENDAR_MONTHS)
            if not next_due_date:
                return TaskStatus.ON_SCHEDULE
            if today > next_due_date:
                return TaskStatus.OVERDUE
            elif (next_due_date - today).days <= due_soon_days:
                return TaskStatus.DUE_SOON
            else:
                return TaskStatus.ON_SCHEDULE

    def __post_init__(self):
        if self.last_hours < 0: self.last_hours = 0.0
        if self.labor_cost < 0: self.labor_cost = 0.0
        if self.total_parts_cost < 0: self.total_parts_cost = 0.0
        if self.total_job_cost < 0: self.total_job_cost = 0.0
        if self.estimated_duration_hours < 0: self.estimated_duration_hours = 0.0
        if self.actual_duration_hours < 0: self.actual_duration_hours = 0.0
        # Ensure string fields are never None
        self.vessel_name = self.vessel_name or ""
        self.system = self.system or ""
        self.task_name = self.task_name or ""
        self.instructions = self.instructions or ""
        self.assigned_to = self.assigned_to or ""
        self.notes = self.notes or ""

