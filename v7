    def refresh_views(self):
        """Refresh all data views"""
        # Refresh vessels
        self.vessels_store.clear()
        vessels = self.db.get_vessels()
        for vessel in vessels:
            self.vessels_store.append([
                vessel.id, vessel.name, vessel.vessel_type, vessel.length,
                f"{vessel.engine_make} {vessel.engine_model}", vessel.current_location
            ])

        # Refresh inventory
        self.inventory_store.clear()
        items = self.db.get_inventory_items()
        for item in items:
            self.inventory_store.append([
                item.id, item.name, item.part_number, item.category,
                item.current_stock, item.minimum_stock, item.unit_cost, item.location
            ])

        # Refresh maintenance tasks
        self.maintenance_store.clear()
        tasks = self.db.get_maintenance_tasks()
        for task in tasks:
            vessel = next((v for v in vessels if v.id == task.vessel_id), None)
            vessel_name = vessel.name if vessel else "Unknown"
            
            self.maintenance_store.append([
                task.id, vessel_name, task.system, task.task_name,
                task.next_due, task.status.value, task.priority.value,
                task.assigned_to, task.total_job_cost
            ])

        # Refresh dashboard
        self._update_dashboard()

    def _update_dashboard(self):
        """Update dashboard with current statistics"""
        vessels = self.db.get_vessels()
        items = self.db.get_inventory_items()
        tasks = self.db.get_maintenance_tasks()
        suppliers = self.db.get_suppliers()
        trip_logs = self.db.get_trip_logs()

        # Update summary cards
        overdue_count = sum(1 for t in tasks if t.status == TaskStatus.OVERDUE)
        due_soon_count = sum(1 for t in tasks if t.status == TaskStatus.DUE_SOON)
        on_schedule_count = sum(1 for t in tasks if t.status == TaskStatus.ON_SCHEDULE)
        completed_count = sum(1 for t in tasks if t.status == TaskStatus.COMPLETED)

        # Update alerts
        self.alert_store.clear()
        
        # Check for overdue tasks
        for task in tasks:
            if task.status == TaskStatus.OVERDUE:
                self.alert_store.append(["Maintenance", f"Overdue: {task.task_name}", "High"])
        
        # Check for low stock
        for item in items:
            if item.current_stock <= item.minimum_stock and item.current_stock > 0:
                self.alert_store.append(["Inventory", f"Low stock: {item.name}", "Medium"])
            elif item.current_stock == 0:
                self.alert_store.append(["Inventory", f"Out of stock: {item.name}", "High"])

        # Update upcoming tasks
        self.upcoming_store.clear()
        upcoming_tasks = [t for t in tasks if t.status in [TaskStatus.OVERDUE, TaskStatus.DUE_SOON, TaskStatus.ON_SCHEDULE]]
        upcoming_tasks.sort(key=lambda x: x.next_due if x.next_due else "9999-99-99")
        
        for task in upcoming_tasks[:10]:  # Show top 10
            vessel = next((v for v in vessels if v.id == task.vessel_id), None)
            vessel_name = vessel.name if vessel else "Unknown"
            self.upcoming_store.append([
                task.task_name, vessel_name, task.system, 
                task.next_due, task.status.value
            ])

    def on_show_low_stock(self, button):
        """Show low stock items"""
        items = self.db.get_inventory_items()
        low_stock_items = [item for item in items if item.current_stock <= item.minimum_stock]
        
        if low_stock_items:
            dialog = Gtk.Dialog(title="Low Stock Items", parent=self, flags=0)
            dialog.add_buttons(Gtk.STOCK_OK, Gtk.ResponseType.OK)
            dialog.set_default_size(400, 300)
            
            content_area = dialog.get_content_area()
            store = Gtk.ListStore(str, str, int, int)  # Name, Part#, Current, Min
            
            for item in low_stock_items:
                store.append([item.name, item.part_number, item.current_stock, item.minimum_stock])
            
            treeview = Gtk.TreeView(model=store)
            columns = [("Name", 0), ("Part Number", 1), ("Current Stock", 2), ("Min Stock", 3)]
            
            for i, (title, col_id) in enumerate(columns):
                renderer = Gtk.CellRendererText()
                column = Gtk.TreeViewColumn(title, renderer, text=col_id)
                treeview.append_column(column)
            
            scrolled = Gtk.ScrolledWindow()
            scrolled.add(treeview)
            content_area.add(scrolled)
            
            dialog.show_all()
            dialog.run()
            dialog.destroy()
        else:
            show_info_dialog(self, "No low stock items found.")

    def on_stock_transaction(self, button):
        selection = self.inventory_tree.get_selection()
        model, tree_iter = selection.get_selected()
        if tree_iter is not None:
            item_id = model[tree_iter][0]
            dialog = StockTransactionEditor(self, self.db, item_id)
            response = dialog.run()
            if response == Gtk.ResponseType.OK:
                transaction = dialog.get_values()
                self.db.add_stock_transaction(transaction)
                
                # Update inventory item stock
                items = self.db.get_inventory_items()
                item = next((i for i in items if i.id == item_id), None)
                if item:
                    if transaction.transaction_type == TransactionType.INBOUND:
                        item.current_stock += transaction.quantity
                    elif transaction.transaction_type == TransactionType.OUTBOUND:
                        item.current_stock -= transaction.quantity
                    # ADJUSTMENT type sets the stock to the specified quantity
                    elif transaction.transaction_type == TransactionType.ADJUSTMENT:
                        item.current_stock = transaction.quantity
                    
                    self.db.update_inventory_item(item)
                    self.refresh_views()
            dialog.destroy()
        else:
            show_error_dialog(self, "Please select an inventory item for the transaction.")

