def show_confirmation_dialog(parent, message) -> bool:
    dialog = Gtk.MessageDialog(
        transient_for=parent,
        flags=0,
        message_type=Gtk.MessageType.QUESTION,
        buttons=Gtk.ButtonsType.YES_NO,
        text=message,
    )
    response = dialog.run()
    dialog.destroy()
    return response == Gtk.ResponseType.YES

def _get_selected_item(tree_view: Gtk.TreeView, store: Gtk.ListStore) -> Optional[int]:
    """Helper to get the ID of the selected item in a TreeView."""
    selection = tree_view.get_selection()
    model, tree_iter = selection.get_selected()
    if tree_iter is not None:
        return model[tree_iter][0] # Assumes ID is in the first column
    return None

# --- Base Classes ---
class BaseEditor(Gtk.Dialog):
    """Base class for editing forms."""
    def __init__(self, parent: Gtk.Window, title: str, item: Any = None):
        super().__init__(parent=parent, title=title, flags=0)
        self.item = item
        self.set_default_size(400, 300)
        self.setup_ui() # Use setup_ui instead of _setup_ui
        if self.item:
            self.populate_fields() # Use populate_fields instead of _populate_fields
        self.add_buttons(
            Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
            Gtk.STOCK_SAVE, Gtk.ResponseType.OK
        )
        self.set_response_sensitive(Gtk.ResponseType.OK, True)

    def setup_ui(self):
        """Override in subclasses to set up UI elements."""
        self.grid = Gtk.Grid()
        self.grid.set_column_spacing(10)
        self.grid.set_row_spacing(5)
        self.grid.set_margin_start(10)
        self.grid.set_margin_end(10)
        self.grid.set_margin_top(10)
        self.grid.set_margin_bottom(10)
        self.get_content_area().add(self.grid)

    def populate_fields(self):
        """Override in subclasses to populate fields with existing data."""
        pass

    def validate(self) -> bool:
        """Override in subclasses to validate input."""
        return True

    def get_values(self) -> Any:
        """Override in subclasses to retrieve values from UI elements."""
        pass

    def run(self):
        result = super().run()
        if result == Gtk.ResponseType.OK and not self.validate():
            return Gtk.ResponseType.CANCEL # Re-run if validation fails
        return result

    def _add_form_field(self, row: int, label_text: str, widget: Gtk.Widget):
        """Correctly adds a label and widget to the grid."""
        label = Gtk.Label(label=label_text)
        label.set_xalign(0)  # Align label to the left
        self.grid.attach(label, 0, row, 1, 1) # Attach label to column 0
        self.grid.attach(widget, 1, row, 1, 1) # Attach widget to column 1
        return widget # Return the widget for potential further configuration, like grab_focus

class BaseListManager:
    """Base class for managing lists of items."""
    def __init__(self, db, tree_view: Gtk.TreeView, store: Gtk.ListStore, item_class):
        self.db = db
        self.tree_view = tree_view
        self.store = store
        self.item_class = item_class

    def update_list(self):
        """Override in subclasses to load data into the store."""
        self.store.clear()
        items = self.get_items_from_db() # Must be implemented by subclass
        for item in items:
            self.store.append(self.format_row(item)) # Must be implemented by subclass

    def get_items_from_db(self):
        """Override in subclasses to fetch items from the database."""
        raise NotImplementedError

    def format_row(self, item):
        """Override in subclasses to define how an item is displayed in the list."""
        raise NotImplementedError

    def on_add(self, button, editor_class):
        dialog = editor_class(self.parent_window, self.db) # Assumes parent_window is set
        response = dialog.run()
        if response == Gtk.ResponseType.OK:
            item = dialog.get_values()
            if item.id:
                self.db.update_item(item) # Assumes update_item exists in db
            else:
                self.db.add_item(item) # Assumes add_item exists in db
            self.update_list()
        dialog.destroy()

    def on_edit(self, button, editor_class):
        item_id = _get_selected_item(self.tree_view, self.store)
        if not item_id:
            show_error_dialog(self.parent_window, "Please select an item to edit.")
            return
        items = self.get_items_from_db()
        item = next((i for i in items if i.id == item_id), None)
        if item:
            dialog = editor_class(self.parent_window, self.db, item)
            response = dialog.run()
            if response == Gtk.ResponseType.OK:
                updated_item = dialog.get_values()
                self.db.update_item(updated_item)
                self.update_list()
            dialog.destroy()

    def on_delete(self, button):
        item_id = _get_selected_item(self.tree_view, self.store)
        if not item_id:
            show_error_dialog(self.parent_window, "Please select an item to delete.")
            return
