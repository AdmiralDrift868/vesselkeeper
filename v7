                supplier.preferred, supplier.terms, supplier.last_order_date, supplier.id
            ))

    def delete_supplier(self, supplier_id: int) -> bool:
        """Delete supplier with referential integrity check."""
        with self.get_cursor() as cursor:
            try:
                # Check if supplier is referenced by any inventory items
                cursor.execute("SELECT COUNT(*) FROM inventory_items WHERE supplier_id = ?", (supplier_id,))
                reference_count = cursor.fetchone()[0]
                
                if reference_count > 0:
                    logger.warning(f"Cannot delete supplier {supplier_id}: referenced by {reference_count} inventory items")
                    return False
                
                # Proceed with deletion if no references
                cursor.execute("DELETE FROM suppliers WHERE id = ?", (supplier_id,))
                logger.info(f"Supplier {supplier_id} deleted successfully")
                return True
                
            except Exception as e:
                logger.error(f"Error deleting supplier {supplier_id}: {e}")
                return False

