        return self.value

class Priority(Enum):
    LOW = "Low"
    MEDIUM = "Medium"
    HIGH = "High"
    CRITICAL = "Critical"

    def display_name(self):
        return self.value

class TaskStatus(Enum): # Renamed from Status to avoid conflict with MaintenanceTask.Status
    OVERDUE = "Overdue"
