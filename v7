    # Data formatting functions
    def _inventory_stock_data_func(self, column, cell, model, tree_iter, data):
        stock = model[tree_iter][4]
        min_stock = model[tree_iter][5]
        
        if stock <= 0:
            cell.set_property('foreground', '#dc3545')
            cell.set_property('weight', Pango.Weight.BOLD)
        elif stock <= min_stock:
            cell.set_property('foreground', '#fd7e14')
            cell.set_property('weight', Pango.Weight.BOLD)
        else:
            cell.set_property('foreground', '#28a745')

    def _maintenance_status_data_func(self, column, cell, model, tree_iter, data):
        status = model[tree_iter][5]
        if status == "Overdue":
            cell.set_property('foreground', '#dc3545')
            cell.set_property('weight', Pango.Weight.BOLD)
        elif status == "Due Soon":
            cell.set_property('foreground', '#fd7e14')
            cell.set_property('weight', Pango.Weight.BOLD)
        elif status == "Completed":
            cell.set_property('foreground', '#6c757d')
        else:
            cell.set_property('foreground', '#28a745')

    def _status_cell_data_func_dashboard(self, column, cell, model, tree_iter, data):
        status = model[tree_iter][4]
        if status == "Overdue":
            cell.set_property('foreground', '#dc3545')
            cell.set_property('weight', Pango.Weight.BOLD)
            cell.set_property('background', '#ffe6e6')
        elif status == "Due Soon":
            cell.set_property('foreground', '#fd7e14')
            cell.set_property('weight', Pango.Weight.BOLD)
            cell.set_property('background', '#fff3e6')
        elif status == "Completed":
            cell.set_property('foreground', '#6c757d')
            cell.set_property('background', '#f8f9fa')
        else:
            cell.set_property('foreground', '#28a745')
            cell.set_property('background', '#e6f4ea')

    # Event handlers
    def on_add_vessel(self, button):
        dialog = VesselEditor(self, "Add Vessel")
        response = dialog.run()
        if response == Gtk.ResponseType.OK:
            vessel = dialog.get_values()
