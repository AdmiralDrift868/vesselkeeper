class ThreadSafeDatabase:
    def __init__(self, db_path=DATABASE_FILE):
        self.db_path = db_path
        self.conn = None
        self._lock = threading.RLock()
        self.open_connection()
        self.create_tables()

    @contextmanager
    def get_cursor(self):
        """Thread-safe context manager for database operations."""
        self._lock.acquire()
        try:
            cursor = self.conn.cursor()
            yield cursor
            self.conn.commit()
        except Exception as e:
            self.conn.rollback()
            raise e
        finally:
            self._lock.release()

    def open_connection(self):
        self.conn = sqlite3.connect(self.db_path, check_same_thread=False)
        self.conn.row_factory = sqlite3.Row # Enable column access by name

    def close(self):
        if self.conn:
            self.conn.close()
            self.conn = None

    def create_tables(self):
        with self.get_cursor() as cursor:
            cursor.executescript("""
            CREATE TABLE IF NOT EXISTS vessels (
                id INTEGER PRIMARY KEY,
                name TEXT NOT NULL,
                vessel_type TEXT,
                length REAL,
                beam REAL,
                draft REAL,
                engine_make TEXT,
                engine_model TEXT,
                engine_hours REAL,
                hull_material TEXT,
                build_year INTEGER,
                last_survey TEXT,
                insurance_expiry TEXT,
                current_location TEXT,
                notes TEXT,
                attachments TEXT, -- JSON list of file paths
                registration_number TEXT,
                home_port TEXT,
                gross_tonnage REAL,
                image_path TEXT
            );

            CREATE TABLE IF NOT EXISTS inventory_items (
                id INTEGER PRIMARY KEY,
                name TEXT NOT NULL,
                part_number TEXT,
                description TEXT,
                category TEXT,
                system TEXT,
                location TEXT,
                current_stock INTEGER,
                minimum_stock INTEGER,
                supplier_id INTEGER REFERENCES suppliers(id) ON DELETE SET NULL,
                unit_cost REAL,
                specifications TEXT,
                attachments TEXT, -- JSON list of file paths
                reorder_quantity INTEGER DEFAULT 0,
                last_reorder_date TEXT,
                average_consumption_rate REAL DEFAULT 0,
                notes TEXT
            );

            CREATE TABLE IF NOT EXISTS suppliers (
                id INTEGER PRIMARY KEY,
                name TEXT NOT NULL,
                contact TEXT,
                phone TEXT,
                email TEXT,
                notes TEXT,
                attachments TEXT, -- JSON list of file paths
                address TEXT,
                website TEXT,
                preferred BOOLEAN DEFAULT 0,
                terms TEXT,
                last_order_date TEXT
            );

            CREATE TABLE IF NOT EXISTS trip_logs (
                id INTEGER PRIMARY KEY,
                vessel_id INTEGER REFERENCES vessels(id) ON DELETE CASCADE,
                departure TEXT,
                arrival TEXT,
                origin TEXT,
                destination TEXT,
                start_hours REAL,
                end_hours REAL,
                fuel_used REAL,
                distance REAL,
                crew TEXT,
                log_entries TEXT,
                attachments TEXT, -- JSON list of file paths
                status TEXT DEFAULT 'PLANNED',
                weather_conditions TEXT,
                sea_state TEXT,
                captain TEXT,
                notes TEXT
            );

            CREATE TABLE IF NOT EXISTS maintenance_templates (
                id INTEGER PRIMARY KEY,
                name TEXT NOT NULL, -- Use task name as template name
                system TEXT,
                task_name TEXT NOT NULL,
                interval_type TEXT,
                interval_value INTEGER,
                priority TEXT,
                parts_required TEXT, -- JSON list of PartRequirement objects
                instructions TEXT,
                labor_cost REAL DEFAULT 0,
                estimated_duration_hours REAL DEFAULT 0,
                notes TEXT
            );

            CREATE TABLE IF NOT EXISTS maintenance_tasks (
                id INTEGER PRIMARY KEY,
                vessel_id INTEGER REFERENCES vessels(id) ON DELETE CASCADE,
                system TEXT,
                task_name TEXT NOT NULL,
                template_id INTEGER REFERENCES maintenance_templates(id) ON DELETE SET NULL,
                interval_type TEXT,
                interval_value INTEGER,
                last_completed TEXT,
                last_hours REAL,
                next_due TEXT,
                priority TEXT,
                parts_required TEXT, -- JSON list of PartRequirement objects
                instructions TEXT,
                labor_cost REAL DEFAULT 0,
                total_parts_cost REAL DEFAULT 0,
                attachments TEXT, -- JSON list of file paths
                status TEXT DEFAULT 'ON_SCHEDULE',
                assigned_to TEXT,
                estimated_duration_hours REAL DEFAULT 0,
                actual_duration_hours REAL DEFAULT 0,
                notes TEXT
            );

            CREATE TABLE IF NOT EXISTS stock_transactions (
                id INTEGER PRIMARY KEY,
                item_id INTEGER REFERENCES inventory_items(id) ON DELETE CASCADE,
                transaction_type TEXT,
                quantity INTEGER,
                date TEXT,
                reference TEXT,
                notes TEXT
            );

            CREATE TABLE IF NOT EXISTS performance_metrics (
                id INTEGER PRIMARY KEY,
                vessel_id INTEGER REFERENCES vessels(id) ON DELETE CASCADE,
                metric_name TEXT NOT NULL,
                value REAL,
                unit TEXT,
                date_recorded TEXT -- YYYY-MM-DD
            );

            CREATE TABLE IF NOT EXISTS change_log (
                id INTEGER PRIMARY KEY,
                table_name TEXT,
                record_id INTEGER,
                operation TEXT,
                timestamp TEXT
            );
            """)

