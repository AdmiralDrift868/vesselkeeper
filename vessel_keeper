        self.inventory_store = Gtk.ListStore(int, str, str, str, int, int, float)
        self.tasks_store = Gtk.ListStore(int, str, str, str, str, str, str, str)

        self.vessels_filter = Gtk.TreeModelFilter(child_model=self.vessels_store)
        self.inventory_filter = Gtk.TreeModelFilter(child_model=self.inventory_store)
        self.tasks_filter = Gtk.TreeModelFilter(child_model=self.tasks_store)

        self._setup_ui()
        self._apply_css()
        self._restore_window_state()
        self._perform_startup_backup()
        self.refresh_all()

        logger.info("Vessel Keeper started successfully")

    def _setup_ui(self):
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(main_box)

        header = Gtk.HeaderBar()
        header.set_show_close_button(True)
        header.set_title("Vessel Keeper")
        header.set_subtitle("Enterprise Marine Management System")
        self.set_titlebar(header)

        self.notebook = Gtk.Notebook()
        main_box.pack_start(self.notebook, True, True, 0)

        self.notebook.append_page(self._create_dashboard(), Gtk.Label("Dashboard"))
        self.notebook.append_page(self._create_tab("Vessels", self.vessels_filter, self.vessels_store,
            ["ID", "Name", "Type", "Engine Make", "Model", "Location"]), Gtk.Label("Vessels"))
        self.notebook.append_page(self._create_tab("Inventory", self.inventory_filter, self.inventory_store,
            ["ID", "Name", "Part No", "Category", "Stock", "Min", "Cost"]), Gtk.Label("Inventory"))
        self.notebook.append_page(self._create_tab("Maintenance", self.tasks_filter, self.tasks_store,
            ["ID", "Vessel", "System", "Task", "Description", "Due", "Status", "Priority"]), Gtk.Label("Maintenance"))

