# DATABASE
# =============================================================================
class DatabaseConnectionPool:
    def __init__(self, db_path="vessel_keeper.db", max_conn=6):
        self.db_path = db_path
        self._pool: Queue = Queue(max_conn)
        for _ in range(max_conn):
            self._pool.put(self._create_conn())

    def _create_conn(self):
        conn = sqlite3.connect(self.db_path, timeout=20, check_same_thread=False)
        conn.row_factory = sqlite3.Row
        conn.execute("PRAGMA foreign_keys = ON")
        conn.execute("PRAGMA journal_mode = WAL")
        return conn

    @contextmanager
    def get_connection(self):
        conn = self._pool.get()
        try:
            yield conn
            conn.commit()
        except Exception as e:
            conn.rollback()
            logger.error("Database error", error=str(e))
            raise
        finally:
            self._pool.put(conn)

class ThreadSafeDatabase:
    def __init__(self):
        Path("backups").mkdir(exist_ok=True)
        Path("reports").mkdir(exist_ok=True)
        self.pool = DatabaseConnectionPool()
        self._init_schema()

    def _init_schema(self):
        with self.pool.get_connection() as conn:
            conn.executescript("""
                CREATE TABLE IF NOT EXISTS vessels (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    name TEXT NOT NULL UNIQUE,
                    vessel_type TEXT,
                    engine_make TEXT,
                    engine_model TEXT,
                    current_location TEXT,
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                );
                CREATE TABLE IF NOT EXISTS inventory_items (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    name TEXT NOT NULL,
                    part_number TEXT,
                    category TEXT,
                    current_stock INTEGER DEFAULT 0,
                    minimum_stock INTEGER DEFAULT 0,
                    unit_cost REAL DEFAULT 0.0,
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                );
                CREATE TABLE IF NOT EXISTS maintenance_tasks (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    vessel_id INTEGER NOT NULL,
                    system TEXT,
                    task_name TEXT NOT NULL,
                    description TEXT,
                    next_due TEXT,
                    status TEXT DEFAULT 'pending',
                    priority TEXT DEFAULT 'medium',
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                    FOREIGN KEY (vessel_id) REFERENCES vessels(id) ON DELETE CASCADE
                );
                CREATE INDEX IF NOT EXISTS idx_tasks_due ON maintenance_tasks(next_due);
            """)

    def execute_query(self, sql: str, params=()) -> List[Dict]:
        with self.pool.get_connection() as conn:
            return [dict(row) for row in conn.execute(sql, params).fetchall()]

    def execute_update(self, sql: str, params=()) -> int:
        with self.pool.get_connection() as conn:
            return conn.execute(sql, params).rowcount

    def get_vessels(self): return self.execute_query("SELECT * FROM vessels ORDER BY name")
    def get_inventory(self): return self.execute_query("SELECT * FROM inventory_items ORDER BY name")
    def get_maintenance_tasks(self):
        return self.execute_query("""
            SELECT mt.*, COALESCE(v.name, 'Unknown Vessel') as vessel_name 
            FROM maintenance_tasks mt LEFT JOIN vessels v ON mt.vessel_id = v.id 
            ORDER BY mt.next_due
        """)

    def close(self):
        while not self.pool._pool.empty():
            try:
                self.pool._pool.get_nowait().close()
            except:
                pass

