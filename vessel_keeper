        self.status_ctx = self.status_bar.get_context_id("main")
        main_box.pack_end(self.status_bar, False, False, 0)
        self._update_status("Application ready")

    def _create_dashboard(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20, border_width=30)
        title = Gtk.Label(label="Dashboard", name="title")
        box.pack_start(title, False, False, 0)
        self.dashboard_label = Gtk.Label(label="Loading summary...")
        box.pack_start(self.dashboard_label, True, True, 0)
        btn = Gtk.Button(label="Refresh All")
        btn.connect("clicked", lambda b: self.refresh_all())
        box.pack_start(btn, False, False, 0)
        return box

    def _create_tab(self, name: str, filter_model, base_store, columns):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, border_width=10)

        # Search
        search = Gtk.SearchEntry(placeholder_text=f"Search {name}...")
        search.connect("search-changed", lambda e: self._apply_filter(filter_model, base_store, e.get_text()))
        box.pack_start(search, False, False, 0)

        # Toolbar
        toolbar = Gtk.Box(spacing=6)
        lbl = Gtk.Label(label=name, name="section-title")
        toolbar.pack_start(lbl, True, True, 0)

        for text, cb in [("Add", getattr(self, f"_add_{name.lower().replace(' ', '_')}", None)),
                         ("Edit", getattr(self, f"_edit_{name.lower().replace(' ', '_')}", None)),
                         ("Delete", getattr(self, f"_delete_{name.lower().replace(' ', '_')}", None)),
                         ("Export CSV", lambda b, n=name: self._export_csv(n))]:
            if cb:
                btn = Gtk.Button(label=text)
                btn.connect("clicked", cb)
                toolbar.pack_start(btn, False, False, 0)

        box.pack_start(toolbar, False, False, 0)

        tree = Gtk.TreeView(model=filter_model)
        for i, title in enumerate(columns):
            col = Gtk.TreeViewColumn(title, Gtk.CellRendererText(), text=i)
            col.set_resizable(True)
            if i == 0: col.set_visible(False)
            tree.append_column(col)

        scroll = Gtk.ScrolledWindow()
        scroll.add(tree)
        box.pack_start(scroll, True, True, 0)

        setattr(self, f"{name.lower()}_tree", tree)
        return box

    def _apply_filter(self, filter_model, base_store, text):
        def visible_func(model, iter_, data):
            if not text: return True
            for i in range(model.get_n_columns()):
                val = model.get_value(iter_, i)
                if val and text.lower() in str(val).lower():
                    return True
            return False
        filter_model.set_visible_func(visible_func)
        filter_model.refilter()

    def _apply_css(self):
        css = """
        #title { font-size: 28px; font-weight: bold; padding: 10px; }
        #section-title { font-size: 18px; font-weight: bold; }
        .overdue { color: #d32f2f; font-weight: bold; }
        .due-soon { color: #f57c00; font-weight: bold; }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def _restore_window_state(self):
        self.move(self.config.get("window_x", 100), self.config.get("window_y", 100))
        self.resize(self.config.get("window_width", 1350), self.config.get("window_height", 850))

    def _perform_startup_backup(self):
        try:
            timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
            backup_path = Path("backups") / f"startup_{timestamp}.db"
            if os.path.exists("vessel_keeper.db"):
                shutil.copy2("vessel_keeper.db", backup_path)
                logger.info("Startup backup created", path=str(backup_path))
        except Exception as e:
            logger.warning("Startup backup failed", error=str(e))

    # ====================== MAINTENANCE DIALOG ======================
    def _create_maintenance_dialog(self, initial=None):
        dialog = Gtk.Dialog(title="Maintenance Task", transient_for=self, flags=0)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Save", Gtk.ResponseType.OK)
        grid = Gtk.Grid(row_spacing=12, column_spacing=15, border_width=20)
        dialog.get_content_area().add(grid)

        vessels = self.db.get_vessels()
        combo = Gtk.ComboBoxText()
        vessel_map = {}
        for v in vessels:
            combo.append_text(v['name'])
            vessel_map[v['name']] = v['id']

        entries = {}
        fields = [("system", "System"), ("task_name", "Task Name"), ("description", "Description"),
                  ("next_due", "Next Due (YYYY-MM-DD)")]

        grid.attach(Gtk.Label("Vessel:"), 0, 0, 1, 1)
        grid.attach(combo, 1, 0, 1, 1)

        for i, (key, label) in enumerate(fields, 1):
            grid.attach(Gtk.Label(label + ":"), 0, i, 1, 1)
            entry = Gtk.Entry(text=str(initial.get(key, "") if initial else ""))
            grid.attach(entry, 1, i, 1, 1)
            entries[key] = entry

        if initial and initial.get('vessel_name'):
            combo.set_active_text(initial['vessel_name'])

        response = dialog.run()
        result = None
        if response == Gtk.ResponseType.OK:
            vessel_name = combo.get_active_text()
            result = {
                "vessel_id": vessel_map.get(vessel_name),
                "system": entries["system"].get_text().strip(),
                "task_name": entries["task_name"].get_text().strip(),
                "description": entries["description"].get_text().strip(),
                "next_due": entries["next_due"].get_text().strip()
            }
        dialog.destroy()
        return result

    # ====================== CRUD METHODS ======================
    def _add_vessel(self, btn=None):
        # Simple form for vessel
        dialog = self._create_simple_form("Add Vessel", ["name", "vessel_type", "engine_make", "engine_model", "current_location"])
        if dialog and dialog.get("name"):
            self.db.execute_update(
                "INSERT INTO vessels (name, vessel_type, engine_make, engine_model, current_location) VALUES (?,?,?,?,?)",
                (dialog["name"], dialog["vessel_type"], dialog["engine_make"], dialog["engine_model"], dialog["current_location"])
            )
            self.refresh_all()

    def _edit_vessel(self, btn=None):
        row = self._get_selected(self.vessels_tree)
        if not row: return
        data = self.db.execute_query("SELECT * FROM vessels WHERE id=?", (row[0],))[0]
        new_data = self._create_simple_form("Edit Vessel", ["name", "vessel_type", "engine_make", "engine_model", "current_location"], data)
        if new_data and new_data.get("name"):
            self.db.execute_update(
                "UPDATE vessels SET name=?, vessel_type=?, engine_make=?, engine_model=?, current_location=? WHERE id=?",
                (new_data["name"], new_data["vessel_type"], new_data["engine_make"], new_data["engine_model"], new_data["current_location"], row[0])
            )
            self.refresh_all()

    def _delete_vessel(self, btn=None):
        row = self._get_selected(self.vessels_tree)
        if row and self._confirm(f"Delete vessel '{row[1]}'?"):
            self.db.execute_update("DELETE FROM vessels WHERE id=?", (row[0],))
            self.refresh_all()

    def _add_inventory(self, btn=None):
        dialog = self._create_simple_form("Add Inventory Item", ["name", "part_number", "category", "current_stock", "minimum_stock", "unit_cost"])
        if dialog and dialog.get("name"):
            self.db.execute_update(
                "INSERT INTO inventory_items (name, part_number, category, current_stock, minimum_stock, unit_cost) VALUES (?,?,?,?,?,?)",
                (dialog["name"], dialog["part_number"], dialog["category"], 
                 int(dialog.get("current_stock", 0)), int(dialog.get("minimum_stock", 0)), float(dialog.get("unit_cost", 0)))
            )
            self.refresh_all()

    def _add_maintenance(self, btn=None):
        data = self._create_maintenance_dialog()
        if data and data.get("vessel_id") and data.get("task_name"):
            self.db.execute_update(
                "INSERT INTO maintenance_tasks (vessel_id, system, task_name, description, next_due) VALUES (?,?,?,?,?)",
                (data["vessel_id"], data["system"], data["task_name"], data["description"], data["next_due"])
            )
            self.refresh_all()

    def _edit_maintenance(self, btn=None):
        row = self._get_selected(self.tasks_tree)
        if not row: return
        data = self.db.execute_query("SELECT * FROM maintenance_tasks WHERE id=?", (row[0],))[0]
        new_data = self._create_maintenance_dialog(data)
        if new_data and new_data.get("vessel_id"):
            self.db.execute_update(
                "UPDATE maintenance_tasks SET vessel_id=?, system=?, task_name=?, description=?, next_due=? WHERE id=?",
                (new_data["vessel_id"], new_data["system"], new_data["task_name"], new_data["description"], new_data["next_due"], row[0])
            )
            self.refresh_all()

    def _delete_maintenance(self, btn=None):
        row = self._get_selected(self.tasks_tree)
        if row and self._confirm(f"Delete task '{row[3]}'?"):
            self.db.execute_update("DELETE FROM maintenance_tasks WHERE id=?", (row[0],))
            self.refresh_all()

    def _create_simple_form(self, title, fields, initial=None):
        dialog = Gtk.Dialog(title=title, transient_for=self, flags=0)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Save", Gtk.ResponseType.OK)
        grid = Gtk.Grid(row_spacing=10, column_spacing=15, border_width=20)
        dialog.get_content_area().add(grid)

        entries = {}
        initial = initial or {}
        for i, key in enumerate(fields):
            lbl = Gtk.Label(label=key.replace("_", " ").title() + ":")
            entry = Gtk.Entry(text=str(initial.get(key, "")))
            grid.attach(lbl, 0, i, 1, 1)
            grid.attach(entry, 1, i, 1, 1)
            entries[key] = entry

        response = dialog.run()
        result = None
        if response == Gtk.ResponseType.OK:
            result = {k: e.get_text().strip() for k, e in entries.items()}
        dialog.destroy()
        return result

    def _get_selected(self, treeview):
        selection = treeview.get_selection()
        model, iter_ = selection.get_selected()
        return model[iter_] if iter_ else None

    def _confirm(self, message):
        dlg = Gtk.MessageDialog(self, 0, Gtk.MessageType.WARNING, Gtk.ButtonsType.YES_NO, message)
        resp = dlg.run()
        dlg.destroy()
        return resp == Gtk.ResponseType.YES

    def _export_csv(self, section: str):
        try:
            timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M")
            filename = Path("reports") / f"{section.lower()}_{timestamp}.csv"

            if section == "Vessels":
                data = self.db.get_vessels()
                headers = ["id", "name", "vessel_type", "engine_make", "engine_model", "current_location"]
            elif section == "Inventory":
                data = self.db.get_inventory()
                headers = ["id", "name", "part_number", "category", "current_stock", "minimum_stock", "unit_cost"]
            else:
                data = self.db.get_maintenance_tasks()
                headers = ["id", "vessel_name", "system", "task_name", "description", "next_due", "status", "priority"]

            with open(filename, 'w', newline='', encoding='utf-8') as f:
                writer = csv.DictWriter(f, fieldnames=headers)
                writer.writeheader()
                writer.writerows(data)

            self._update_status(f"Exported {section} to CSV")
        except Exception as e:
            logger.error("CSV export failed", error=str(e))

    def refresh_all(self, *args):
        vessels = self.db.get_vessels()
        inventory = self.db.get_inventory()
        tasks = self.db.get_maintenance_tasks()
        self.ui_manager.queue_action(self._update_all_views, vessels, inventory, tasks)

    def _update_all_views(self, vessels, inventory, tasks):
        today = datetime.date.today()
        due_soon_days = self.config.get("due_soon_days", 7)

        # Vessels
        self.vessels_store.clear()
        for v in vessels:
            self.vessels_store.append([v['id'], v['name'], v.get('vessel_type',''), v.get('engine_make',''),
                                     v.get('engine_model',''), v.get('current_location','')])

        # Inventory
        self.inventory_store.clear()
        for i in inventory:
            self.inventory_store.append([i['id'], i['name'], i.get('part_number',''), i.get('category',''),
                                       i.get('current_stock',0), i.get('minimum_stock',0), float(i.get('unit_cost',0))])

        # Maintenance with color logic (applied via cell data func in real app, here simplified)
        self.tasks_store.clear()
        for t in tasks:
            self.tasks_store.append([t['id'], t.get('vessel_name',''), t.get('system',''), t.get('task_name',''),
                                   t.get('description',''), t.get('next_due',''), t.get('status',''), t.get('priority','')])

        summary = f"Vessels: {len(vessels)}\nInventory: {len(inventory)}\nTasks: {len(tasks)}"
        self.dashboard_label.set_text(summary)
        self._update_status(f"Refreshed — {len(vessels)} vessels, {len(tasks)} tasks")

    def _update_status(self, message: str):
        self.status_bar.pop(self.status_ctx)
        self.status_bar.push(self.status_ctx, message)

    def do_delete_event(self, event):
        self._shutdown()
        return True

    def _shutdown(self):
        try:
            x, y = self.get_position()
            w, h = self.get_size()
            self.config._config.window_x = x
            self.config._config.window_y = y
            self.config._config.window_width = w
            self.config._config.window_height = h
            self.config.save()
        except Exception as e:
            logger.error("Shutdown error", error=str(e))

        self.db.close()
        logger.info("Vessel Keeper shutdown complete")
        Gtk.main_quit()

