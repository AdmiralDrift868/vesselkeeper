class BaseEditor(Gtk.Dialog):
    def __init__(self, title: str, parent: Gtk.Window, db: Database, item=None):
        super().__init__(title=title, transient_for=parent, flags=0)
        self.db = db
        self.item = item
        self.set_default_size(600, 500)
        self._setup_ui()
        if self.item:
            self._load_existing_data()

    def _setup_ui(self):
        content = self.get_content_area()
        content.set_border_width(10)
        self.grid = Gtk.Grid(column_spacing=10, row_spacing=10)
        content.pack_start(self.grid, True, True, 0)
        self._pre_setup_data()
        self._setup_fields()
        self.add_button("Cancel", Gtk.ResponseType.CANCEL)
        self.add_button("Save", Gtk.ResponseType.OK)
        if self.item:
            self.add_button("Delete", Gtk.ResponseType.DELETE_EVENT)
        self.show_all()

    def _pre_setup_data(self):
        pass

    def _setup_fields(self):
        pass

    def _add_form_field(self, row: int, label: str, widget: Gtk.Widget, multiline: bool = False, units: str = "") -> Gtk.Widget:
        self.grid.attach(Gtk.Label(label=label, xalign=0), 0, row, 1, 1)
        if multiline:
            scroll = Gtk.ScrolledWindow()
            scroll.set_min_content_height(80)
            scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
            scroll.add(widget)
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            box.pack_start(scroll, True, True, 0)
            if units:
                box.pack_start(Gtk.Label(label=units), False, False, 0)
            self.grid.attach(box, 1, row, 1, 1)
        else:
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            box.pack_start(widget, True, True, 0)
            if units:
                box.pack_start(Gtk.Label(label=units), False, False, 0)
            self.grid.attach(box, 1, row, 1, 1)
        return widget

    def _load_existing_data(self):
        pass

    def validate(self) -> bool:
        return True

    def get_data(self):
        pass

