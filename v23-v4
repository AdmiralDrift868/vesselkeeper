        self.interval_type_combo.connect("changed", self.on_interval_type_changed)

    def on_interval_type_changed(self, combo: Gtk.ComboBoxText):
        # Simple hint: clear next_due for HOURS/USAGE_CYCLES
        active_text = combo.get_active_text()
        if active_text in [IntervalType.HOURS.display_name(), IntervalType.USAGE_CYCLES.display_name()]:
            self.next_due_entry.set_text("")
            self.next_due_entry.set_sensitive(False)
        else:
            self.next_due_entry.set_sensitive(True)

    def on_apply_template(self, button: Gtk.Button):
        active_idx = self.template_combo.get_active()
        if active_idx > 0 and active_idx <= len(self.templates):
            template = self.templates[active_idx - 1] # Adjust for "None" at index 0
            # Apply template data to fields
            # System
            if template.system in SYSTEM_CATEGORIES:
                idx = SYSTEM_CATEGORIES.index(template.system)
                self.system_combo.set_active(idx)
            self.task_name_entry.set_text(template.task_name)
            # Interval Type
            for idx, interval_type_enum in enumerate(IntervalType):
                if template.interval_type == interval_type_enum:
                    self.interval_type_combo.set_active(idx)
                    break
            self.interval_value_entry.set_value(template.interval_value)
            # Priority
            for idx, priority_enum in enumerate(Priority):
                if template.priority == priority_enum:
                    self.priority_combo.set_active(idx)
                    break
            # Parts (This is complex as it requires matching inventory IDs)
            # For simplicity, we'll just log the intended parts.
            # A full implementation would need to map template part IDs to actual inventory IDs,
            # which might not be straightforward. We'll leave the parts list unchanged for now.
            # The selected_part_ids list and UI would need to be updated accordingly.
            logger.info(f"Applied template '{template.name}'. Parts required: {template.parts_required}")
            # Instructions
            buffer = self.instructions_entry.get_buffer()
            buffer.set_text(template.instructions)
            
            show_info_dialog(self, f"Template '{template.name}' applied. Please review and adjust fields as needed.")

    def _populate_parts_store(self):
        self.parts_store.clear()
        for item in self.inventory_items:
            is_selected = item.id in self.selected_part_ids if item.id is not None else False
            self.parts_store.append([is_selected, item.id or 0, item.name, item.part_number])

    def on_part_toggled(self, widget: Gtk.CellRendererToggle, path: str):
        iter = self.parts_store.get_iter(path)
        is_selected = self.parts_store.get_value(iter, 0)
        item_id = self.parts_store.get_value(iter, 1)
        self.parts_store.set_value(iter, 0, not is_selected)
        if not is_selected:
            if item_id not in self.selected_part_ids:
                self.selected_part_ids.append(item_id)
        else:
            if item_id in self.selected_part_ids:
                self.selected_part_ids.remove(item_id)
        logger.debug(f"Selected parts IDs: {self.selected_part_ids}")
        self._calculate_total_parts_cost()

    def _calculate_total_parts_cost(self):
        total = 0.0
        for item in self.inventory_items:
            if item.id in self.selected_part_ids:
                total += item.unit_cost
        self.total_parts_cost_entry.set_value(total)
        # self._update_total_job_cost() # Called by on_cost_changed

    def on_cost_changed(self, spinbutton: Gtk.SpinButton):
        self._update_total_job_cost()

    def _update_total_job_cost(self):
        labor = self.labor_cost_entry.get_value()
        parts = self.total_parts_cost_entry.get_value()
        total = labor + parts
        # Block signal to prevent recursion if setting from code
        self.total_job_cost_entry.set_value(total)

    def _load_existing_data(self):
        if not self.item:
            return
        task: MaintenanceTask = self.item
        vessel_names = [v.name for v in self.vessels]
        if task.vessel_name in vessel_names:
            idx = vessel_names.index(task.vessel_name)
            self.vessel_combo.set_active(idx)
        if task.system in SYSTEM_CATEGORIES:
            idx = SYSTEM_CATEGORIES.index(task.system)
            self.system_combo.set_active(idx)
        self.task_name_entry.set_text(task.task_name)
        for idx, interval_type_enum in enumerate(IntervalType):
            if task.interval_type == interval_type_enum:
                self.interval_type_combo.set_active(idx)
                break
        self.interval_value_entry.set_value(task.interval_value)
        self.last_completed_entry.set_text(task.last_completed)
        self.last_hours_entry.set_value(task.last_hours)
        self.next_due_entry.set_text(task.next_due)
        for idx, priority_enum in enumerate(Priority):
            if task.priority == priority_enum:
                self.priority_combo.set_active(idx)
                break
        buffer = self.instructions_entry.get_buffer()
        buffer.set_text(task.instructions)
        # Cost data
        self.labor_cost_entry.set_value(task.labor_cost)
        self.total_parts_cost_entry.set_value(task.total_parts_cost)
        self.total_job_cost_entry.set_value(task.total_job_cost)
        # Handle interval type sensitivity for next_due
        self.on_interval_type_changed(self.interval_type_combo)

    def get_data(self) -> MaintenanceTask:
        buffer = self.instructions_entry.get_buffer()
        start_iter, end_iter = buffer.get_bounds()
        vessel_id = self.vessels[self.vessel_combo.get_active()].id if self.vessel_combo.get_active() >= 0 and self.vessels else 0
        selected_interval_type = IntervalType.HOURS
        if self.interval_type_combo.get_active() >= 0:
            selected_interval_type = list(IntervalType)[self.interval_type_combo.get_active()]
        selected_priority = Priority.MEDIUM
        if self.priority_combo.get_active() >= 0:
            selected_priority = list(Priority)[self.priority_combo.get_active()]

        # Calculate next_due for date-based tasks if not already set or if last_completed changed
        next_due_date_str = self.next_due_entry.get_text()
        if selected_interval_type == IntervalType.DAYS and self.last_completed_entry.get_text():
            try:
                last_date = datetime.datetime.strptime(self.last_completed_entry.get_text(), "%Y-%m-%d").date()
                next_due_date = last_date + datetime.timedelta(days=int(self.interval_value_entry.get_value()))
                next_due_date_str = next_due_date.strftime("%Y-%m-%d")
            except ValueError:
                pass # Keep user-entered next_due if calculation fails

        return MaintenanceTask(
            id=self.item.id if self.item else None,
            vessel_id=vessel_id,
            vessel_name=self.vessel_combo.get_active_text() or "",
            system=self.system_combo.get_active_text() or "",
            task_name=self.task_name_entry.get_text().strip(),
            template_id=None, # Not set from editor
            interval_type=selected_interval_type,
            interval_value=int(self.interval_value_entry.get_value()),
            last_completed=self.last_completed_entry.get_text(),
            last_hours=self.last_hours_entry.get_value(),
            next_due=next_due_date_str,
            priority=selected_priority,
            parts_required=self.selected_part_ids if self.selected_part_ids else None,
            instructions=buffer.get_text(start_iter, end_iter, False).strip(),
            labor_cost=self.labor_cost_entry.get_value(),
            total_parts_cost=self.total_parts_cost_entry.get_value(),
            total_job_cost=self.total_job_cost_entry.get_value(),
            attachments=self.attachment_widget.get_attachments()
        )

    def validate(self) -> bool:
        if not self.task_name_entry.get_text().strip():
            show_error_dialog(self, "Task name is required.")
            self.task_name_entry.grab_focus()
            return False
        if self.vessel_combo.get_active() < 0:
             show_error_dialog(self, "Please select a vessel.")
             self.vessel_combo.grab_focus()
             return False
        if self.last_completed_entry.get_text() and not self.last_completed_entry.validate_date():
            show_error_dialog(self, "Last Completed date format is invalid. Please use YYYY-MM-DD.")
            self.last_completed_entry.entry.grab_focus()
            return False
        if self.next_due_entry.get_sensitive() and self.next_due_entry.get_text() and not self.next_due_entry.validate_date():
            show_error_dialog(self, "Next Due date format is invalid. Please use YYYY-MM-DD.")
            self.next_due_entry.entry.grab_focus()
            return False
        last_completed = self.last_completed_entry.get_text()
        next_due = self.next_due_entry.get_text()
        if last_completed and next_due and self.next_due_entry.get_sensitive():
            try:
                last_date = datetime.datetime.strptime(last_completed, "%Y-%m-%d").date()
                next_date = datetime.datetime.strptime(next_due, "%Y-%m-%d").date()
                if next_date < last_date:
                    show_error_dialog(self, "Next Due date cannot be before Last Completed date.")
                    self.next_due_entry.entry.grab_focus()
                    return False
            except ValueError:
                pass
        return True

