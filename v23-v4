    def add_trip_log(self, log: TripLog) -> int:
        cursor = self.conn.cursor()
        cursor.execute("""
            INSERT INTO trip_logs (vessel_id, departure, arrival, origin, destination, start_hours, end_hours, fuel_used, distance, crew, log_entries, attachments)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            log.vessel_id, log.departure, log.arrival, log.origin,
            log.destination, log.start_hours, log.end_hours, log.fuel_used,
            log.distance, log.crew, log.log_entries,
            json.dumps(log.attachments) if log.attachments else None
        ))
        self.conn.commit()
        log_id = cursor.lastrowid
        logger.info(f"Added trip log ID: {log_id}")
        if log.vessel_id and log.end_hours > 0:
             cursor.execute("UPDATE vessels SET engine_hours = ? WHERE id = ?", (log.end_hours, log.vessel_id))
             logger.info(f"Updated vessel {log.vessel_id} engine hours to {log.end_hours} based on trip log {log_id}")
        self.conn.commit()
        return log_id

