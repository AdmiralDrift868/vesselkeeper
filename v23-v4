    def delete_vessel(self, vessel_id: int):
        cursor = self.conn.cursor()
        cursor.execute("SELECT COUNT(*) FROM maintenance_tasks WHERE vessel_id = ?", (vessel_id,))
        task_count = cursor.fetchone()[0]
        if task_count > 0:
            raise Exception(f"Cannot delete vessel. It has {task_count} associated maintenance tasks.")
        cursor.execute("DELETE FROM vessels WHERE id=?", (vessel_id,))
        self.conn.commit()
        logger.info(f"Deleted vessel ID: {vessel_id}")

    def get_vessels(self) -> List[Vessel]:
        cursor = self.conn.cursor()
        cursor.execute("SELECT * FROM vessels")
        vessels = []
        for row in cursor.fetchall():
            row_dict = dict(row)
            if row_dict.get('attachments'):
                try:
                    row_dict['attachments'] = json.loads(row_dict['attachments'])
                except (json.JSONDecodeError, TypeError):
                    row_dict['attachments'] = []
            else:
                row_dict['attachments'] = []
            vessels.append(Vessel(**row_dict))
        return vessels

