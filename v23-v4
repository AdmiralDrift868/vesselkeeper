@dataclass
class MaintenanceTask:
    id: Optional[int] = None
    vessel_id: int = 0
    vessel_name: str = "" # Populated during fetch
    system: str = ""
    task_name: str = ""
    template_id: Optional[int] = None
    interval_type: IntervalType = IntervalType.HOURS
    interval_value: int = 0
    last_completed: str = ""
    last_hours: float = 0.0
    next_due: str = ""
    priority: Priority = Priority.MEDIUM
    parts_required: Optional[List[int]] = None # List of InventoryItem IDs
    instructions: str = ""
    labor_cost: float = 0.0
    total_parts_cost: float = 0.0 # Calculated from parts
    total_job_cost: float = 0.0 # labor_cost + total_parts_cost
    attachments: List[str] = field(default_factory=list) # List of file paths

    def get_status(self, vessel_engine_hours: float, due_soon_days: int = 7) -> Status:
        """Calculate status based on interval type and current vessel hours."""
        if self.interval_type in [IntervalType.HOURS, IntervalType.USAGE_CYCLES]:
            # For HOURS/USAGE_CYCLES, status is based on engine hours
            if self.interval_value <= 0:
                return Status.ON_SCHEDULE # Avoid division by zero or negative
            due_at_hours = self.last_hours + self.interval_value
            if vessel_engine_hours >= due_at_hours:
                return Status.OVERDUE
            elif vessel_engine_hours >= (due_at_hours - (0.1 * self.interval_value)): # 10% of interval as "Due Soon" window
                return Status.DUE_SOON
            else:
                return Status.ON_SCHEDULE
        else:
            # For DAYS, status is based on next_due date
            if not self.next_due:
                return Status.ON_SCHEDULE
            try:
                next_due_date = datetime.datetime.strptime(self.next_due, "%Y-%m-%d").date()
                today = datetime.date.today()
                if next_due_date < today:
                    return Status.OVERDUE
                elif next_due_date <= today + datetime.timedelta(days=due_soon_days):
                    return Status.DUE_SOON
                else:
                    return Status.ON_SCHEDULE
            except (ValueError, TypeError) as e:
                logger.warning(f"Error parsing next_due date for task {self.id}: {e}")
                return Status.ON_SCHEDULE

