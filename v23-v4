            self.last_survey_entry.entry.grab_focus()
            return False
        if self.insurance_expiry_entry.get_text() and not self.insurance_expiry_entry.validate_date():
            show_error_dialog(self, "Insurance Expiry date format is invalid. Please use YYYY-MM-DD.")
            self.insurance_expiry_entry.entry.grab_focus()
            return False
        build_year = int(self.build_year_entry.get_value())
        current_year = datetime.datetime.now().year
        if build_year < 1800 or build_year > current_year + 5:
            show_error_dialog(self, f"Build year must be between 1800 and {current_year + 5}.")
            self.build_year_entry.grab_focus()
            return False
        return True

