    def get_task_templates(self) -> List[TaskTemplate]:
        cursor = self.conn.cursor()
        cursor.execute("SELECT * FROM task_templates")
        templates = []
        for row in cursor.fetchall():
            row_dict = dict(row)
            if row_dict["interval_type"]:
                 try:
                     row_dict["interval_type"] = IntervalType[row_dict["interval_type"]]
                 except KeyError:
                     logger.warning(f"Unknown interval_type '{row_dict['interval_type']}' for template {row_dict.get('id')}. Defaulting to HOURS.")
                     row_dict["interval_type"] = IntervalType.HOURS
            if row_dict["priority"]:
                try:
                    row_dict["priority"] = Priority[row_dict["priority"]]
                except KeyError:
                    logger.warning(f"Unknown priority '{row_dict['priority']}' for template {row_dict.get('id')}. Defaulting to MEDIUM.")
                    row_dict["priority"] = Priority.MEDIUM
            if row_dict["parts_required"]:
                try:
                    parsed_parts = json.loads(row_dict["parts_required"])
                    if isinstance(parsed_parts, list) and all(isinstance(i, int) for i in parsed_parts):
                        row_dict["parts_required"] = parsed_parts
                    else:
                        raise ValueError("Parsed parts_required is not a list of integers")
                except (json.JSONDecodeError, TypeError, ValueError) as e:
                    logger.warning(f"Error decoding parts_required for template {row_dict.get('id')}: {e}. Setting to None.")
                    row_dict["parts_required"] = None
            else:
                row_dict["parts_required"] = None
            templates.append(TaskTemplate(**row_dict))
        return templates

