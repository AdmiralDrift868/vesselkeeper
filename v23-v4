class AttachmentWidget(Gtk.Box):
    def __init__(self, parent_window: Gtk.Window, initial_attachments: List[str] = None):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.parent_window = parent_window
        self.attachments: List[str] = initial_attachments if initial_attachments else []
        self.set_border_width(5)

        # Label
        self.pack_start(Gtk.Label(label="Attachments:", xalign=0), False, False, 0)

        # List Box for attachments
        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scroll.set_min_content_height(100)
        scroll.add(self.listbox)
        self.pack_start(scroll, True, True, 0)

        # Buttons
        button_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.add_button = Gtk.Button.new_with_label("Add...")
        self.add_button.connect("clicked", self.on_add_clicked)
        self.remove_button = Gtk.Button.new_with_label("Remove")
        self.remove_button.connect("clicked", self.on_remove_clicked)
        self.remove_button.set_sensitive(False)
        button_box.pack_start(self.add_button, False, False, 0)
        button_box.pack_start(self.remove_button, False, False, 0)
        self.pack_start(button_box, False, False, 0)

        self.listbox.connect("row-selected", self.on_row_selected)
        self._populate_listbox()

    def _populate_listbox(self):
        # Clear existing rows
        for child in self.listbox.get_children():
            self.listbox.remove(child)
        # Add rows for each attachment
        for path in self.attachments:
            label = Gtk.Label(label=os.path.basename(path), xalign=0)
            label.set_tooltip_text(path)
            row = Gtk.ListBoxRow()
            row.add(label)
            row.file_path = path # Store the full path
            self.listbox.add(row)
        self.listbox.show_all()

    def on_add_clicked(self, button: Gtk.Button):
        dialog = Gtk.FileChooserDialog(
            title="Please choose a file to attach",
            parent=self.parent_window,
            action=Gtk.FileChooserAction.OPEN
        )
        dialog.add_buttons(
            Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
            Gtk.STOCK_OPEN, Gtk.ResponseType.OK,
        )
        response = dialog.run()
        if response == Gtk.ResponseType.OK:
            selected_file = dialog.get_filename()
            if selected_file:
                # Copy file to attachments directory
                try:
                    dest_dir = ATTACHMENTS_DIR
                    Path(dest_dir).mkdir(parents=True, exist_ok=True)
                    dest_filename = f"{datetime.datetime.now().strftime('%Y%m%d_%H%M%S')}_{os.path.basename(selected_file)}"
                    dest_path = os.path.join(dest_dir, dest_filename)
                    shutil.copy2(selected_file, dest_path)
                    self.attachments.append(dest_path)
                    self._populate_listbox()
                    logger.info(f"Attachment added: {dest_path}")
                except Exception as e:
                    logger.error(f"Failed to copy attachment: {e}")
                    show_error_dialog(self.parent_window, f"Failed to add attachment: {e}")
        dialog.destroy()

    def on_remove_clicked(self, button: Gtk.Button):
        selected_row = self.listbox.get_selected_row()
        if selected_row:
            file_path = selected_row.file_path
            try:
                # Optionally remove the file from disk
                # os.remove(file_path)
                self.attachments.remove(file_path)
                self._populate_listbox()
                self.remove_button.set_sensitive(False)
                logger.info(f"Attachment removed: {file_path}")
            except Exception as e:
                logger.error(f"Failed to remove attachment reference: {e}")
                show_error_dialog(self.parent_window, f"Failed to remove attachment: {e}")

    def on_row_selected(self, listbox: Gtk.ListBox, row: Gtk.ListBoxRow):
        self.remove_button.set_sensitive(row is not None)

    def get_attachments(self) -> List[str]:
        return self.attachments.copy()

