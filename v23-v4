    def refresh_views(self):
        try:
            vessels = self.db.get_vessels()
            vessel_dict = {v.id: v for v in vessels}
            suppliers = self.db.get_suppliers()
            supplier_dict = {s.id: s.name for s in suppliers}

            self.vessels_store.clear()
            for vessel in vessels:
                self.vessels_store.append([vessel.id, vessel.name, vessel.vessel_type, vessel.engine_hours])

            # Refresh Maintenance with dynamic status and populate master store
            self.master_maintenance_store.clear() # Clear the master store
            tasks = self.db.get_maintenance_tasks()
            due_soon_days = self.config.get("due_soon_days", 7)
            for task in tasks:
                 vessel = vessel_dict.get(task.vessel_id, Vessel())
                 status_enum = task.get_status(vessel.engine_hours, due_soon_days)
                 priority_name = task.priority.display_name() if task.priority else "Medium"
                 # Populate master store with all necessary data for filtering
                 self.master_maintenance_store.append([
                     task.id, task.vessel_name, task.system, task.task_name, 
                     task.next_due, status_enum.name, priority_name # Add priority for filtering
                 ])
            # Refilter the view
            self.maintenance_filter.refilter()

            self.inventory_store.clear()
            items = self.db.get_inventory()
            for item in items:
                self.inventory_store.append([item.id, item.name, item.part_number, item.current_stock])

            self.trips_store.clear()
            logs = self.db.get_trip_logs()
            for log in logs:
                vessel_name = vessel_dict.get(log.vessel_id, Vessel()).name if log.vessel_id else "Unknown Vessel"
                self.trips_store.append([log.id, vessel_name, log.departure, log.arrival, log.origin, log.destination])

            self.suppliers_store.clear()
            for supplier in suppliers:
                self.suppliers_store.append([supplier.id, supplier.name, supplier.contact])
                
            # Refresh Dashboard
            self._refresh_dashboard()

            self.update_status_bar()
        except Exception as e:
            logger.error(f"Error refreshing views: {e}", exc_info=True)
            show_error_dialog(self, f"Error refreshing views: {e}")

    def _refresh_dashboard(self):
        """Refresh the dashboard summary and lists."""
        tasks = self.db.get_maintenance_tasks()
        vessels = {v.id: v for v in self.db.get_vessels()}
        due_soon_days = self.config.get("due_soon_days", 7)

        overdue_count = 0
        due_soon_count = 0
        on_schedule_count = 0
        completed_count = 0 # Placeholder

        self.upcoming_store.clear()
        upcoming_tasks = []
        for task in tasks:
             vessel = vessels.get(task.vessel_id, Vessel())
             status_enum = task.get_status(vessel.engine_hours, due_soon_days)
             if status_enum == Status.OVERDUE:
                 overdue_count += 1
             elif status_enum == Status.DUE_SOON:
                 due_soon_count += 1
                 upcoming_tasks.append((task, status_enum))
             elif status_enum == Status.ON_SCHEDULE:
                 on_schedule_count += 1

        upcoming_tasks.sort(key=lambda x: x[0].next_due if x[0].next_due else "9999-99-99")
        for task, status_enum in upcoming_tasks[:5]:
            self.upcoming_store.append([task.id, task.vessel_name, task.system, task.task_name, task.next_due, status_enum.name])

        self.low_stock_store.clear()
        low_stock_items = self.db.get_inventory(low_stock_only=True)
        for item in low_stock_items:
            self.low_stock_store.append([item.id, item.name, item.part_number, item.current_stock])

        self.overdue_label.set_markup(f'<span foreground="red"><b>Overdue:</b> {overdue_count}</span>')
        self.due_soon_label.set_markup(f'<span foreground="orange"><b>Due Soon:</b> {due_soon_count}</span>')
        self.on_schedule_label.set_markup(f'<span foreground="green"><b>On Schedule:</b> {on_schedule_count}</span>')
        self.completed_label.set_markup(f'<span><b>Completed (Last 30d):</b> {completed_count}</span>')

    def update_status_bar(self):
        if not hasattr(self, 'status_bar'):
            logger.debug("Status bar not initialized yet.")
            return
        page_num = self.notebook.get_current_page()
        if page_num < 0:
             self.status_bar.push(self.status_context_id, "Ready")
             return
        page_widget = self.notebook.get_nth_page(page_num)
        if page_widget is None:
            return
        page_title = self.notebook.get_tab_label_text(page_widget)
        if not page_title:
             page_title = "Unknown"

        if page_title == "Service Guide":
            msg = "Service Guide: Reference Chart"
        elif page_title == "Dashboard":
             msg = "Dashboard: Summary Overview"
        else:
            count = 0
            if page_title == "Vessels":
                count = len(self.vessels_store)
            elif page_title == "Maintenance":
                count = len(self.master_maintenance_store) # Use master store for accurate count
            elif page_title == "Inventory":
                count = len(self.inventory_store)
            elif page_title == "Trip Logs":
                count = len(self.trips_store)
            elif page_title == "Suppliers":
                count = len(self.suppliers_store)
            msg = f"{page_title}: {count} items"
            
        self.status_bar.remove_all(self.status_context_id)
        self.status_bar.push(self.status_context_id, msg)

