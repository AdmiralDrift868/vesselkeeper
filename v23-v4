    def get_inventory(self, low_stock_only: bool = False) -> List[InventoryItem]:
        cursor = self.conn.cursor()
        query = "SELECT id, name, part_number, category, system, location, current_stock, minimum_stock, supplier_id, unit_cost, specifications, attachments FROM inventory"
        if low_stock_only:
            query += " WHERE current_stock <= minimum_stock"
        cursor.execute(query)
        items = []
        for row in cursor.fetchall():
            row_dict = dict(row)
            if row_dict.get('attachments'):
                try:
                    row_dict['attachments'] = json.loads(row_dict['attachments'])
