class VesselKeeperApp(Gtk.ApplicationWindow):
    def __init__(self, app: Gtk.Application):
        super().__init__(application=app, title="VesselKeeper")
        self.db = Database(DB_PATH)
        self.config = self._load_config()
        self.set_default_size(
            self.config.get("window_width", DEFAULT_CONFIG["window_width"]),
            self.config.get("window_height", DEFAULT_CONFIG["window_height"])
        )
        x = self.config.get("window_x", DEFAULT_CONFIG["window_x"])
        y = self.config.get("window_y", DEFAULT_CONFIG["window_y"])
        if x >= 0 and y >= 0:
            self.move(x, y)
        else:
            self.set_position(Gtk.WindowPosition.CENTER)
        try:
            self.set_icon_name("boat")
        except Exception:
            self.set_icon_name("dialog-information")
            
        self.status_bar = Gtk.Statusbar()
        self.status_context_id = self.status_bar.get_context_id("main")
        self._setup_ui()
        self.refresh_views()
        last_tab = self.config.get("last_active_tab", 0)
        if 0 <= last_tab < self.notebook.get_n_pages():
            self.notebook.set_current_page(last_tab)
        GLib.idle_add(self.update_status_bar)
        self.show_all()

    def _load_config(self) -> Dict[str, Any]:
        if os.path.exists(CONFIG_PATH):
            try:
                with open(CONFIG_PATH, 'r') as f:
                    config = json.load(f)
                    for key, value in DEFAULT_CONFIG.items():
                        if key not in config:
                            config[key] = value
                    return config
            except (json.JSONDecodeError, IOError) as e:
                logger.warning(f"Error reading config file: {e}. Using defaults.")
        return DEFAULT_CONFIG.copy()

    def _save_config(self):
        width, height = self.get_size()
        x, y = self.get_position()
        self.config["window_width"] = width
        self.config["window_height"] = height
        self.config["window_x"] = x
        self.config["window_y"] = y
        self.config["last_active_tab"] = self.notebook.get_current_page()

        try:
            Path(CONFIG_PATH).parent.mkdir(parents=True, exist_ok=True)
            with open(CONFIG_PATH, 'w') as f:
                json.dump(self.config, f, indent=4)
            logger.info("Configuration saved.")
