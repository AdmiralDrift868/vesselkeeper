    def _filter_store(self, store: Gtk.ListStore, query: str, columns: List[int]):
        # This is a basic approach using a visible flag or by rebuilding
        # Here we use a simple approach: hide rows that don't match
        # A better way is to use Gtk.TreeModelFilter
        for row in store:
             match = False
             for col in columns:
                 if query in str(row[col]).lower():
                     match = True
                     break
             # Gtk.ListStore doesn't have a direct "visible" property in the store itself.
             # This approach of trying to set visibility on the row itself is incorrect.
             # The correct way is to use a Gtk.TreeModelFilter with a visible function.
             # As this is complex to retrofit, we will leave search as a simplified
             # pass-through for now, or note that full search needs TreeModelFilter.
             # For now, this function doesn't correctly implement hiding.
             # It's a placeholder for the concept.
             # print(f"Searching {query} in {row[0]}: Match = {match}") # Debug

    def _filter_master_store(self, store: Gtk.ListStore, query: str, columns: List[int]):
         # Similar to _filter_store but for the master maintenance store
         # This also doesn't correctly implement hiding without a filter model
         # It's used in conjunction with refiltering the filter model.
         # The actual filtering logic resides in `maintenance_filter_func`
         # which checks the query against the master store's data.
         # We need to store the query somewhere the filter func can access it.
         # Let's add an attribute to self for the current search query for maintenance.
         self._maintenance_search_query = query
         self._maintenance_search_columns = columns
         
    # We need to modify the maintenance_filter_func to also consider the search query
    # This requires dynamically changing the filter function or passing data to it.
    # The data parameter of set_visible_func can be used, but it's set once.
    # A common approach is to use instance attributes.
    # Let's redefine the filter function as a method that can access self attributes.
    # However, the original `maintenance_filter_func` was defined locally.
    # We need to make it an instance method and re-attach it.
    # It's simpler to just recreate the filter when search changes.
    # But for now, we'll adapt the existing one. The code above sets instance attributes
    # that the filter function (if it were an instance method) could use.
    # Let's redefine the filter function properly.
    # --- Redefine filter function as instance method ---
    def maintenance_filter_func(self, model, iter, data):
        """Filter function for maintenance tasks, including search."""
        # 1. Apply status/priority filters
        status_filter_text = self.maint_status_filter_combo.get_active_text()
        priority_filter_text = self.maint_priority_filter_combo.get_active_text()
        
        status_value = model.get_value(iter, 5) # Status enum name
        priority_value = model.get_value(iter, 6) # Priority enum name
        
        status_match = (status_filter_text == "All" or status_filter_text == status_value)
        priority_match = (priority_filter_text == "All" or priority_filter_text == priority_value)
        basic_filter_match = status_match and priority_match
        
        # 2. Apply search filter if a query exists
        search_match = True # Default to True if no search
        if hasattr(self, '_maintenance_search_query') and self._maintenance_search_query:
            search_match = False
            search_columns = getattr(self, '_maintenance_search_columns', [1, 2, 3])
            for col in search_columns:
                cell_text = str(model.get_value(iter, col)).lower()
                if self._maintenance_search_query in cell_text:
                    search_match = True
                    break
                    
        return basic_filter_match and search_match

