                    flags=0,
                    message_type=Gtk.MessageType.QUESTION,
                    buttons=Gtk.ButtonsType.YES_NO,
                    text=f"Mark task '{task.task_name}' as completed?"
                )
                dialog.format_secondary_text("This will update the 'Last Completed' date and calculate the new 'Next Due' date.")
                response = dialog.run()
                dialog.destroy()

                if response == Gtk.ResponseType.YES:
                    try:
                        task.last_completed = datetime.date.today().strftime("%Y-%m-%d")
                        if task.interval_type == IntervalType.DAYS and task.interval_value > 0:
                            last_date = datetime.datetime.strptime(task.last_completed, "%Y-%m-%d").date()
                            next_due_date = last_date + datetime.timedelta(days=task.interval_value)
                            task.next_due = next_due_date.strftime("%Y-%m-%d")
                        elif task.interval_type in [IntervalType.HOURS, IntervalType.USAGE_CYCLES]:
                            vessels = [v for v in self.db.get_vessels() if v.id == task.vessel_id]
                            if vessels:
                                task.last_hours = vessels[0].engine_hours
                                # next_due is not used for status in hour-based tasks, but we can clear it
                                # task.next_due = ""
                        self.db.update_maintenance_task(task)
                        self.refresh_views()
                        logger.info(f"Marked task {task_id} as completed.")
                        show_info_dialog(self, f"Task '{task.task_name}' marked as completed.")
                    except Exception as e:
                        logger.error(f"Error marking task as completed: {e}")
                        show_error_dialog(self, f"Error marking task as completed: {e}")

    # --- Import Data Handler ---
    def on_import_data(self, widget: Gtk.Widget):
        dialog = Gtk.FileChooserDialog(
            title="Please choose a CSV file to import",
            parent=self,
            action=Gtk.FileChooserAction.OPEN
        )
        dialog.add_buttons(
            Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
            Gtk.STOCK_OPEN, Gtk.ResponseType.OK,
        )
        filter_csv = Gtk.FileFilter()
        filter_csv.set_name("CSV files")
        filter_csv.add_mime_type("text/csv")
        filter_csv.add_pattern("*.csv")
        dialog.add_filter(filter_csv)

        response = dialog.run()
        if response == Gtk.ResponseType.OK:
            import_file = dialog.get_filename()
            dialog.destroy()
            try:
                self.db.import_data_from_csv(import_file)
                self.refresh_views()
                show_info_dialog(self, f"Data imported successfully from:\n{import_file}")
            except Exception as e:
                show_error_dialog(self, f"Failed to import data: {e}")
        else:
            dialog.destroy()

