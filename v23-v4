    def do_destroy(self):
        self._save_config()
        self.db.close()
        Gtk.ApplicationWindow.do_destroy(self)

# --- Application ---
class Application(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="com.example.VesselKeeper")

    def do_activate(self):
        win = self.props.active_window
        if not win:
            win = VesselKeeperApp(self)
        win.present()

def main():
    app = Application()
    app.run()

if __name__ == "__main__":
    main()
