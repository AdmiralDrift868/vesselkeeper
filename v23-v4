    def on_adjust_stock_activate(self, menuitem: Gtk.MenuItem, model: Gtk.TreeModel, paths: List[Gtk.TreePath]):
        dialog = Gtk.Dialog(title="Adjust Stock", transient_for=self, flags=0)
        dialog.add_buttons(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL, Gtk.STOCK_OK, Gtk.ResponseType.OK)
        dialog.set_default_size(300, 150)

        content = dialog.get_content_area()
        content.set_border_width(10)
        grid = Gtk.Grid(column_spacing=10, row_spacing=10)
        content.pack_start(grid, True, True, 0)

        grid.attach(Gtk.Label(label="Adjustment Amount:"), 0, 0, 1, 1)
        adjustment_spin = Gtk.SpinButton.new_with_range(-1000, 1000, 1)
        adjustment_spin.set_value(1)
        grid.attach(adjustment_spin, 1, 0, 1, 1)

        response = dialog.run()
        if response == Gtk.ResponseType.OK:
            adjustment = int(adjustment_spin.get_value())
            ids_to_update = []
            for path in paths:
                iter = model.get_iter(path)
                item_id = model.get_value(iter, 0)
                ids_to_update.append(item_id)

            try:
                for item_id in ids_to_update:
                    items = [i for i in self.db.get_inventory() if i.id == item_id]
                    if items:
                        item = items[0]
                        new_stock = item.current_stock + adjustment
                        if new_stock < 0:
                            new_stock = 0
                        item.current_stock = new_stock
                        self.db.update_inventory_item(item)
                self.refresh_views()
                logger.info(f"Adjusted stock for {len(ids_to_update)} items by {adjustment}.")
            except Exception as e:
                logger.error(f"Error adjusting stock: {e}")
                show_error_dialog(self, f"Error adjusting stock: {e}")
        dialog.destroy()

