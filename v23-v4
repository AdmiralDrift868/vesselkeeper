    # --- UI Event Handlers ---
    def on_add_vessel(self, widget: Gtk.Widget):
        self._handle_add(VesselEditor, self.db.add_vessel, self.refresh_views)

    def on_vessel_row_activated(self, treeview: Gtk.TreeView, path: Gtk.TreePath, column: Gtk.TreeViewColumn):
        model = treeview.get_model()
        row_id = model.get_value(model.get_iter(path), 0)
        vessel = next((v for v in self.db.get_vessels() if v.id == row_id), None)
        if vessel:
            self._handle_edit(VesselEditor, vessel, self.db.update_vessel, self.refresh_views, self.db.delete_vessel)

    def on_add_maintenance_task(self, widget: Gtk.Widget):
        self._handle_add(MaintenanceTaskEditor, self.db.add_maintenance_task, self.refresh_views)

    def on_maintenance_row_activated(self, treeview: Gtk.TreeView, path: Gtk.TreePath, column: Gtk.TreeViewColumn):
        # Get the ID from the filtered model iter by converting it to the master model iter
        model = treeview.get_model() # This is the filter model
        filter_iter = model.get_iter(path)
        master_iter = model.convert_iter_to_child_iter(filter_iter)
        # Get ID from the master store
        row_id = self.master_maintenance_store.get_value(master_iter, 0)
        
        task = next((t for t in self.db.get_maintenance_tasks() if t.id == row_id), None)
        if task:
            self._handle_edit(MaintenanceTaskEditor, task, self.db.update_maintenance_task, self.refresh_views, self.db.delete_maintenance_task)

