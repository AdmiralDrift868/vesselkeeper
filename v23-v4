class ReportDialog(Gtk.Dialog):
    def __init__(self, parent: Gtk.Window, db: Database, report_type: str, config: Dict[str, Any]):
        super().__init__(title=f"{report_type} Report", transient_for=parent, flags=0)
        self.db = db
        self.report_type = report_type
        self.config = config
        self.set_default_size(800, 600)
        self._setup_ui()
        self._populate_report()

    def _setup_ui(self):
        content = self.get_content_area()
        content.set_border_width(10)
        self.store = Gtk.ListStore()
        self.treeview = Gtk.TreeView(model=self.store)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scroll.add(self.treeview)
        content.pack_start(scroll, True, True, 0)
        self.add_button("Close", Gtk.ResponseType.CLOSE)
        self.add_button("Export to CSV", Gtk.ResponseType.APPLY)

    def _populate_report(self):
        if self.report_type == "Low Stock":
            self._populate_low_stock()
        elif self.report_type == "Maintenance Due":
             self._populate_maintenance_due()

    def _populate_low_stock(self):
        self.store.clear()
        self.store.set_column_types([int, str, str, int, int, str])
        for i, title in enumerate(["ID", "Name", "Part Number", "Current Stock", "Min Stock", "Supplier"]):
            renderer = Gtk.CellRendererText()
            column = Gtk.TreeViewColumn(title, renderer, text=i)
            column.set_sort_column_id(i)
            self.treeview.append_column(column)

        items = self.db.get_inventory(low_stock_only=True)
        suppliers = {s.id: s.name for s in self.db.get_suppliers()}
        for item in items:
            supplier_name = suppliers.get(item.supplier_id, "None")
            self.store.append([
                item.id or 0,
                item.name,
                item.part_number,
                item.current_stock,
                item.minimum_stock,
                supplier_name
            ])

    def _populate_maintenance_due(self):
        self.store.clear()
        self.store.set_column_types([int, str, str, str, str, str, str, float])
        for i, title in enumerate(["ID", "Vessel", "System", "Task", "Date", "Status", "Priority", "Cost ($)"]):
            renderer = Gtk.CellRendererText()
            column = Gtk.TreeViewColumn(title, renderer, text=i)
            column.set_sort_column_id(i)
            self.treeview.append_column(column)

        tasks = self.db.get_maintenance_tasks()
        vessels = {v.id: v for v in self.db.get_vessels()}
        due_soon_days = self.config.get("due_soon_days", 7)
        for task in tasks:
            vessel = vessels.get(task.vessel_id, Vessel())
            status = task.get_status(vessel.engine_hours, due_soon_days).display_name()
            date_str = task.next_due if task.next_due else task.last_completed
            priority_name = task.priority.display_name() if task.priority else "Medium"
            self.store.append([
                task.id or 0,
                task.vessel_name,
                task.system,
                task.task_name,
                date_str,
                status,
                priority_name,
                task.total_job_cost
            ])

    def do_response(self, response_id):
        if response_id == Gtk.ResponseType.APPLY:
            self._export_to_csv()
        elif response_id == Gtk.ResponseType.CLOSE:
            self.destroy()

    def _export_to_csv(self):
        dialog = Gtk.FileChooserDialog(
            title="Save Report as CSV",
            parent=self,
            action=Gtk.FileChooserAction.SAVE
        )
        dialog.add_buttons(
            Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
            Gtk.STOCK_SAVE, Gtk.ResponseType.ACCEPT,
        )
        dialog.set_current_name(f"{self.report_type.replace(' ', '_')}_report.csv")
        response = dialog.run()
        if response == Gtk.ResponseType.ACCEPT:
            filename = dialog.get_filename()
            dialog.destroy()
            try:
                with open(filename, 'w', newline='', encoding='utf-8') as csvfile:
                    writer = csv.writer(csvfile)
                    header = [self.treeview.get_column(i).get_title() for i in range(self.treeview.get_n_columns())]
                    writer.writerow(header)
                    for row in self.store:
                        writer.writerow(row)
                show_info_dialog(self, f"Report exported to: {filename}")
            except Exception as e:
                show_error_dialog(self, f"Failed to export report: {e}")
        else:
            dialog.destroy()

