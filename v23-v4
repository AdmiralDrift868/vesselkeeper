        ))
        self.conn.commit()
        logger.info(f"Updated trip log ID: {log.id}")
        if log.vessel_id and log.end_hours > 0:
             cursor.execute("UPDATE vessels SET engine_hours = ? WHERE id = ?", (log.end_hours, log.vessel_id))
             logger.info(f"Updated vessel {log.vessel_id} engine hours to {log.end_hours} based on trip log {log.id}")
