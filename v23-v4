    def on_show_reports(self, widget: Gtk.Widget):
        menu = Gtk.Menu()
        low_stock_item = Gtk.MenuItem(label="Low Stock Report")
        low_stock_item.connect("activate", lambda w: ReportDialog(self, self.db, "Low Stock", self.config).show())
        menu.append(low_stock_item)

