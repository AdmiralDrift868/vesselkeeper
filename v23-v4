        self.destination_entry = self._add_form_field(4, "Destination:", Gtk.Entry())
        self.start_hours_entry = self._add_form_field(5, "Start Engine Hours:", Gtk.SpinButton.new_with_range(0, 100000, 0.1))
        self.end_hours_entry = self._add_form_field(6, "End Engine Hours:", Gtk.SpinButton.new_with_range(0, 100000, 0.1))
        self.fuel_used_entry = self._add_form_field(7, "Fuel Used:", Gtk.SpinButton.new_with_range(0, 10000, 0.1), units="L")
        self.distance_entry = self._add_form_field(8, "Distance:", Gtk.SpinButton.new_with_range(0, 100000, 0.1), units="nm")
        self.crew_entry = self._add_form_field(9, "Crew:", Gtk.Entry())
        self.log_entries_entry = self._add_form_field(10, "Log Entries:", Gtk.TextView(), multiline=True)
        # Attachment Widget
        self.attachment_widget = AttachmentWidget(self, self.item.attachments if self.item else [])
        self.grid.attach(self.attachment_widget, 0, 11, 2, 1)

    def _load_existing_data(self):
        if not self.item:
            return
        log: TripLog = self.item
        vessel_names = [v.name for v in self.vessels]
        if log.vessel_id:
            matching_vessel = next((v for v in self.vessels if v.id == log.vessel_id), None)
            if matching_vessel and matching_vessel.name in vessel_names:
                idx = vessel_names.index(matching_vessel.name)
                self.vessel_combo.set_active(idx)
        self.departure_entry.set_text(log.departure)
        self.arrival_entry.set_text(log.arrival)
        self.origin_entry.set_text(log.origin)
        self.destination_entry.set_text(log.destination)
        self.start_hours_entry.set_value(log.start_hours)
        self.end_hours_entry.set_value(log.end_hours)
        self.fuel_used_entry.set_value(log.fuel_used)
        self.distance_entry.set_value(log.distance)
        self.crew_entry.set_text(log.crew)
        buffer = self.log_entries_entry.get_buffer()
        buffer.set_text(log.log_entries)

    def get_data(self) -> TripLog:
        buffer = self.log_entries_entry.get_buffer()
        start_iter, end_iter = buffer.get_bounds()
        vessel_id = self.vessels[self.vessel_combo.get_active()].id if self.vessel_combo.get_active() >= 0 and self.vessels else 0
        return TripLog(
            id=self.item.id if self.item else None,
            vessel_id=vessel_id,
            departure=self.departure_entry.get_text(),
            arrival=self.arrival_entry.get_text(),
            origin=self.origin_entry.get_text().strip(),
            destination=self.destination_entry.get_text().strip(),
            start_hours=self.start_hours_entry.get_value(),
            end_hours=self.end_hours_entry.get_value(),
            fuel_used=self.fuel_used_entry.get_value(),
            distance=self.distance_entry.get_value(),
            crew=self.crew_entry.get_text().strip(),
            log_entries=buffer.get_text(start_iter, end_iter, False).strip(),
            attachments=self.attachment_widget.get_attachments()
        )

    def validate(self) -> bool:
        if self.vessel_combo.get_active() < 0:
            show_error_dialog(self, "Please select a vessel.")
            self.vessel_combo.grab_focus()
            return False
        if not self.departure_entry.get_text().strip():
            show_error_dialog(self, "Departure date is required.")
            self.departure_entry.entry.grab_focus()
            return False
        if self.departure_entry.get_text() and not self.departure_entry.validate_date():
            show_error_dialog(self, "Departure date format is invalid. Please use YYYY-MM-DD.")
            self.departure_entry.entry.grab_focus()
            return False
        if self.arrival_entry.get_text() and not self.arrival_entry.validate_date():
            show_error_dialog(self, "Arrival date format is invalid. Please use YYYY-MM-DD.")
            self.arrival_entry.entry.grab_focus()
            return False
        start_hours = self.start_hours_entry.get_value()
        end_hours = self.end_hours_entry.get_value()
        if end_hours < start_hours:
            show_error_dialog(self, "End Engine Hours cannot be less than Start Engine Hours.")
            self.end_hours_entry.grab_focus()
            return False
        fuel_used = self.fuel_used_entry.get_value()
        distance = self.distance_entry.get_value()
        if fuel_used < 0:
            show_error_dialog(self, "Fuel used cannot be negative.")
            self.fuel_used_entry.grab_focus()
            return False
        if distance < 0:
            show_error_dialog(self, "Distance cannot be negative.")
            self.distance_entry.grab_focus()
            return False
        return True

