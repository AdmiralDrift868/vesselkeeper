class DatePickerEntry(Gtk.Box):
    def __init__(self, date_format: str = "%Y-%m-%d"):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.date_format = date_format
        self.entry = Gtk.Entry()
        self.entry.set_hexpand(True)
        self.entry.set_placeholder_text("YYYY-MM-DD")
        self.pack_start(self.entry, True, True, 0)
        self.popover = Gtk.Popover()
        self.calendar = Gtk.Calendar()
        self.calendar.connect("day-selected", self.on_calendar_day_selected)
        self.popover.add(self.calendar)
        button = Gtk.Button()
        button.set_image(Gtk.Image.new_from_icon_name("x-office-calendar-symbolic", Gtk.IconSize.BUTTON))
        button.set_relief(Gtk.ReliefStyle.NONE)
        button.set_tooltip_text("Select Date")
        self.pack_start(button, False, False, 0)
        self.popover.set_relative_to(button)
        button.connect("clicked", lambda b: self.popover.show_all())
        # Real-time validation feedback
        self.entry.connect("changed", self.on_entry_changed)
        self.validation_label = Gtk.Label()
        self.validation_label.set_no_show_all(True)
        self.pack_start(self.validation_label, False, False, 0)

    def on_entry_changed(self, entry: Gtk.Entry):
        text = entry.get_text().strip()
        if text:
            try:
                datetime.datetime.strptime(text, self.date_format)
                self.validation_label.set_text("")
                self.validation_label.hide()
                entry.get_style_context().remove_class("error")
            except ValueError:
                self.validation_label.set_text("Invalid date")
                self.validation_label.show()
                entry.get_style_context().add_class("error")
        else:
            self.validation_label.set_text("")
            self.validation_label.hide()
            entry.get_style_context().remove_class("error")

    def on_calendar_day_selected(self, calendar: Gtk.Calendar):
        year, month, day = calendar.get_date()
        selected_date = datetime.date(year, month + 1, day)
        self.entry.set_text(selected_date.strftime(self.date_format))
        self.popover.hide()
        self.on_entry_changed(self.entry) # Trigger validation

    def get_text(self) -> str:
        return self.entry.get_text().strip()

    def set_text(self, text: str):
        self.entry.set_text(text.strip() if text else "")

    def validate_date(self) -> bool:
        text = self.get_text()
        if not text:
            return True
        try:
            datetime.datetime.strptime(text, self.date_format)
            return True
        except ValueError:
            return False

