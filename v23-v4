# --- Database ---
class Database:
    def __init__(self, db_path: str):
        self.db_path = db_path
        Path(self.db_path).parent.mkdir(parents=True, exist_ok=True)
        # Use check_same_thread=True for safety, ensure all DB calls on main thread
        self.conn: sqlite3.Connection = sqlite3.connect(self.db_path, check_same_thread=True)
        self.conn.row_factory = sqlite3.Row
        # Enable foreign key constraints
        self.conn.execute("PRAGMA foreign_keys = ON;")
        fk_status = self.conn.execute("PRAGMA foreign_keys;").fetchone()[0]
        if fk_status != 1:
            logger.warning("Foreign key constraints are NOT enabled!")
        else:
            logger.debug("Foreign key constraints are enabled.")
        self._init_tables()

    def _init_tables(self):
        cursor = self.conn.cursor()
        
        # Check if inventory table exists and has supplier_id column
        cursor.execute("PRAGMA table_info(inventory)")
        columns = cursor.fetchall()
        column_names = [col[1] for col in columns]
        if 'supplier_id' not in column_names:
            if columns:
                logger.info("Adding 'supplier_id' column to existing 'inventory' table.")
                cursor.execute("ALTER TABLE inventory ADD COLUMN supplier_id INTEGER REFERENCES suppliers(id)")
        else:
            logger.debug("'supplier_id' column already exists in 'inventory' table.")

        # Check for maintenance task cost columns
        cursor.execute("PRAGMA table_info(maintenance_tasks)")
        mt_columns = cursor.fetchall()
        mt_column_names = [col[1] for col in mt_columns]
        if 'labor_cost' not in mt_column_names:
             if mt_columns:
                logger.info("Adding 'labor_cost' column to existing 'maintenance_tasks' table.")
                cursor.execute("ALTER TABLE maintenance_tasks ADD COLUMN labor_cost REAL DEFAULT 0")
        if 'total_parts_cost' not in mt_column_names:
             if mt_columns:
                logger.info("Adding 'total_parts_cost' column to existing 'maintenance_tasks' table.")
                cursor.execute("ALTER TABLE maintenance_tasks ADD COLUMN total_parts_cost REAL DEFAULT 0")

        # Check for attachment columns (as JSON text)
        attachment_columns = [
            ('vessels', 'attachments'),
            ('maintenance_tasks', 'attachments'),
            ('inventory', 'attachments'),
            ('trip_logs', 'attachments'),
            ('suppliers', 'attachments')
        ]
        for table, col_name in attachment_columns:
            cursor.execute(f"PRAGMA table_info({table})")
            table_cols = cursor.fetchall()
            table_col_names = [col[1] for col in table_cols]
            if col_name not in table_col_names:
                if table_cols:
                    logger.info(f"Adding '{col_name}' column to existing '{table}' table.")
                    cursor.execute(f"ALTER TABLE {table} ADD COLUMN {col_name} TEXT") # Store as JSON string

        # Check for task templates table
        cursor.execute("PRAGMA table_info(task_templates)")
        template_columns = cursor.fetchall()
        if not template_columns:
            logger.info("Creating 'task_templates' table.")
            cursor.execute("""
            CREATE TABLE task_templates (
                id INTEGER PRIMARY KEY,
                name TEXT NOT NULL,
                system TEXT,
                task_name TEXT NOT NULL,
                interval_type TEXT,
                interval_value INTEGER,
                priority TEXT,
                parts_required TEXT, -- JSON list of inventory item IDs
                instructions TEXT
            );
            """)

        cursor.executescript("""
        CREATE TABLE IF NOT EXISTS vessels (
            id INTEGER PRIMARY KEY,
            name TEXT NOT NULL,
            registration TEXT,
            vessel_type TEXT,
            length REAL,
            beam REAL,
            draft REAL,
            engine_model TEXT,
            engine_hours REAL DEFAULT 0,
            hull_material TEXT,
            build_year INTEGER,
            last_survey TEXT,
            insurance_expiry TEXT,
            current_location TEXT,
            notes TEXT,
            attachments TEXT -- JSON list of file paths
        );
        CREATE TABLE IF NOT EXISTS maintenance_tasks (
            id INTEGER PRIMARY KEY,
            vessel_id INTEGER REFERENCES vessels(id) ON DELETE CASCADE,
            system TEXT,
            task_name TEXT NOT NULL,
            template_id INTEGER,
            interval_type TEXT,
            interval_value INTEGER,
            last_completed TEXT,
            last_hours REAL,
            next_due TEXT,
            priority TEXT,
            parts_required TEXT, -- JSON list of inventory item IDs
            instructions TEXT,
            labor_cost REAL DEFAULT 0,
            total_parts_cost REAL DEFAULT 0,
            attachments TEXT -- JSON list of file paths
        );
        CREATE TABLE IF NOT EXISTS inventory (
            id INTEGER PRIMARY KEY,
            name TEXT NOT NULL,
            part_number TEXT,
            category TEXT,
            system TEXT,
            location TEXT,
            current_stock INTEGER DEFAULT 0,
            minimum_stock INTEGER DEFAULT 0,
            supplier_id INTEGER REFERENCES suppliers(id) ON DELETE SET NULL,
            unit_cost REAL DEFAULT 0,
            specifications TEXT,
            attachments TEXT -- JSON list of file paths
        );
        CREATE TABLE IF NOT EXISTS trip_logs (
            id INTEGER PRIMARY KEY,
            vessel_id INTEGER REFERENCES vessels(id) ON DELETE CASCADE,
            departure TEXT NOT NULL,
            arrival TEXT,
            origin TEXT,
            destination TEXT,
            start_hours REAL,
            end_hours REAL,
            fuel_used REAL,
            distance REAL,
            crew TEXT,
            log_entries TEXT,
            attachments TEXT -- JSON list of file paths
        );
        CREATE TABLE IF NOT EXISTS suppliers (
            id INTEGER PRIMARY KEY,
            name TEXT NOT NULL,
            contact TEXT,
            phone TEXT,
            email TEXT,
            notes TEXT,
            attachments TEXT -- JSON list of file paths
        );
        """)
        self.conn.commit()

    def close(self):
        try:
            self.conn.close()
            logger.info("Database connection closed.")
        except Exception as e:
            logger.error(f"Error closing DB: {e}")

    # --- Vessels ---
    def add_vessel(self, vessel: Vessel) -> int:
        cursor = self.conn.cursor()
        cursor.execute("""
            INSERT INTO vessels (name, registration, vessel_type, length, beam, draft, engine_model, engine_hours, hull_material, build_year, last_survey, insurance_expiry, current_location, notes, attachments)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            vessel.name, vessel.registration, vessel.vessel_type,
            vessel.length, vessel.beam, vessel.draft, vessel.engine_model,
            vessel.engine_hours, vessel.hull_material, vessel.build_year,
            vessel.last_survey, vessel.insurance_expiry, vessel.current_location, vessel.notes,
            json.dumps(vessel.attachments) if vessel.attachments else None
        ))
        self.conn.commit()
        vessel_id = cursor.lastrowid
        logger.info(f"Added vessel: {vessel.name} (ID: {vessel_id})")
        return vessel_id # type: ignore

