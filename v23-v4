    def backup_database(self) -> str:
        timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        backup_filename = f"backup_{timestamp}.db"
        backup_path = os.path.join(BACKUP_DIR, backup_filename)
        try:
            shutil.copy2(self.db_path, backup_path)
            logger.info(f"Database backed up to: {backup_path}")
            return backup_path
        except Exception as e:
            logger.error(f"Failed to backup database: {e}")
            raise Exception(f"Backup failed: {e}")

    def export_data_to_csv(self, export_dir: str):
        Path(export_dir).mkdir(parents=True, exist_ok=True)
        tables = {
            "vessels": self.get_vessels(),
            "maintenance_tasks": self.get_maintenance_tasks(),
            "inventory": self.get_inventory(),
            "trip_logs": self.get_trip_logs(),
            "suppliers": self.get_suppliers(),
            "task_templates": self.get_task_templates()
        }
        for table_name, data_list in tables.items():
            if not data_list:
                continue
            filename = os.path.join(export_dir, f"{table_name}.csv")
            try:
                with open(filename, 'w', newline='', encoding='utf-8') as csvfile:
                    if data_list:
                        fieldnames = list(asdict(data_list[0]).keys())
                        writer = csv.DictWriter(csvfile, fieldnames=fieldnames)
                        writer.writeheader()
                        for item in data_list:
                            item_dict = asdict(item)
                            # Convert complex fields to JSON strings for CSV
                            for key, value in item_dict.items():
                                if isinstance(value, (list, dict)):
                                    item_dict[key] = json.dumps(value)
                            writer.writerow(item_dict)
                logger.info(f"Exported {table_name} to {filename}")
            except Exception as e:
                logger.error(f"Failed to export {table_name}: {e}")
                raise Exception(f"Export failed for {table_name}: {e}")
        logger.info("Data export completed successfully.")

