        self.part_number_entry.set_text(item.part_number)
        self.category_entry.set_text(item.category)
        self.system_entry.set_text(item.system)
        self.location_entry.set_text(item.location)
        self.current_stock_entry.set_value(item.current_stock)
        self.minimum_stock_entry.set_value(item.minimum_stock)
        self.unit_cost_entry.set_value(item.unit_cost)
        self.specifications_entry.set_text(item.specifications)
        if item.supplier_id:
            matching_supplier = next((s for s in self.suppliers if s.id == item.supplier_id), None)
            if matching_supplier:
                supplier_names = ["None"] + [s.name for s in self.suppliers]
                if matching_supplier.name in supplier_names:
                    idx = supplier_names.index(matching_supplier.name)
                    self.supplier_combo.set_active(idx)
        else:
            self.supplier_combo.set_active(0)

    def get_data(self) -> InventoryItem:
        selected_supplier_id: Optional[int] = None
        active_index = self.supplier_combo.get_active()
        if active_index > 0 and active_index <= len(self.suppliers):
            selected_supplier_id = self.suppliers[active_index - 1].id
        return InventoryItem(
            id=self.item.id if self.item else None,
            name=self.name_entry.get_text().strip(),
            part_number=self.part_number_entry.get_text().strip(),
            category=self.category_entry.get_text().strip(),
            system=self.system_entry.get_text().strip(),
            location=self.location_entry.get_text().strip(),
            current_stock=int(self.current_stock_entry.get_value()),
            minimum_stock=int(self.minimum_stock_entry.get_value()),
            supplier_id=selected_supplier_id,
            unit_cost=self.unit_cost_entry.get_value(),
            specifications=self.specifications_entry.get_text().strip(),
            attachments=self.attachment_widget.get_attachments()
        )

    def validate(self) -> bool:
        if not self.name_entry.get_text().strip():
            show_error_dialog(self, "Item name is required.")
            self.name_entry.grab_focus()
            return False
        current_stock = int(self.current_stock_entry.get_value())
        minimum_stock = int(self.minimum_stock_entry.get_value())
        if current_stock < 0:
            show_error_dialog(self, "Current stock cannot be negative.")
            self.current_stock_entry.grab_focus()
            return False
        if minimum_stock < 0:
            show_error_dialog(self, "Minimum stock cannot be negative.")
            self.minimum_stock_entry.grab_focus()
            return False
        unit_cost = self.unit_cost_entry.get_value()
        if unit_cost < 0:
            show_error_dialog(self, "Unit cost cannot be negative.")
            self.unit_cost_entry.grab_focus()
            return False
        return True

