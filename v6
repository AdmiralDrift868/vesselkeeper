class ReportGenerator:
    @staticmethod
    def generate_low_stock_report(db: Database, config: Dict[str, Any], filename: str) -> bool:
        """Generate a low stock report."""
        try:
            items = db.get_inventory_items()
            low_stock_items = [item for item in items if item.current_stock <= item.minimum_stock]

            os.makedirs(os.path.dirname(filename), exist_ok=True) # Ensure directory exists
            with open(filename, 'w', newline='', encoding='utf-8') as csvfile:
                writer = csv.writer(csvfile)
                writer.writerow(["ID", "Name", "Part Number", "Category", "Current Stock", "Minimum Stock", "System"])
                for item in low_stock_items:
                    writer.writerow([item.id, item.name, item.part_number, item.category, item.current_stock, item.minimum_stock, item.system])

            logger.info(f"Low stock report generated: {filename}")
            return True
        except Exception as e:
            logger.error(f"Failed to generate low stock report: {e}")
            return False

    @staticmethod
    def generate_maintenance_due_report(db: Database, config: Dict[str, Any], filename: str) -> bool:
        """Generate a maintenance due report."""
        try:
            tasks = db.get_maintenance_tasks()
            vessels = {v.id: v for v in db.get_vessels()}
            due_soon_days = config.get("due_soon_days", 7)

            os.makedirs(os.path.dirname(filename), exist_ok=True)
            with open(filename, 'w', newline='', encoding='utf-8') as csvfile:
                writer = csv.writer(csvfile)
                writer.writerow(["ID", "Vessel", "System", "Task", "Last Completed", "Next Due", "Priority", "Status"])
                for task in tasks:
                    vessel = vessels.get(task.vessel_id, Vessel())
                    status_enum = task.get_status(vessel.engine_hours, due_soon_days)
                    if status_enum in [TaskStatus.OVERDUE, TaskStatus.DUE_SOON]:
                        writer.writerow([
                            task.id, vessel.name, task.system, task.task_name,
                            task.last_completed, task.next_due,
                            task.priority.display_name(), status_enum.value
                        ])

            logger.info(f"Maintenance due report generated: {filename}")
            return True
        except Exception as e:
            logger.error(f"Failed to generate maintenance due report: {e}")
            return False

    @staticmethod
    def generate_maintenance_cost_report(db: Database, config: Dict[str, Any], filename: str) -> bool:
        """Generate a maintenance cost report."""
        try:
            tasks = db.get_maintenance_tasks()
            vessels = {v.id: v for v in db.get_vessels()}

            os.makedirs(os.path.dirname(filename), exist_ok=True)
            with open(filename, 'w', newline='', encoding='utf-8') as csvfile:
                writer = csv.writer(csvfile)
                writer.writerow(["ID", "Vessel", "System", "Task", "Labor Cost", "Parts Cost", "Total Cost"])
                total_labor = 0.0
                total_parts = 0.0
                total_cost = 0.0
                for task in tasks:
                    vessel = vessels.get(task.vessel_id, Vessel())
                    writer.writerow([
                        task.id, vessel.name, task.system, task.task_name,
                        task.labor_cost, task.total_parts_cost, task.total_job_cost
                    ])
                    total_labor += task.labor_cost
                    total_parts += task.total_parts_cost
                    total_cost += task.total_job_cost
                writer.writerow(["", "", "", "TOTALS:", total_labor, total_parts, total_cost])

            logger.info(f"Maintenance cost report generated: {filename}")
            return True
        except Exception as e:
            logger.error(f"Failed to generate maintenance cost report: {e}")
            return False

    @staticmethod
    def generate_vessel_performance_report(db: Database, config: Dict[str, Any], vessel_id: int, filename: str) -> bool:
        """Generate a performance report for a specific vessel."""
        try:
            # Get vessel name
            vessels = db.get_vessels()
            vessel = next((v for v in vessels if v.id == vessel_id), None)
            if not vessel:
                 show_error_dialog(None, f"Vessel with ID {vessel_id} not found.")
                 return False

            metrics = db.get_performance_metrics(vessel_id)

            # For simplicity, using reportlab is complex for a simple CSV/PDF example here.
            # This example creates a simple text file.
            os.makedirs(os.path.dirname(filename), exist_ok=True)
            with open(filename.replace('.pdf', '.txt'), 'w', encoding='utf-8') as f: # Write as txt for simplicity without reportlab
                f.write(f"Performance Report for Vessel: {vessel.name}\n")
                f.write(f"ID: {vessel.id}\n")
                f.write("-" * 40 + "\n")
                f.write(f"{'Metric Name':<20} {'Value':<10} {'Unit':<10} {'Date Recorded':<15}\n")
                f.write("-" * 65 + "\n")
                for metric in metrics:
                    f.write(f"{metric.metric_name:<20} {metric.value:<10.2f} {metric.unit:<10} {metric.date_recorded:<15}\n")

            logger.info(f"Vessel performance report generated: {filename}")
            return True
        except Exception as e:
            logger.error(f"Failed to generate vessel performance report: {e}")
            return False


