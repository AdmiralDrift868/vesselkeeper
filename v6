    def on_restore_data(self, button):
        dialog = Gtk.FileChooserDialog(
            title="Restore Data",
            parent=self,
            action=Gtk.FileChooserAction.OPEN,
            # buttons=(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL, # OLD LINE
            #          Gtk.STOCK_OPEN, Gtk.ResponseType.OK)       # OLD LINE
        )
        dialog.add_buttons( # NEW LINE
            Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL, # NEW LINE
            Gtk.STOCK_OPEN, Gtk.ResponseType.OK       # NEW LINE
        ) # NEW LINE

        response = dialog.run()
        if response == Gtk.ResponseType.OK:
            backup_path = dialog.get_filename()
            try:
                with zipfile.ZipFile(backup_path, 'r') as zipf:
                    expected_files = [os.path.basename(DATABASE_FILE)]
                    missing_files = [f for f in expected_files if f not in zipf.namelist()]
                    if missing_files:
                        show_error_dialog(self, f"Backup file is missing expected files: {missing_files}")
                        dialog.destroy()
                        return

                    # Create a temporary directory for extraction
                    with tempfile.TemporaryDirectory() as temp_dir:
                        zipf.extractall(temp_dir)

                        # Confirm overwrite
                        if not show_confirmation_dialog(self, "This will overwrite the current database and configuration. Continue?"):
                            dialog.destroy()
                            return

                        # Stop database connection temporarily
                        self.db.close()

                        # Copy files to main directory
                        for file_name in expected_files:
                             src_path = os.path.join(temp_dir, file_name)
                             dst_path = os.path.join(os.getcwd(), file_name)
                             if os.path.exists(src_path):
                                 import shutil
                                 shutil.copy2(src_path, dst_path)
                                 logger.info(f"Restored {file_name}")

                        # Re-open database connection
                        self.db.open_connection()

                show_info_dialog(self, "Data restored successfully. Please restart the application.")
                # Optionally, reload data here instead of requiring restart
                # self.refresh_views()

            except Exception as e:
                logger.error(f"Restore failed: {e}")
                show_error_dialog(self, f"Restore failed: {e}")
        dialog.destroy()

