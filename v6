class VesselKeeperApp(Gtk.Window):
    def __init__(self):
        super().__init__(title="Vessel Keeper")
        self.set_default_size(1000, 700)
        self.db = Database()
        self.config = self._load_config()

        self._setup_ui()
        self._apply_css()
        self._restore_window_state()

    def _load_config(self) -> Dict[str, Any]:
        config = {"window_x": 100, "window_y": 100, "window_width": 1000, "window_height": 700,
                  "due_soon_days": 7, "default_currency": "$", "language": "en"}
        if os.path.exists(CONFIG_FILE):
            try:
                with open(CONFIG_FILE, 'r') as f:
                    config.update(json.load(f))
            except Exception as e:
                logger.warning(f"Could not read config file: {e}")
        return config

    def _save_config(self):
        try:
            x, y = self.get_position()
            width, height = self.get_size()
            self.config.update({"window_x": x, "window_y": y,
                                "window_width": width, "window_height": height})
            with open(CONFIG_FILE, 'w') as f:
                json.dump(self.config, f, indent=4)
        except Exception as e:
            logger.error(f"Could not save config: {e}")

    def _restore_window_state(self):
        if "window_x" in self.config and "window_y" in self.config:
            self.move(self.config["window_x"], self.config["window_y"])
        if "window_width" in self.config and "window_height" in self.config:
            self.resize(self.config["window_width"], self.config["window_height"])

