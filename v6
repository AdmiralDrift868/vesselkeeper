                                   fuel_used=?, distance=?, crew=?, log_entries=?, attachments=?, status=?, weather_conditions=?,
                                   sea_state=?, captain=?, notes=?
            WHERE id=?
        """, (
            log.vessel_id, log.departure, log.arrival, log.origin, log.destination,
            log.start_hours, log.end_hours, log.fuel_used, log.distance,
            log.crew, log.log_entries, json.dumps(log.attachments), log.status.value,
            log.weather_conditions, log.sea_state, log.captain, log.notes, log.id
        ))
        self.conn.commit()

    def delete_trip_log(self, log_id: int):
        cursor = self.conn.cursor()
        cursor.execute("DELETE FROM trip_logs WHERE id = ?", (log_id,))
        self.conn.commit()

    # --- Stock Transaction Methods ---
    def add_stock_transaction(self, transaction: StockTransaction) -> int:
        cursor = self.conn.cursor()
        cursor.execute("""
            INSERT INTO stock_transactions (item_id, transaction_type, quantity, date, reference, notes)
            VALUES (?, ?, ?, ?, ?, ?)
        """, (
            transaction.item_id, transaction.transaction_type.value,
            transaction.quantity, transaction.date, transaction.reference, transaction.notes
        ))
        self.conn.commit()
        return cursor.lastrowid

    # --- Performance Metric Methods ---
    def add_performance_metric(self, metric: PerformanceMetric) -> int:
        cursor = self.conn.cursor()
        cursor.execute("""
            INSERT INTO performance_metrics (vessel_id, metric_name, value, unit, date_recorded)
            VALUES (?, ?, ?, ?, ?)
        """, (
            metric.vessel_id, metric.metric_name, metric.value, metric.unit, metric.date_recorded
        ))
        self.conn.commit()
        return cursor.lastrowid

    def get_performance_metrics(self, vessel_id: int) -> List[PerformanceMetric]:
        cursor = self.conn.cursor()
        cursor.execute("SELECT * FROM performance_metrics WHERE vessel_id = ?", (vessel_id,))
        rows = cursor.fetchall()
        metrics = []
        for row in rows:
            metric = PerformanceMetric(
                id=row['id'],
                vessel_id=row['vessel_id'],
                metric_name=row['metric_name'] or '',
                value=float(row['value']) if row['value'] is not None else 0.0,
                unit=row['unit'] or '',
                date_recorded=row['date_recorded'] or ''
            )
            metrics.append(metric)
        return metrics

    def update_performance_metric(self, metric: PerformanceMetric):
        cursor = self.conn.cursor()
        cursor.execute("""
            UPDATE performance_metrics SET metric_name=?, value=?, unit=?, date_recorded=?
            WHERE id=?
        """, (
            metric.metric_name, metric.value, metric.unit, metric.date_recorded, metric.id
        ))
        self.conn.commit()

    def delete_performance_metric(self, metric_id: int):
        cursor = self.conn.cursor()
        cursor.execute("DELETE FROM performance_metrics WHERE id = ?", (metric_id,))
        self.conn.commit()


