    def update_dashboard(self):
        # Update summary labels
        tasks = self.db.get_maintenance_tasks()
        vessels = {v.id: v for v in self.db.get_vessels()}
        overdue_count = 0
        due_soon_count = 0
        on_schedule_count = 0
        completed_count = 0
        for task in tasks:
            vessel = vessels.get(task.vessel_id, Vessel())
            status_enum = task.get_status(vessel.engine_hours, self.config.get("due_soon_days", 7))
            if status_enum == TaskStatus.OVERDUE:
                overdue_count += 1
            elif status_enum == TaskStatus.DUE_SOON:
                due_soon_count += 1
            elif status_enum == TaskStatus.ON_SCHEDULE:
                on_schedule_count += 1
            elif status_enum == TaskStatus.COMPLETED:
                completed_count += 1

        self.overdue_label.set_markup(f'<span foreground="red"><b>Overdue: {overdue_count}</b></span>')
        self.due_soon_label.set_markup(f'<span foreground="orange"><b>Due Soon: {due_soon_count}</b></span>')
        self.on_schedule_label.set_markup(f'<span foreground="green"><b>On Schedule: {on_schedule_count}</b></span>')
        self.completed_label.set_markup(f'<span foreground="gray"><b>Completed: {completed_count}</b></span>')

        # Update upcoming tasks
        self.upcoming_store.clear()
        due_soon_days = self.config.get("due_soon_days", 7)
        upcoming_tasks = []
        for task in tasks:
            vessel = vessels.get(task.vessel_id, Vessel())
            status_enum = task.get_status(vessel.engine_hours, due_soon_days)
            if status_enum in [TaskStatus.OVERDUE, TaskStatus.DUE_SOON]:
                upcoming_tasks.append((task, status_enum))

        # Sort upcoming tasks by due date/hours
        def sort_key(tup):
            task, status = tup
            if status == TaskStatus.OVERDUE:
                return (0, datetime.datetime.min) # Put overdue first
            elif task.next_due:
                try:
                    return (1, datetime.datetime.strptime(task.next_due, "%Y-%m-%d"))
                except ValueError:
                    return (1, datetime.datetime.max) # Invalid date last
            else:
                return (1, datetime.datetime.max) # No due date last

        upcoming_tasks.sort(key=sort_key)

        for task, status_enum in upcoming_tasks:
            vessel = vessels.get(task.vessel_id, Vessel())
            self.upcoming_store.append([
                task.task_name, vessel.name, task.system, # Original order: Task, Vessel, System
                task.next_due or "N/A", status_enum.value
            ])

