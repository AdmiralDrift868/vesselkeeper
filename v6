        ) # NEW LINE
        dialog.set_current_name("vessel_keeper_backup.zip")

        response = dialog.run()
        if response == Gtk.ResponseType.OK:
            backup_path = dialog.get_filename()
            if not backup_path.endswith('.zip'):
                backup_path += '.zip'
            try:
                with zipfile.ZipFile(backup_path, 'w', zipfile.ZIP_DEFLATED) as zipf:
                    zipf.write(DATABASE_FILE, os.path.basename(DATABASE_FILE))
                    # Add other config files if needed
                    # zipf.write(CONFIG_FILE, os.path.basename(CONFIG_FILE))
                show_info_dialog(self, f"Backup created: {backup_path}")
