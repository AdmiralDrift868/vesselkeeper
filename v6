def validate_date(date_str: str) -> bool:
    """Validates a date string in YYYY-MM-DD format."""
    if not date_str:
        return True # Allow empty dates
    try:
        datetime.datetime.strptime(date_str, "%Y-%m-%d")
        return True
    except ValueError:
        return False

def calculate_maintenance_cost(task: MaintenanceTask, db) -> Tuple[float, float, float]:
    """Calculates labor, parts, and total cost for a maintenance task."""
    labor_cost = task.labor_cost
    parts_cost = 0.0
    if task.parts_required:
        items = db.get_inventory_items_by_ids(task.parts_required)
        parts_cost = sum(item.unit_cost * 1 for item in items) # Assuming quantity of 1 per part required
    total_cost = labor_cost + parts_cost
    return labor_cost, parts_cost, total_cost

