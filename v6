            self.next_due_entry.get_text() and
            not validate_date(self.next_due_entry.get_text())):
            show_error_dialog(self, "Next Due date format is invalid. Please use YYYY-MM-DD.")
            self.next_due_entry.grab_focus()
            return False

        last_completed = self.last_completed_entry.get_text()
        next_due = self.next_due_entry.get_text()
        if (last_completed and next_due and
            self.next_due_entry.get_sensitive()): # Only check if date fields are relevant
            try:
                last_date = datetime.datetime.strptime(last_completed, "%Y-%m-%d").date()
                next_date = datetime.datetime.strptime(next_due, "%Y-%m-%d").date()
                if next_date <= last_date: # Allow equal dates? Adjust logic based on business rules.
                    show_error_dialog(self, "Next Due date cannot be before or equal to Last Completed date.")
                    self.next_due_entry.grab_focus()
                    return False
            except ValueError:
                pass # This should be caught by validate_date, but just in case
        return True

    def get_values(self) -> MaintenanceTask:
        buffer = self.instructions_textview.get_buffer()
        start_iter = buffer.get_start_iter()
        end_iter = buffer.get_end_iter()
        instructions = buffer.get_text(start_iter, end_iter, False).strip()

        buffer_notes = self.notes_textview.get_buffer()
        start_iter_notes = buffer_notes.get_start_iter()
        end_iter_notes = buffer_notes.get_end_iter()
        notes = buffer_notes.get_text(start_iter_notes, end_iter_notes, False).strip()

        # Get selected vessel
        vessel_index = self.vessel_combo.get_active()
        vessel_id = self.vessels[vessel_index].id if vessel_index >= 0 else 0

        # Get selected interval type
        interval_index = self.interval_type_combo.get_active()
        selected_interval_type = list(IntervalType)[interval_index] if interval_index >= 0 else IntervalType.HOURS

        # Get selected priority
        priority_index = self.priority_combo.get_active()
        selected_priority = list(Priority)[priority_index] if priority_index >= 0 else Priority.MEDIUM

        # Get selected status
        status_index = self.status_combo.get_active()
        selected_status = list(TaskStatus)[status_index] if status_index >= 0 else TaskStatus.ON_SCHEDULE

        # Get selected system
        system_index = self.system_combo.get_active()
        system = SYSTEM_CATEGORIES[system_index - 1] if 0 < system_index < len(SYSTEM_CATEGORIES) + 1 else ""

        task = MaintenanceTask(
            id=self.item.id if self.item else None,
            vessel_id=vessel_id,
            system=system,
            task_name=self.task_name_entry.get_text().strip(),
            interval_type=selected_interval_type,
            interval_value=int(self.interval_value_entry.get_value()),
            last_completed=self.last_completed_entry.get_text(),
            last_hours=self.last_hours_entry.get_value(),
            next_due=self.next_due_entry.get_text(),
            priority=selected_priority,
            status=selected_status,
            assigned_to=self.assigned_to_entry.get_text().strip(),
            estimated_duration_hours=self.estimated_duration_entry.get_value(),
            labor_cost=self.labor_cost_entry.get_value(),
