        self.instructions_textview.set_wrap_mode(Gtk.WrapMode.WORD)
        scrolled_window.add(self.instructions_textview)
        self._add_form_field(9, "Instructions:", scrolled_window)

    def _populate_fields(self):
        if not self.item:
            return
            
        # Set vessel in combo
        for i, vessel in enumerate(self.vessels):
            if vessel.id == self.item.vessel_id:
                self.vessel_combo.set_active(i)
                break
        
        # Set system in combo
        for i, system in enumerate(["Engine", "Electrical", "Plumbing", "Hull", "Rigging", "Safety", "Navigation"]):
            if system == self.item.system:
                self.system_combo.set_active(i)
                break
        
        self.task_name_entry.set_text(self.item.task_name)
        
        # Set interval type in combo
        for i, interval_type in enumerate(IntervalType):
            if interval_type == self.item.interval_type:
                self.interval_type_combo.set_active(i)
                break
        
        self.interval_value_entry.set_value(self.item.interval_value)
        self.last_completed_entry.set_text(self.item.last_completed)
        self.last_hours_entry.set_value(self.item.last_hours)
        self.next_due_entry.set_text(self.item.next_due)
        
        # Set priority in combo
        for i, priority in enumerate(Priority):
            if priority == self.item.priority:
                self.priority_combo.set_active(i)
                break
        
        # Set instructions in text view
        buffer = self.instructions_textview.get_buffer()
        buffer.set_text(self.item.instructions)

    def on_interval_type_changed(self, combo):
        active_index = combo.get_active()
        if active_index >= 0:
            interval_type = list(IntervalType)[active_index]
            is_date_based = (interval_type == IntervalType.DAYS)
            self.last_completed_entry.set_sensitive(is_date_based)
            self.next_due_entry.set_sensitive(is_date_based)
            self.last_hours_entry.set_sensitive(not is_date_based)

    def validate(self) -> bool:
        if not self.task_name_entry.get_text().strip():
            show_error_dialog(self, "Task name is required.")
            self.task_name_entry.grab_focus()
            return False

        if self.vessel_combo.get_active() == -1:
            show_error_dialog(self, "Please select a vessel.")
            self.vessel_combo.grab_focus()
            return False

        if (self.last_completed_entry.get_text() and
            not self.last_completed_entry.validate_date()):
            show_error_dialog(self, "Last Completed date format is invalid. Please use YYYY-MM-DD.")
            self.last_completed_entry.entry.grab_focus()
            return False

        if (self.next_due_entry.get_sensitive() and
            self.next_due_entry.get_text() and
            not self.next_due_entry.validate_date()):
            show_error_dialog(self, "Next Due date format is invalid. Please use YYYY-MM-DD.")
            self.next_due_entry.entry.grab_focus()
            return False

        last_completed = self.last_completed_entry.get_text()
        next_due = self.next_due_entry.get_text()
        if (last_completed and next_due and
            self.next_due_entry.get_sensitive()):
            try:
                last_date = datetime.datetime.strptime(last_completed, "%Y-%m-%d").date()
                next_date = datetime.datetime.strptime(next_due, "%Y-%m-%d").date()
                
                if next_date <= last_date:
                    show_error_dialog(self, "Next Due date cannot be before or equal to Last Completed date.")
                    self.next_due_entry.entry.grab_focus()
                    return False
            except ValueError:
                pass  # This should be caught by validate_date, but just in case

        return True

    def get_values(self) -> MaintenanceTask:
        buffer = self.instructions_textview.get_buffer()
        start_iter = buffer.get_start_iter()
        end_iter = buffer.get_end_iter()
        instructions = buffer.get_text(start_iter, end_iter, False).strip()
        
        # Get selected vessel
        vessel_index = self.vessel_combo.get_active()
        vessel_id = self.vessels[vessel_index].id if vessel_index >= 0 else 0
        
        # Get selected interval type
        interval_index = self.interval_type_combo.get_active()
        selected_interval_type = list(IntervalType)[interval_index] if interval_index >= 0 else IntervalType.HOURS
        
        # Get selected priority
        priority_index = self.priority_combo.get_active()
        selected_priority = list(Priority)[priority_index] if priority_index >= 0 else Priority.MEDIUM
        
        # Calculate next due date if needed
        next_due_date_str = self.next_due_entry.get_text()
        if selected_interval_type == IntervalType.DAYS and self.last_completed_entry.get_text() and not next_due_date_str:
            try:
                last_date = datetime.datetime.strptime(self.last_completed_entry.get_text(), "%Y-%m-%d").date()
                next_date = last_date + datetime.timedelta(days=int(self.interval_value_entry.get_value()))
                next_due_date_str = next_date.strftime("%Y-%m-%d")
            except ValueError:
                next_due_date_str = ""
        
        task = MaintenanceTask(
            id=self.item.id if self.item else None,
            vessel_id=vessel_id,
            system=self.system_combo.get_active_text() or "",
            task_name=self.task_name_entry.get_text().strip(),
            interval_type=selected_interval_type,
            interval_value=int(self.interval_value_entry.get_value()),
            last_completed=self.last_completed_entry.get_text(),
            last_hours=self.last_hours_entry.get_value(),
            next_due=next_due_date_str,
            priority=selected_priority,
            instructions=instructions
        )
        return task

