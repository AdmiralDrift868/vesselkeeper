# Database Class
class Database:
    def __init__(self, db_path: str = "vessel_keeper.db"):
        self.db_path = db_path
        self.conn = None
        self._connect()
        self._create_tables()

    def _connect(self):
        import sqlite3
        self.conn = sqlite3.connect(self.db_path, check_same_thread=False)
        self.conn.row_factory = sqlite3.Row  # Enable column access by name

    def _create_tables(self):
        cursor = self.conn.cursor()
        cursor.executescript("""
        CREATE TABLE IF NOT EXISTS vessels (
            id INTEGER PRIMARY KEY,
            name TEXT NOT NULL,
            vessel_type TEXT,
            length REAL,
            beam REAL,
            draft REAL,
            engine_hours REAL DEFAULT 0,
            notes TEXT,
            attachments TEXT -- JSON list of file paths
        );

        CREATE TABLE IF NOT EXISTS maintenance_tasks (
            id INTEGER PRIMARY KEY,
            vessel_id INTEGER REFERENCES vessels(id) ON DELETE CASCADE,
            system TEXT,
            task_name TEXT NOT NULL,
            template_id INTEGER,
            interval_type TEXT,
            interval_value INTEGER,
            last_completed TEXT,
            last_hours REAL,
            next_due TEXT,
            priority TEXT,
            parts_required TEXT, -- JSON list of inventory item IDs
            instructions TEXT,
            labor_cost REAL DEFAULT 0,
            total_parts_cost REAL DEFAULT 0,
            attachments TEXT -- JSON list of file paths
        );

        CREATE TABLE IF NOT EXISTS inventory (
            id INTEGER PRIMARY KEY,
            name TEXT NOT NULL,
            part_number TEXT,
            description TEXT,
            category TEXT,
            system TEXT, -- Added system field
            location TEXT, -- Added location field
            current_stock INTEGER DEFAULT 0,
            minimum_stock INTEGER DEFAULT 0,
            supplier_id INTEGER REFERENCES suppliers(id),
            unit_cost REAL DEFAULT 0,
            specifications TEXT,
            attachments TEXT -- JSON list of file paths
        );

        CREATE TABLE IF NOT EXISTS suppliers (
            id INTEGER PRIMARY KEY,
            name TEXT NOT NULL,
            contact TEXT,
            phone TEXT,
            email TEXT,
            notes TEXT,
            attachments TEXT -- JSON list of file paths
        );

        CREATE TABLE IF NOT EXISTS trip_logs (
            id INTEGER PRIMARY KEY,
            vessel_id INTEGER REFERENCES vessels(id) ON DELETE CASCADE,
            departure TEXT,
            arrival TEXT,
            origin TEXT,
            destination TEXT,
            start_hours REAL,
            end_hours REAL,
            fuel_used REAL,
            distance REAL,
            crew TEXT,
            log_entries TEXT,
            attachments TEXT -- JSON list of file paths
        );

        CREATE TABLE IF NOT EXISTS maintenance_templates (
            id INTEGER PRIMARY KEY,
            name TEXT NOT NULL,
            system TEXT,
            task_name TEXT NOT NULL,
            interval_type TEXT,
            interval_value INTEGER,
            priority TEXT,
            parts_required TEXT, -- JSON list of inventory item IDs
            instructions TEXT
        );
        """)
        self.conn.commit()

    def close(self):
        try:
            if self.conn:
                self.conn.close()
                logger.info("Database connection closed.")
        except Exception as e:
            logger.error(f"Error closing DB: {e}")

    # Vessels
    def add_vessel(self, vessel: Vessel) -> int:
        cursor = self.conn.cursor()
        cursor.execute(
            "INSERT INTO vessels (name, vessel_type, length, beam, draft, engine_hours, notes, attachments) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
            (vessel.name, vessel.vessel_type, vessel.length, vessel.beam, vessel.draft, 
             vessel.engine_hours, vessel.notes, json.dumps(vessel.attachments))
        )
        self.conn.commit()
        vessel_id = cursor.lastrowid
        logger.info(f"Added vessel with ID {vessel_id}")
        return vessel_id

    def get_vessels(self) -> List[Vessel]:
        cursor = self.conn.cursor()
        cursor.execute("SELECT * FROM vessels")
        rows = cursor.fetchall()
