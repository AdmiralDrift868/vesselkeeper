    def update_vessels_list(self):
        self.vessels_store.clear()
        vessels = self.db.get_vessels()
        for vessel in vessels:
            self.vessels_store.append([
                vessel.id or 0, vessel.name, vessel.vessel_type, 
                vessel.length, vessel.beam, vessel.draft, 
                vessel.engine_hours, vessel.notes[:50]  # Truncate notes
            ])

    def update_maintenance_list(self):
        self.maintenance_store.clear()
        tasks = self.db.get_maintenance_tasks()
        vessels = {v.id: v for v in self.db.get_vessels()}
        
        for task in tasks:
            vessel = vessels.get(task.vessel_id, Vessel())
            self.maintenance_store.append([
                task.id or 0, vessel.name, task.system, task.task_name,
                task.interval_type.display_name(), task.interval_value,
                task.last_completed, task.next_due, task.priority.display_name()
            ])

    def update_inventory_list(self):
        self.inventory_store.clear()
        items = self.db.get_inventory_items()
        for item in items:
            self.inventory_store.append([
                item.id or 0, item.name, item.part_number, item.description,
                item.current_stock, item.minimum_stock, item.system, item.location
            ])

    def update_suppliers_list(self):
        self.suppliers_store.clear()
        suppliers = self.db.get_suppliers()
        for supplier in suppliers:
            self.suppliers_store.append([
                supplier.id or 0, supplier.name, supplier.contact,
                supplier.phone, supplier.email, supplier.notes[:50]  # Truncate notes
            ])

    def update_trip_logs_list(self):
        self.trip_logs_store.clear()
        logs = self.db.get_trip_logs()
        vessels = {v.id: v for v in self.db.get_vessels()}
        
        for log in logs:
            vessel = vessels.get(log.vessel_id, Vessel())
            self.trip_logs_store.append([
                log.id or 0, vessel.name, log.origin, log.destination,
                log.departure, log.start_hours, log.end_hours,
                log.fuel_used, log.distance, log.crew
            ])

    def update_dashboard(self):
        # Update summary labels
        tasks = self.db.get_maintenance_tasks()
        vessels = {v.id: v for v in self.db.get_vessels()}
        
        overdue_count = 0
        due_soon_count = 0
        on_schedule_count = 0
        completed_count = 0
        
        for task in tasks:
            vessel = vessels.get(task.vessel_id, Vessel())
            status = task.get_status(vessel.engine_hours, self.config.get("due_soon_days", 7))
            if status == Status.OVERDUE:
                overdue_count += 1
            elif status == Status.DUE_SOON:
                due_soon_count += 1
            elif status == Status.ON_SCHEDULE:
                on_schedule_count += 1
            elif status == Status.COMPLETED:
                completed_count += 1
        
        self.overdue_label.set_markup(f'<span foreground="red"><b>Overdue: {overdue_count}</b></span>')
        self.due_soon_label.set_markup(f'<span foreground="orange"><b>Due Soon: {due_soon_count}</b></span>')
        self.on_schedule_label.set_markup(f'<span foreground="green"><b>On Schedule: {on_schedule_count}</b></span>')
        self.completed_label.set_markup(f'<span foreground="gray"><b>Completed: {completed_count}</b></span>')
        
        # Update upcoming tasks
        self.upcoming_store.clear()
        due_soon_days = self.config.get("due_soon_days", 7)
        
        for task in tasks:
            vessel = vessels.get(task.vessel_id, Vessel())
            status = task.get_status(vessel.engine_hours, due_soon_days)
            if status in [Status.OVERDUE, Status.DUE_SOON]:
                self.upcoming_store.append([
                    task.id or 0, vessel.name, task.system, task.task_name,
                    task.next_due or task.last_completed, status.display_name()
                ])

