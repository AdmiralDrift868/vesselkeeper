# Report Generator
class ReportGenerator:
    @staticmethod
    def generate_low_stock_report(db: Database, config: Dict[str, Any], filename: str) -> bool:
        """Generate a low stock report."""
        try:
            items = db.get_inventory_items()
            low_stock_items = [item for item in items if item.current_stock <= item.minimum_stock and item.minimum_stock > 0]
            
            with open(filename, 'w', newline='', encoding='utf-8') as csvfile:
                writer = csv.writer(csvfile)
                writer.writerow(["ID", "Name", "Part Number", "Current Stock", "Minimum Stock", "System", "Location"])
                
                for item in low_stock_items:
                    writer.writerow([
                        item.id, item.name, item.part_number, 
                        item.current_stock, item.minimum_stock,
                        item.system, item.location
                    ])
            
            logger.info(f"Low stock report generated: {filename}")
            return True
        except Exception as e:
            logger.error(f"Failed to generate low stock report: {e}")
            return False

    @staticmethod
    def generate_maintenance_due_report(db: Database, config: Dict[str, Any], filename: str) -> bool:
        """Generate a maintenance due report."""
        try:
            tasks = db.get_maintenance_tasks()
            vessels = {v.id: v for v in db.get_vessels()}
            due_soon_days = config.get("due_soon_days", 7)
            
            with open(filename, 'w', newline='', encoding='utf-8') as csvfile:
                writer = csv.writer(csvfile)
                writer.writerow(["ID", "Vessel", "System", "Task Name", "Date", "Status", "Priority"])
                
                for task in tasks:
                    vessel = vessels.get(task.vessel_id, Vessel())
                    status = task.get_status(vessel.engine_hours, due_soon_days)
                    if status in [Status.OVERDUE, Status.DUE_SOON]:
                        date_str = task.next_due if task.next_due else task.last_completed
                        writer.writerow([
                            task.id, vessel.name, task.system, task.task_name,
                            date_str, status.display_name(), task.priority.display_name()
                        ])
            
            logger.info(f"Maintenance due report generated: {filename}")
            return True
        except Exception as e:
            logger.error(f"Failed to generate maintenance due report: {e}")
            return False

    @staticmethod
    def generate_maintenance_cost_report(db: Database, config: Dict[str, Any], filename: str) -> bool:
        """Generate a maintenance cost report."""
        try:
            tasks = db.get_maintenance_tasks()
            vessels = {v.id: v for v in db.get_vessels()}
            
            with open(filename, 'w', newline='', encoding='utf-8') as csvfile:
                writer = csv.writer(csvfile)
                writer.writerow(["ID", "Vessel", "System", "Task Name", "Labor Cost", "Parts Cost", "Total Cost"])
                
                for task in tasks:
                    vessel = vessels.get(task.vessel_id, Vessel())
                    total_cost = task.labor_cost + task.total_parts_cost
                    writer.writerow([
                        task.id, vessel.name, task.system, task.task_name,
                        task.labor_cost, task.total_parts_cost, total_cost
                    ])
            
            logger.info(f"Maintenance cost report generated: {filename}")
            return True
        except Exception as e:
            logger.error(f"Failed to generate maintenance cost report: {e}")
            return False

# Report Dialog
class ReportDialog(Gtk.Dialog):
    def __init__(self, parent: Gtk.Window, db: Database, report_type: str, config: Dict[str, Any]):
        super().__init__(title=f"Generate {report_type} Report", transient_for=parent, flags=0)
        self.db = db
        self.report_type = report_type
        self.config = config
        self.set_default_size(300, 150)
        self.set_modal(True)
        
        self.grid = Gtk.Grid()
        self.grid.set_row_spacing(10)
        self.grid.set_column_spacing(10)
        self.grid.set_border_width(10)
        
        content_area = self.get_content_area()
        content_area.pack_start(self.grid, True, True, 0)
        
        self.filename_entry = Gtk.Entry()
        self.filename_entry.set_text(f"{report_type.replace(' ', '_').lower()}_{datetime.datetime.now().strftime('%Y%m%d_%H%M%S')}.csv")
        self._add_form_field(0, "Filename:", self.filename_entry)
        
        self.add_button(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL)
        ok_button = self.add_button(Gtk.STOCK_OK, Gtk.ResponseType.OK)
        ok_button.get_style_context().add_class("suggested-action")
        
        self.connect("response", self.on_response)

    def _add_form_field(self, row: int, label_text: str, widget) -> Gtk.Widget:
        label = Gtk.Label(label=label_text)
        label.set_halign(Gtk.Align.START)
        self.grid.attach(label, 0, row, 1, 1)
        self.grid.attach(widget, 1, row, 1, 1)
        return widget

    def on_response(self, dialog, response_id):
        if response_id == Gtk.ResponseType.OK:
            filename = self.filename_entry.get_text().strip()
            if not filename:
                show_error_dialog(self, "Please enter a filename.")
                return

            if not filename.endswith('.csv'):
                filename += '.csv'

            full_path = os.path.join(REPORTS_DIR, filename)
            success = False

            if self.report_type == "Low Stock":
                success = ReportGenerator.generate_low_stock_report(self.db, self.config, full_path)
            elif self.report_type == "Maintenance Due":
                success = ReportGenerator.generate_maintenance_due_report(self.db, self.config, full_path)
            elif self.report_type == "Maintenance Cost":
                success = ReportGenerator.generate_maintenance_cost_report(self.db, self.config, full_path)

            if success:
                show_info_dialog(self.get_transient_for(), f"Report generated successfully:\n{full_path}")
            else:
                show_error_dialog(self.get_transient_for(), "Failed to generate report.")

        self.destroy()

