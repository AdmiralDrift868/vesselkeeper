# Utility Functions
def show_error_dialog(parent: Gtk.Window, message: str):
    dialog = Gtk.MessageDialog(
        transient_for=parent,
        flags=0,
        message_type=Gtk.MessageType.ERROR,
        buttons=Gtk.ButtonsType.OK,
        text=message
    )
    dialog.run()
    dialog.destroy()

def show_info_dialog(parent: Gtk.Window, message: str):
    dialog = Gtk.MessageDialog(
        transient_for=parent,
        flags=0,
        message_type=Gtk.MessageType.INFO,
        buttons=Gtk.ButtonsType.OK,
        text=message
    )
    dialog.run()
    dialog.destroy()

def validate_date(date_str: str) -> bool:
    if not date_str:
        return True
    try:
        datetime.datetime.strptime(date_str, "%Y-%m-%d").date()
        return True
    except ValueError:
        return False

# Base Editor Class
class BaseEditor(Gtk.Dialog):
    def __init__(self, parent: Gtk.Window, title: str, item=None):
        super().__init__(title=title, transient_for=parent, flags=0)
        self.item = item
        self.grid = Gtk.Grid()
        self.grid.set_row_spacing(10)
        self.grid.set_column_spacing(10)
        self.grid.set_border_width(10)
        
        content_area = self.get_content_area()
        content_area.add(self.grid)
        
        self.row_counter = 0
        
        # Add OK and Cancel buttons
        self.add_button(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL)
        ok_button = self.add_button(Gtk.STOCK_OK, Gtk.ResponseType.OK)
        ok_button.get_style_context().add_class("suggested-action")
        
        self.set_default_size(400, 300)
        self.set_modal(True)

    def _add_form_field(self, row: int, label_text: str, widget) -> Gtk.Widget:
        label = Gtk.Label(label=label_text)
        label.set_halign(Gtk.Align.START)
        self.grid.attach(label, 0, row, 1, 1)
        self.grid.attach(widget, 1, row, 1, 1)
        return widget

    def validate(self) -> bool:
        """Override in subclasses to implement validation logic"""
        return True

# Date Picker Entry Widget
class DatePickerEntry(Gtk.Box):
    def __init__(self):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)
        
        self.entry = Gtk.Entry()
        self.button = Gtk.Button(label="...")
        
        self.pack_start(self.entry, True, True, 0)
        self.pack_start(self.button, False, False, 0)
        
        self.button.connect("clicked", self._on_button_clicked)

    def _on_button_clicked(self, button):
        dialog = Gtk.Dialog(title="Select Date", transient_for=self.get_toplevel(), 
                           flags=0, buttons=(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
                                            Gtk.STOCK_OK, Gtk.ResponseType.OK))
        dialog.set_default_size(300, 200)

        calendar = Gtk.Calendar()
        dialog.get_content_area().pack_start(calendar, True, True, 0)
        dialog.show_all()

        response = dialog.run()
        if response == Gtk.ResponseType.OK:
            year, month, day = calendar.get_date()
            date_str = f"{year}-{month+1:02d}-{day:02d}"
            self.entry.set_text(date_str)

        dialog.destroy()

    def get_text(self) -> str:
        return self.entry.get_text()

    def set_text(self, text: str):
        self.entry.set_text(text)

    def validate_date(self) -> bool:
        return validate_date(self.entry.get_text())

    def grab_focus(self):
        self.entry.grab_focus()

# Vessel Editor
class VesselEditor(BaseEditor):
    def __init__(self, parent: Gtk.Window, db: Database, vessel: Vessel = None):
        super().__init__(parent, "Edit Vessel" if vessel else "Add Vessel", vessel)
        self.db = db
        self._setup_ui()
        if self.item:
            self._populate_fields()

    def _setup_ui(self):
        self.name_entry = self._add_form_field(0, "Name:", Gtk.Entry())
        self.type_combo = Gtk.ComboBoxText()
        for vessel_type in VESSEL_TYPES:
            self.type_combo.append_text(vessel_type)
        self._add_form_field(1, "Type:", self.type_combo)
        
        self.length_entry = self._add_form_field(2, "Length (ft):", Gtk.SpinButton.new_with_range(0, 1000, 0.1))
        self.beam_entry = self._add_form_field(3, "Beam (ft):", Gtk.SpinButton.new_with_range(0, 1000, 0.1))
        self.draft_entry = self._add_form_field(4, "Draft (ft):", Gtk.SpinButton.new_with_range(0, 1000, 0.1))
        self.hours_entry = self._add_form_field(5, "Engine Hours:", Gtk.SpinButton.new_with_range(0, 100000, 1))
        
        # Notes text view
        scrolled_window = Gtk.ScrolledWindow()
        scrolled_window.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scrolled_window.set_size_request(-1, 100)
        
        self.notes_textview = Gtk.TextView()
        self.notes_textview.set_wrap_mode(Gtk.WrapMode.WORD)
        scrolled_window.add(self.notes_textview)
        self._add_form_field(6, "Notes:", scrolled_window)

    def _populate_fields(self):
        if not self.item:
            return
            
        self.name_entry.set_text(self.item.name)
        
        # Set vessel type in combo
        if self.item.vessel_type:
            for i, vessel_type in enumerate(VESSEL_TYPES):
                if vessel_type == self.item.vessel_type:
                    self.type_combo.set_active(i)
                    break
        
        self.length_entry.set_value(self.item.length)
        self.beam_entry.set_value(self.item.beam)
        self.draft_entry.set_value(self.item.draft)
        self.hours_entry.set_value(self.item.engine_hours)
        
        # Set notes in text view
        buffer = self.notes_textview.get_buffer()
        buffer.set_text(self.item.notes)

    def validate(self) -> bool:
        if not self.name_entry.get_text().strip():
            show_error_dialog(self, "Vessel name is required.")
            self.name_entry.grab_focus()
            return False
        return True

    def get_values(self) -> Vessel:
        buffer = self.notes_textview.get_buffer()
        start_iter = buffer.get_start_iter()
        end_iter = buffer.get_end_iter()
        notes = buffer.get_text(start_iter, end_iter, False).strip()
        
        vessel = Vessel(
            id=self.item.id if self.item else None,
            name=self.name_entry.get_text().strip(),
            vessel_type=VESSEL_TYPES[self.type_combo.get_active()] if self.type_combo.get_active() >= 0 else "",
            length=self.length_entry.get_value(),
            beam=self.beam_entry.get_value(),
