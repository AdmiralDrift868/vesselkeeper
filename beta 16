    def refresh_views(self):
        try:
            self.vessels_store.clear()
            vessels = self.db.get_vessels()
            for vessel in vessels:
                self.vessels_store.append([vessel.id, vessel.name, vessel.vessel_type, vessel.engine_hours])
            logger.info(f"Refreshed Vessels view ({len(vessels)} items)")

            self.maintenance_store.clear()
            tasks = self.db.get_maintenance_tasks()
            for task in tasks:
                 # Append the enum member name (e.g., "OVERDUE") for status column
                self.maintenance_store.append([task.id, task.vessel_name, task.system, task.task_name, task.next_due, task.get_status().name])
            logger.info(f"Refreshed Maintenance view ({len(tasks)} items)")

            self.inventory_store.clear()
            items = self.db.get_inventory()
            for item in items:
                self.inventory_store.append([item.id, item.name, item.part_number, item.current_stock])
            logger.info(f"Refreshed Inventory view ({len(items)} items)")

            self.trips_store.clear()
            vessel_dict = {v.id: v.name for v in self.db.get_vessels()}
            logs = self.db.get_trip_logs()
            for log in logs:
                vessel_name = vessel_dict.get(log.vessel_id, "Unknown Vessel")
                self.trips_store.append([log.id, vessel_name, log.departure, log.arrival, log.origin, log.destination])
            logger.info(f"Refreshed Trips view ({len(logs)} items)")

            self.suppliers_store.clear()
            suppliers = self.db.get_suppliers()
            for supplier in suppliers:
                self.suppliers_store.append([supplier.id, supplier.name, supplier.contact])
            logger.info(f"Refreshed Suppliers view ({len(suppliers)} items)")

            self.update_status_bar()
        except Exception as e:
            logger.error(f"Error refreshing views: {e}", exc_info=True)
            show_error_dialog(self, f"Error refreshing views: {e}")

    def update_status_bar(self):
        # Check if status_bar exists to prevent AttributeError
        if not hasattr(self, 'status_bar'):
            logger.debug("Status bar not initialized yet.")
            return

        page_num = self.notebook.get_current_page()
        if page_num < 0: # Check if a page is actually selected
             self.status_bar.push(self.status_context_id, "Ready")
             return
        page_widget = self.notebook.get_nth_page(page_num)
        if page_widget is None:
            return
        page_title = self.notebook.get_tab_label_text(page_widget)
        if not page_title:
             page_title = "Unknown"

        count = 0
        if page_title == "Vessels":
            count = len(self.vessels_store)
        elif page_title == "Maintenance":
            count = len(self.maintenance_store)
        elif page_title == "Inventory":
            count = len(self.inventory_store)
        elif page_title == "Trip Logs": # Match the actual tab label
            count = len(self.trips_store)
        elif page_title == "Suppliers":
            count = len(self.suppliers_store)

        msg = f"{page_title}: {count} items"
        # Clear previous messages on the specific context
        self.status_bar.remove_all(self.status_context_id)
        self.status_bar.push(self.status_context_id, msg)

    def on_notebook_switch_page(self, notebook: Gtk.Notebook, page: Gtk.Widget, page_num: int):
        # This will now be called after status_bar is definitely created
        # and after the initial switch to page 0 during setup.
        # GLib.idle_add can also be used here if needed, but usually not necessary
        # for subsequent user-driven switches.
        self.update_status_bar()

    # --- Generic CRUD Helpers ---
    def _handle_add(self, editor_class, add_func, refresh_func):
        editor = editor_class(self, self.db)
        # Set focus to the first relevant entry field
        if hasattr(editor, 'name_entry') and isinstance(editor.name_entry, Gtk.Entry):
             editor.name_entry.grab_focus()
        elif hasattr(editor, 'task_name_entry') and isinstance(editor.task_name_entry, Gtk.Entry):
             editor.task_name_entry.grab_focus()
        elif hasattr(editor, 'vessel_combo') and isinstance(editor.vessel_combo, Gtk.ComboBoxText):
             editor.vessel_combo.grab_focus()

        response = editor.run()
        if response == Gtk.ResponseType.OK and editor.validate():
            try:
                item_data = editor.get_data()
                add_func(item_data)
                refresh_func()
                logger.info(f"Item added via {editor_class.__name__}")
            except Exception as e:
                logger.error(f"Error adding item via {editor_class.__name__}: {e}", exc_info=True)
                show_error_dialog(self, f"Error adding item: {e}")
        editor.destroy()

    def _handle_edit(self, editor_class, item, update_func, refresh_func, delete_func):
        editor = editor_class(self, self.db, item)
        response = editor.run()
        if response == Gtk.ResponseType.OK and editor.validate():
            try:
                item_data = editor.get_data()
                update_func(item_data)
                refresh_func()
                logger.info(f"Item updated via {editor_class.__name__}")
            except Exception as e:
                logger.error(f"Error updating item via {editor_class.__name__}: {e}", exc_info=True)
                show_error_dialog(self, f"Error updating item: {e}")
        elif response == Gtk.ResponseType.DELETE_EVENT:
             if show_confirmation_dialog(self, "Are you sure you want to delete this item?"):
                try:
                    delete_func(item.id)
                    refresh_func()
                    logger.info(f"Item deleted via {editor_class.__name__}")
                except Exception as e:
                    logger.error(f"Error deleting item via {editor_class.__name__}: {e}", exc_info=True)
                    show_error_dialog(self, f"Error deleting item: {e}")
        editor.destroy()

