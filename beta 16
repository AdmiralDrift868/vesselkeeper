# --- Enums ---
class Priority(Enum):
    CRITICAL = ("Critical", "#dc3545") # Name, Color
    HIGH = ("High", "#fd7e14")
    MEDIUM = ("Medium", "#ffc107")
    LOW = ("Low", "#28a745")

    def display_name(self) -> str:
        return self.value[0]
    def color(self) -> Optional[str]:
        return self.value[1]

class IntervalType(Enum):
    HOURS = "Hours"
    DAYS = "Days"
    USAGE_CYCLES = "Usage Cycles"

    def display_name(self) -> str:
        return self.value

class Status(Enum):
    OVERDUE = ("Overdue", "#F8D7DA") # Name, Color
    DUE_SOON = ("Due Soon", "#FFF3CD")
    ON_SCHEDULE = ("On Schedule", None) # No specific color
    COMPLETED = ("Completed", "#D4EDDA")

    def display_name(self) -> str:
        return self.value[0]
    def color(self) -> Optional[str]:
        return self.value[1]

