    # --- Maintenance ---
    def add_maintenance_task(self, task: MaintenanceTask) -> int:
        cursor = self.conn.cursor()
        cursor.execute("""
            INSERT INTO maintenance_tasks (vessel_id, system, task_name, template_id, interval_type, interval_value, last_completed, last_hours, next_due, priority, parts_required, instructions)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            task.vessel_id,
            task.system,
            task.task_name,
            task.template_id,
            task.interval_type.name if task.interval_type else None,
            task.interval_value,
            task.last_completed,
            task.last_hours,
            task.next_due,
            task.priority.name if task.priority else None,
            json.dumps(task.parts_required) if task.parts_required else None,
            task.instructions
        ))
        self.conn.commit()
        task_id = cursor.lastrowid
        logger.info(f"Added maintenance task: {task.task_name} (ID: {task_id})")
        return task_id

    def update_maintenance_task(self, task: MaintenanceTask):
        cursor = self.conn.cursor()
        cursor.execute("""
            UPDATE maintenance_tasks SET vessel_id=?, system=?, task_name=?, template_id=?, interval_type=?, interval_value=?, last_completed=?, last_hours=?, next_due=?, priority=?, parts_required=?, instructions=? WHERE id=?
        """, (
            task.vessel_id,
            task.system,
            task.task_name,
            task.template_id,
            task.interval_type.name if task.interval_type else None,
            task.interval_value,
            task.last_completed,
            task.last_hours,
            task.next_due,
            task.priority.name if task.priority else None,
            json.dumps(task.parts_required) if task.parts_required else None,
            task.instructions,
            task.id
        ))
        self.conn.commit()
        logger.info(f"Updated maintenance task ID: {task.id}")

    def delete_maintenance_task(self, task_id: int):
        cursor = self.conn.cursor()
        cursor.execute("DELETE FROM maintenance_tasks WHERE id=?", (task_id,))
        self.conn.commit()
        logger.info(f"Deleted maintenance task ID: {task_id}")

    def get_maintenance_tasks(self, vessel_id: Optional[int] = None) -> List[MaintenanceTask]:
        cursor = self.conn.cursor()
        if vessel_id is not None: # Explicit None check
            cursor.execute("""
                SELECT mt.*, v.name as vessel_name FROM maintenance_tasks mt
                JOIN vessels v ON mt.vessel_id = v.id WHERE mt.vessel_id = ?
            """, (vessel_id,))
        else:
            cursor.execute("""
                SELECT mt.*, v.name as vessel_name FROM maintenance_tasks mt
                JOIN vessels v ON mt.vessel_id = v.id
            """)
        tasks = []
        for row in cursor.fetchall():
            task_dict = dict(row)
            # Safely handle enum conversion
            if task_dict["interval_type"]:
                 try:
                     task_dict["interval_type"] = IntervalType[task_dict["interval_type"]]
                 except KeyError:
                     logger.warning(f"Unknown interval_type '{task_dict['interval_type']}' for task {task_dict.get('id')}. Defaulting to HOURS.")
                     task_dict["interval_type"] = IntervalType.HOURS
            if task_dict["priority"]:
                try:
                    task_dict["priority"] = Priority[task_dict["priority"]]
                except KeyError:
                    logger.warning(f"Unknown priority '{task_dict['priority']}' for task {task_dict.get('id')}. Defaulting to MEDIUM.")
                    task_dict["priority"] = Priority.MEDIUM
            if task_dict["parts_required"]:
                try:
                    # Ensure it's loaded as a list of integers
                    parsed_parts = json.loads(task_dict["parts_required"])
                    if isinstance(parsed_parts, list) and all(isinstance(i, int) for i in parsed_parts):
                        task_dict["parts_required"] = parsed_parts
                    else:
                        raise ValueError("Parsed parts_required is not a list of integers")
                except (json.JSONDecodeError, TypeError, ValueError) as e:
                    logger.warning(f"Error decoding parts_required for task {task_dict.get('id')}: {e}. Setting to None.")
                    task_dict["parts_required"] = None
            else:
                task_dict["parts_required"] = None
            tasks.append(MaintenanceTask(**task_dict))
        return tasks

