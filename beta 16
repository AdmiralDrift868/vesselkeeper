    def _create_treeview_page(self, store: Gtk.ListStore, columns_config: List[Tuple[str, int, str]]):
        treeview = Gtk.TreeView(model=store)
        for i, (title, column_id, cell_renderer_type) in enumerate(columns_config):
            if cell_renderer_type == "text":
                renderer = Gtk.CellRendererText()
                column = Gtk.TreeViewColumn(title, renderer, text=column_id)
            elif cell_renderer_type == "status":
                renderer = Gtk.CellRendererText()
                column = Gtk.TreeViewColumn(title, renderer, text=column_id)
                def cell_data_func(col: Gtk.TreeViewColumn, cell: Gtk.CellRenderer, model: Gtk.TreeModel, iter, data):
                    status_name = model.get_value(iter, column_id)
                    try:
                        # Use getattr to safely access the enum member
                        status_enum_member = getattr(Status, status_name, None)
                        if status_enum_member and isinstance(status_enum_member, Status):
                            color = status_enum_member.color()
                            if color:
                                cell.set_property("background", color)
                            else:
                                cell.set_property("background-set", False)
                        else:
                            cell.set_property("background-set", False)
                    except Exception: # Catch any unexpected errors
                        cell.set_property("background-set", False)
                column.set_cell_data_func(renderer, cell_data_func)
            treeview.append_column(column)
            column.set_sort_column_id(column_id) # Enable sorting

        # Enable sorting on the model
        store.set_sort_column_id(0, Gtk.SortType.ASCENDING) # Default sort by first column

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scroll.add(treeview)
        return scroll, treeview

