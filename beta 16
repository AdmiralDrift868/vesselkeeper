# --- UI Utilities ---
def show_error_dialog(parent: Gtk.Window, message: str):
    logger.error(f"UI Error: {message}")
    dialog = Gtk.MessageDialog(
        transient_for=parent,
        flags=0,
        message_type=Gtk.MessageType.ERROR,
        buttons=Gtk.ButtonsType.OK,
        text=message,
    )
    dialog.run()
    dialog.destroy()

def show_confirmation_dialog(parent: Gtk.Window, message: str) -> bool:
    dialog = Gtk.MessageDialog(
        transient_for=parent,
        flags=0,
        message_type=Gtk.MessageType.QUESTION,
        buttons=Gtk.ButtonsType.YES_NO,
        text=message,
    )
    response = dialog.run()
    dialog.destroy()
    return response == Gtk.ResponseType.YES

class DatePickerEntry(Gtk.Box):
    def __init__(self, date_format: str = "%Y-%m-%d"):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.date_format = date_format
        self.entry = Gtk.Entry()
        self.entry.set_hexpand(True)
        self.entry.set_placeholder_text("YYYY-MM-DD")
        self.pack_start(self.entry, True, True, 0)
        self.popover = Gtk.Popover()
        self.calendar = Gtk.Calendar()
        # Use correct signal
        self.calendar.connect("day-selected", self.on_calendar_day_selected) # type: ignore
        self.popover.add(self.calendar)
        button = Gtk.Button()
        button.set_image(Gtk.Image.new_from_icon_name("x-office-calendar", Gtk.IconSize.BUTTON))
        button.set_relief(Gtk.ReliefStyle.NONE)
        button.set_tooltip_text("Select Date")
        self.pack_start(button, False, False, 0)
        self.popover.set_relative_to(button)
        button.connect("clicked", lambda b: self.popover.show_all())

    def on_calendar_day_selected(self, calendar: Gtk.Calendar):
        year, month, day = calendar.get_date()
        selected_date = datetime.date(year, month + 1, day)
        self.entry.set_text(selected_date.strftime(self.date_format))
        self.popover.hide()

    def get_text(self) -> str:
        return self.entry.get_text().strip()

    def set_text(self, text: str):
        self.entry.set_text(text.strip() if text else "")

