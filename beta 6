    class VesselKeeperApp:
     def __init__(self):
        self.db = Database()
        self.config = load_config()
        self.current_theme = self.config.get("theme", "light")
        self.window = Gtk.Window(title="VesselKeeper")
        self.window.set_default_size(1200, 800)
        self.window.connect("destroy", self._on_quit)
        self._setup_header_bar()
        self._setup_main_content()
        self._load_initial_data()
        self._apply_theme()

    def _on_quit(self, *args):
        self.db.close()
        Gtk.main_quit()

    def _setup_header_bar(self):
        self.header = Gtk.HeaderBar()
        self.header.set_show_close_button(True)
        self.header.props.title = "VesselKeeper"
        self.window.set_titlebar(self.header)
        self.theme_btn = Gtk.Button(label="🌙" if self.current_theme == "light" else "☀️")
        self.theme_btn.connect("clicked", self._toggle_theme)
        self.header.pack_end(self.theme_btn)
        self.quick_menu = Gtk.MenuButton()
        menu = Gtk.Menu()
        add_vessel = Gtk.MenuItem(label="New Vessel")
        add_vessel.connect("activate", self._show_vessel_editor)
        menu.append(add_vessel)
        add_maintenance = Gtk.MenuItem(label="New Maintenance")
        add_maintenance.connect("activate", self._show_maintenance_editor)
        menu.append(add_maintenance)
        add_inventory = Gtk.MenuItem(label="New Inventory Item")
        add_inventory.connect("activate", self._show_inventory_editor)
        menu.append(add_inventory)
        add_trip = Gtk.MenuItem(label="New Trip Log")
        add_trip.connect("activate", self._show_trip_editor)
        menu.append(add_trip)
        add_supplier = Gtk.MenuItem(label="New Supplier")
        add_supplier.connect("activate", self._show_supplier_editor)
        menu.append(add_supplier)
        menu.show_all()
        self.quick_menu.set_popup(menu)
        self.header.pack_start(self.quick_menu)

    def _setup_main_content(self):
        self.main_paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        self.sidebar = self._create_sidebar()
        self.main_paned.pack1(self.sidebar, False, False)
        self.notebook = Gtk.Notebook()
        self._setup_dashboard_tab()
        self._setup_vessels_tab()
        self._setup_maintenance_tab()
        self._setup_inventory_tab()
        self._setup_trips_tab()
        self._setup_suppliers_tab()
        self.main_paned.pack2(self.notebook, True, False)
        self.window.add(self.main_paned)

    def _create_sidebar(self):
        sidebar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        self.search_entry = Gtk.SearchEntry()
        self.search_entry.set_placeholder_text("Search vessels...")
        self.search_entry.connect("search-changed", self._on_search)
        sidebar.pack_start(self.search_entry, False, False, 5)
        self.vessel_list = Gtk.ListBox()
        self.vessel_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.vessel_list.connect("row-activated", self._on_vessel_selected)
        scroll = Gtk.ScrolledWindow()
        scroll.add(self.vessel_list)
        sidebar.pack_start(scroll, True, True, 0)
        return sidebar

    def _setup_dashboard_tab(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin=10)
        label = Gtk.Label(
            label="Welcome to VesselKeeper!\n\nTrack your vessels, maintenance, inventory, suppliers, and trips."
        )
        box.pack_start(label, False, False, 10)
        self.notebook.append_page(box, Gtk.Label(label="Dashboard"))

    def _setup_vessels_tab(self):
        self.vessels_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5, margin=10)
        self.notebook.append_page(self.vessels_box, Gtk.Label(label="Vessels"))

    def _setup_maintenance_tab(self):
        self.maintenance_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5, margin=10)
        self.notebook.append_page(self.maintenance_box, Gtk.Label(label="Maintenance"))

    def _setup_inventory_tab(self):
        self.inventory_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5, margin=10)
        self.notebook.append_page(self.inventory_box, Gtk.Label(label="Inventory"))

    def _setup_trips_tab(self):
        self.trips_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5, margin=10)
        self.notebook.append_page(self.trips_box, Gtk.Label(label="Trips"))

    def _setup_suppliers_tab(self):
        self.suppliers_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5, margin=10)
        self.notebook.append_page(self.suppliers_box, Gtk.Label(label="Suppliers"))

    def _load_initial_data(self):
        # Vessels sidebar & tab
        for row in self.vessel_list.get_children():
            self.vessel_list.remove(row)
        vessels = self.db.get_vessels()
        for vessel in vessels:
            row = Gtk.ListBoxRow()
            row.vessel = vessel
            label = Gtk.Label(label=f"{vessel.name} ({vessel.registration})")
            row.add(label)
            self.vessel_list.add(row)
        self.vessel_list.show_all()
        for child in self.vessels_box.get_children():
            self.vessels_box.remove(child)
        for vessel in vessels:
            label = Gtk.Label(
                label=f"{vessel.name} ({vessel.registration}) [{vessel.vessel_type}] - {vessel.length}m x {vessel.beam}m"
            )
            self.vessels_box.pack_start(label, False, False, 2)
        self.vessels_box.show_all()

        # Maintenance tab
        for child in self.maintenance_box.get_children():
            self.maintenance_box.remove(child)
        tasks = self.db.get_maintenance_tasks()
        for task in tasks:
            label = Gtk.Label(
                label=f"{task.task_name} for {task.vessel_name} [{task.system}] - Every {task.interval_value} {task.interval_type.name.lower()} [{task.priority.name}]"
            )
            self.maintenance_box.pack_start(label, False, False, 2)
        self.maintenance_box.show_all()

        # Inventory tab
        for child in self.inventory_box.get_children():
            self.inventory_box.remove(child)
        inventory = self.db.get_inventory()
        for item in inventory:
            label = Gtk.Label(
                label=f"{item.name} ({item.part_number}) [{item.category}] - {item.current_stock}/{item.minimum_stock} in stock"
            )
            self.inventory_box.pack_start(label, False, False, 2)
        self.inventory_box.show_all()

        # Trips tab
        for child in self.trips_box.get_children():
            self.trips_box.remove(child)
        trips = self.db.get_trip_logs()
        for trip in trips:
            label = Gtk.Label(
                label=f"{trip.departure} {trip.origin} → {trip.arrival or ''} {trip.destination or ''}, Vessel ID: {trip.vessel_id}, Crew: {trip.crew}"
            )
            self.trips_box.pack_start(label, False, False, 2)
        self.trips_box.show_all()

        # Suppliers tab
        for child in self.suppliers_box.get_children():
            self.suppliers_box.remove(child)
        suppliers = self.db.get_suppliers()
        for supplier in suppliers:
            label = Gtk.Label(
                label=f"{supplier.name} ({supplier.phone}) - {supplier.email}"
            )
            self.suppliers_box.pack_start(label, False, False, 2)
        self.suppliers_box.show_all()

    # Sidebar vessel selection/editing/deleting
    def _on_vessel_selected(self, listbox, row):
        vessel = row.vessel
        editor = VesselEditor(self.window, self.db, vessel)
        response = editor.run()
        if response == Gtk.ResponseType.OK:
            new_vessel = editor.get_vessel_data()
            self.db.update_vessel(new_vessel)
        elif response == Gtk.ResponseType.DELETE_EVENT:
            self.db.delete_vessel(vessel.id)
        self._load_initial_data()
        editor.destroy()

    def _on_search(self, entry):
        text = entry.get_text().lower()
        for row in self.vessel_list.get_children():
            self.vessel_list.remove(row)
        vessels = self.db.get_vessels()
        for vessel in vessels:
            if text in vessel.name.lower() or text in vessel.registration.lower():
                row = Gtk.ListBoxRow()
                row.vessel = vessel
                label = Gtk.Label(label=f"{vessel.name} ({vessel.registration})")
                row.add(label)
                self.vessel_list.add(row)
        self.vessel_list.show_all()

    # Menu actions for adding/editing/deleting
    def _show_vessel_editor(self, widget):
        editor = VesselEditor(self.window, self.db)
        response = editor.run()
        if response == Gtk.ResponseType.OK:
            vessel = editor.get_vessel_data()
            self.db.add_vessel(vessel)
            self._load_initial_data()
        editor.destroy()

    def _show_maintenance_editor(self, widget):
        editor = MaintenanceTaskEditor(self.window, self.db)
        response = editor.run()
        if response == Gtk.ResponseType.OK:
            task = editor.get_task_data()
            self.db.add_maintenance_task(task)
            self._load_initial_data()
        editor.destroy()

    def _show_inventory_editor(self, widget):
        editor = InventoryEditor(self.window, self.db)
        response = editor.run()
        if response == Gtk.ResponseType.OK:
            item = editor.get_item_data()
            self.db.add_inventory_item(item)
            self._load_initial_data()
        editor.destroy()

    def _show_trip_editor(self, widget):
        editor = TripLogEditor(self.window, self.db)
        response = editor.run()
        if response == Gtk.ResponseType.OK:
            log = editor.get_log_data()
            self.db.add_trip_log(log)
            self._load_initial_data()
        editor.destroy()

    def _show_supplier_editor(self, widget):
        editor = SupplierEditor(self.window, self.db)
        response = editor.run()
        if response == Gtk.ResponseType.OK:
            supplier = editor.get_supplier_data()
            self.db.add_supplier(supplier)
            self._load_initial_data()
        editor.destroy()

    def _toggle_theme(self, widget):
        settings = Gtk.Settings.get_default()
        if self.current_theme == "light":
            settings.set_property("gtk-application-prefer-dark-theme", True)
            self.current_theme = "dark"
            widget.set_label("☀️")
        else:
            settings.set_property("gtk-application-prefer-dark-theme", False)
            self.current_theme = "light"
            widget.set_label("🌙")
        save_config({"theme": self.current_theme})

    def _apply_theme(self):
        settings = Gtk.Settings.get_default()
        settings.set_property(
            "gtk-application-prefer-dark-theme",
            True if self.current_theme == "dark" else False
        )

    def run(self):
        self.window.show_all()
        Gtk.main()

if __name__ == "__main__":
