    class Database:
    # --- Suppliers ---
     def add_supplier(self, supplier: Supplier) -> int:
        cursor = self.conn.cursor()
        cursor.execute("""
            INSERT INTO suppliers (name, contact, phone, email, notes)
            VALUES (?, ?, ?, ?, ?)
        """, (
            supplier.name, supplier.contact, supplier.phone, supplier.email, supplier.notes
        ))
        self.conn.commit()
        return cursor.lastrowid

    def update_supplier(self, supplier: Supplier):
        cursor = self.conn.cursor()
        cursor.execute("""
            UPDATE suppliers SET name=?, contact=?, phone=?, email=?, notes=? WHERE id=?
        """, (
            supplier.name, supplier.contact, supplier.phone, supplier.email, supplier.notes, supplier.id
        ))
        self.conn.commit()

    def delete_supplier(self, supplier_id: int):
        cursor = self.conn.cursor()
        cursor.execute("DELETE FROM suppliers WHERE id=?", (supplier_id,))
        self.conn.commit()

    def get_suppliers(self) -> List[Supplier]:
        cursor = self.conn.cursor()
        cursor.execute("SELECT * FROM suppliers")
        return [Supplier(*row) for row in cursor.fetchall()]

# NOTE: Don't indent this function inside any class!
def save_config(config):
    Path(CONFIG_PATH).parent.mkdir(parents=True, exist_ok=True)
    with open(CONFIG_PATH, "w") as f:
        json.dump(config, f)

    def __init__(self):
     self.db_path = os.path.expanduser("~/.local/share/vesselkeeper/data.db")
    Path(self.db_path).parent.mkdir(parents=True, exist_ok=True)
    self.conn = sqlite3.connect(self.db_path)
    self._init_tables()

    def _init_tables(self):
        cursor = self.conn.cursor()
        cursor.executescript("""
        CREATE TABLE IF NOT EXISTS vessels (
            id INTEGER PRIMARY KEY,
            name TEXT NOT NULL,
            registration TEXT,
            vessel_type TEXT,
            length REAL,
            beam REAL,
            draft REAL,
            engine_model TEXT,
            engine_hours REAL DEFAULT 0,
            hull_material TEXT,
            build_year INTEGER,
            last_survey TEXT,
            insurance_expiry TEXT,
            current_location TEXT,
            notes TEXT
        );
        CREATE TABLE IF NOT EXISTS maintenance_tasks (
            id INTEGER PRIMARY KEY,
            vessel_id INTEGER REFERENCES vessels(id),
            system TEXT,
            task_name TEXT NOT NULL,
            template_id INTEGER,
            interval_type TEXT,
            interval_value INTEGER,
            last_completed TEXT,
            last_hours REAL,
            next_due TEXT,
            priority TEXT,
            parts_required TEXT,
            instructions TEXT
        );
        CREATE TABLE IF NOT EXISTS inventory (
            id INTEGER PRIMARY KEY,
            name TEXT NOT NULL,
            part_number TEXT,
            category TEXT,
            system TEXT,
            location TEXT,
            current_stock INTEGER DEFAULT 0,
            minimum_stock INTEGER DEFAULT 0,
            supplier TEXT,
            unit_cost REAL DEFAULT 0,
            specifications TEXT
        );
        CREATE TABLE IF NOT EXISTS trip_logs (
            id INTEGER PRIMARY KEY,
            vessel_id INTEGER REFERENCES vessels(id),
            departure TEXT NOT NULL,
            arrival TEXT,
            origin TEXT,
            destination TEXT,
            start_hours REAL,
            end_hours REAL,
            fuel_used REAL,
            distance REAL,
            crew TEXT,
            log_entries TEXT
        );
        CREATE TABLE IF NOT EXISTS suppliers (
            id INTEGER PRIMARY KEY,
            name TEXT NOT NULL,
            contact TEXT,
            phone TEXT,
            email TEXT,
            notes TEXT
        );
        """)
        self.conn.commit()

    def close(self):
        try:
            self.conn.close()
        except Exception as e:
            print(f"Error closing DB: {e}")

